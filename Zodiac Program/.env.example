# ─── Required ──────────────────────────────────────────────────────────────────
# Used to transcribe the video audio into words + timestamps.
# Free tier at: https://www.assemblyai.com  (5 hours/month free)
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ─── Optional ──────────────────────────────────────────────────────────────────
# Used by Claude to intelligently pick the best clip moments AND generate zodiac scripts.
# If missing, app falls back to built-in heuristic selector / template scripts.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: ElevenLabs API for high-quality TTS voice synthesis in zodiac videos.
# Without this, browser Web Speech API is used for preview (no key needed for preview).
# Get a key at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ─── Remote Render Worker ───────────────────────────────────────────────────────
# Optional: URL of a separate render-worker process (render-worker.ts on port 4000).
# When set, the dashboard offloads CPU-heavy Remotion rendering to the worker instead
# of running it in-process. Leave blank to render in-process (default).
# Example: RENDER_WORKER_URL=http://localhost:4000
RENDER_WORKER_URL=

# Port the render worker listens on when you run: npm run dev:worker
# Default: 4000
RENDER_WORKER_PORT=4000
