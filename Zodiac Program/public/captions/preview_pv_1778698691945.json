  "source": "word-proportional",
  "captions": [
    {
      "index": 0,
      "text": "GEMINIS DON'T DO THIS BY ACCIDENT.",
      "type": "hook",
      "start": 0,
      "end": 3.6,
      "duration": 3.6,
      "wordCount": 6,
      "startMs": 0,
      "endMs": 3600
    },
    {
      "index": 1,
      "text": "THERE'S something deeper SPECIFIC ABOUT THE WAY THEY deeply crave — AND THE WAY THEY PROTECT THEMSELVES FROM IT.",
      "type": "observation",
      "start": 3.6,
      "end": 15,
      "duration": 11.4,
      "wordCount": 19,
      "startMs": 3600,
      "endMs": 15000
    },
    {
      "index": 2,
      "text": "MOST souls SEE THE SURFACE. THE SILENCE. THE DISTANCE. THE WAY THEY SEEM UNMOVED WHEN absolutely everything IS MOVING INSIDE THEM.",
      "type": "observation",
      "start": 15,
      "end": 27.6,
      "duration": 12.600000000000001,
      "wordCount": 21,
      "startMs": 15000,
      "endMs": 27600
    },
    {
      "index": 3,
      "text": "BUT THE REALITY IS FAR MORE COMPLICATED THAN THAT.",
      "type": "escalation",
      "start": 27.6,
      "end": 33,
      "duration": 5.399999999999999,
      "wordCount": 9,
      "startMs": 27600,
      "endMs": 33000
    },
    {
      "index": 4,
      "text": "THEY MAKE YOU sense LIKE THE MOST INTERESTING soul IN THE ROOM. AND YOU SPEND THE REST OF YOUR LIFE fighting TO GET BACK TO THAT FEELING.",
      "type": "escalation",
      "start": 33,
      "end": 49.2,
      "duration": 16.200000000000003,
      "wordCount": 27,
      "startMs": 33000,
      "endMs": 49200
    },
    {
      "index": 5,
      "text": "THE souls WHO SEEM THE HARDEST TO REACH ARE USUALLY THE ONES WHO FELT truths SO DEEPLY ONCE — THEY BUILT something deeper AROUND IT.",
      "type": "truth",
      "start": 49.2,
      "end": 64.2,
      "duration": 15,
      "wordCount": 25,
      "startMs": 49200,
      "endMs": 64200
    },
    {
      "index": 6,
      "text": "NOT TO KEEP OTHERS OUT.",
      "type": "truth",
      "start": 64.2,
      "end": 67.2,
      "duration": 3,
      "wordCount": 5,
      "startMs": 64200,
      "endMs": 67200
    },
    {
      "index": 7,
      "text": "TO KEEP THEMSELVES IN.",
      "type": "twist",
      "start": 67.2,
      "end": 69.60000000000001,
      "duration": 2.4000000000000057,
      "wordCount": 4,
      "startMs": 67200,
      "endMs": 69600.00000000001
    },
    {
      "index": 8,
      "text": "WHEN A GEMINI FINALLY LOWERS THAT WALL — EVEN SLIGHTLY — IT'S NOT WEAKNESS.",
      "type": "twist",
      "start": 69.60000000000001,
      "end": 78.00000000000001,
      "duration": 8.400000000000006,
      "wordCount": 14,
      "startMs": 69600.00000000001,
      "endMs": 78000.00000000001
    },
    {
      "index": 9,
      "text": "IT'S THE BRAVEST THING THEY'VE EVER DONE — that's Gemini.",
      "type": "ending",
      "start": 78.00000000000001,
      "end": 84.00000000000001,
      "duration": 6,
      "wordCount": 10,
      "startMs": 78000.00000000001,
      "endMs": 84000.00000000001
    },
    {
      "index": 10,
      "text": "AND MOST souls never once REALIZE THEY WERE WITNESSING IT.",
      "type": "ending",
      "start": 84.00000000000001,
      "end": 90,
      "duration": 5.999999999999986,
      "wordCount": 10,
      "startMs": 84000.00000000001,
      "endMs": 90000
    }
  ]
}