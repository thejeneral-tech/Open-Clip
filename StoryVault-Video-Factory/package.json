{
  "name": "storyvault-video-factory",
  "version": "1.0.0",
  "description": "Discover, rank, rewrite and turn internet stories into short-form vertical videos using user-uploaded background footage.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
