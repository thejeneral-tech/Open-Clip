    "test": "node --no-warnings tests/run-tests.js",
    "seed": "node --no-warnings scripts/seed.js",
    "setup:fish": "node --no-warnings scripts/setup-fish.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.1.1"
