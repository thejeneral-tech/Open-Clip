# Downloaded ML model *weights* only. Anchored to the repo root + weight file
# extensions so this never swallows the backend ORM package (backend/app/models/),
# which is source code and MUST be committed.
/models/
*.pt
*.onnx
*.gguf
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.srt
*.vtt
*.ass
