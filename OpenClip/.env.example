# ============================================================================
# OpenClip environment configuration (local, Docker-free)
# Copy to .env and adjust. The defaults run a fully self-contained stack:
# SQLite for data + a filesystem queue for Celery — no Postgres or Redis needed.
# ============================================================================

# ---- General ----
PROJECT_NAME=OpenClip
ENVIRONMENT=development            # development | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Allowed CORS origins. The web app is proxied through Next (same origin), but
# the progress WebSocket connects straight to the API, so keep these listed.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-real-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Bootstrap admin (created on first startup)
FIRST_SUPERUSER_EMAIL=admin@openclip.local
FIRST_SUPERUSER_PASSWORD=changeme

# ---- Data location ----
# Everything generated (database, media, queue, progress) lives here.
# Relative paths resolve against the project root.
DATA_DIR=./data

# ---- Database ----
DB_BACKEND=sqlite                 # sqlite | postgres
SQLITE_PATH=./data/openclip.db
# PostgreSQL (only used when DB_BACKEND=postgres):
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=openclip
# POSTGRES_PASSWORD=openclip
# POSTGRES_DB=openclip

# ---- Background tasks (Celery) ----
# Redis-free: a filesystem broker + SQLite result backend keep everything local.
CELERY_BROKER_URL=filesystem://
CELERY_RESULT_BACKEND=            # blank -> ./data/celery_results.db
WORKER_CONCURRENCY=2              # ignored on Windows (worker runs single-process)

# ---- Storage ----
STORAGE_BACKEND=local             # local | s3
STORAGE_ROOT=./data/storage       # used when STORAGE_BACKEND=local
PUBLIC_MEDIA_URL=/media           # path the app serves media from

# S3 / MinIO (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=openclip
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# ---- Ollama (AI backend) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=600
# Default models — overridable per-user in Settings and per-bot per-stage
OLLAMA_DEFAULT_MODEL=qwen3:32b
OLLAMA_RANKING_MODEL=qwen3:32b
OLLAMA_VISION_MODEL=gemma3:27b
OLLAMA_EMBED_MODEL=nomic-embed-text   # local embeddings for trend relevance/dedup
OLLAMA_KEEP_ALIVE=15m
OLLAMA_NUM_CTX=8192
# Max simultaneous Ollama generations per worker process (the centralized
# OllamaService gates every AI request). 1 = single GPU; raise for multi-GPU.
OLLAMA_MAX_CONCURRENCY=1

# ---- Fish Speech (cloned voices for StoryVault / Voice Lab) ----
# The "Tiktok …" cloned voices are produced by a local s2.cpp HTTP server.
# `launch.py setup` (menu 6) builds the engine; `launch.py up` (menu 1) starts it.
# All optional — leave them blank to use the defaults below.
FISH_TTS_URL=http://127.0.0.1:8080   # where the backend reaches the s2 server
FISH_TEMPERATURE=0.7
FISH_MAX_TOKENS=2048
# FISH_MODEL_DIR=./models/s2-pro-gguf  # set so the app can report the downloaded quant
FISH_AUTOSTART=1                     # 1 = launch.py starts the voice server with the stack; 0 = off
# Engine backend for the build (menu 6). Blank/auto = Metal on macOS, else CUDA if
# the toolkit is installed, else Vulkan if its SDK is, else CPU. Force one of
# cpu|vulkan|cuda|metal here if auto-detection picks the wrong one.
FISH_BACKEND=
FISH_GPU_DEVICE=0                    # GPU index for the Vulkan/CUDA engine
# Transformer layers to offload to the GPU. Blank = all (fastest; needs the most
# VRAM). Lower it (e.g. 18) on smaller cards; the rest run on CPU.
FISH_GPU_LAYERS=
FISH_CODEC_CPU=1                     # 1 = keep the audio codec on CPU to save VRAM
FISH_START_TIMEOUT=120               # seconds to wait for the voice model to bind on `up` (non-fatal)

# ---- System voices (Piper — Linux/macOS; Windows uses built-in SAPI voices) ----
# The "System voices" dropdown off Windows is served by Piper, a fast offline
# neural TTS. `launch.py setup` installs it + a default voice; add more with
# `launch.py voices --add <id>` (catalog: huggingface.co/rhasspy/piper-voices).
PIPER_BIN=piper                      # explicit binary; blank/unfound -> `python -m piper`
# PIPER_VOICES_DIR=./models/piper    # where voice .onnx models live (default shown)
PIPER_DEFAULT_VOICE=en_US-amy-medium # used when a video's voice is "Auto"/unset
PIPER_DEVICE=cpu                     # cpu | cuda  (Piper is fast on CPU; cuda is optional)

# ---- Multi-bot content automation ----
# The API process hosts a lightweight scheduler that dispatches due bot cycles
# and releases scheduled publishes — no separate `celery beat` service needed.
# (The worker must consume the `bots` queue: launch.py already adds it.)
BOT_SCHEDULER_ENABLED=true
BOT_SCHEDULER_INTERVAL_SECONDS=60
# Identify the deployment to public discovery sources (Reddit/RSS).
DISCOVERY_USER_AGENT=OpenClip-Bot/1.0 (+https://github.com/openclip)
# Optional but recommended: Reddit app-only OAuth for Story Vault discovery.
# Without it, story grabs use Reddit's public RSS feed, which is throttled to
# ~one pull per 30s per IP (multi-subreddit grabs are slow). With it, discovery
# uses the authenticated API (~100 pulls/min) — fast multi-subreddit grabs, and
# real upvote/comment counts come back (so min_upvotes filtering works again).
# Setup (~2 min): sign in at https://www.reddit.com/prefs/apps → "create another
# app…" → pick type "script" → set redirect uri to http://localhost:8000 (unused
# for app-only auth, but required). Copy the id under the app name into
# REDDIT_CLIENT_ID and the "secret" into REDDIT_CLIENT_SECRET. Leave blank to use
# the public RSS feed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Hard safety cap on videos ingested per bot cycle (regardless of preset).
BOT_MAX_VIDEOS_PER_RUN=5
# Global ceiling (seconds) on bot-discovered video length; clamps every bot's
# max_duration filter (a bot may be stricter, never looser). 0 = no cap. 1800 = 30 min.
BOT_MAX_VIDEO_DURATION_SECONDS=1800

# ---- Publishing: YouTube OAuth ----
# Create a Google Cloud OAuth 2.0 "Web application" client and enable the
# "YouTube Data API v3":
#   1. https://console.cloud.google.com → APIs & Services → Library → enable
#      "YouTube Data API v3".
#   2. OAuth consent screen → External → add yourself as a test user.
#   3. Credentials → Create OAuth client ID → Web application.
#   4. Authorized redirect URIs → add EXACTLY:
#        http://localhost:8000/api/v1/publishing/youtube/callback
#   5. Copy the client id/secret below. Leaving these blank just shows YouTube
#      as "not configured" in Publishing — the rest of the app runs fine.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/publishing/youtube/callback
FRONTEND_BASE_URL=http://localhost:3000
YOUTUBE_DEFAULT_PRIVACY=private   # public | unlisted | private

# ---- Transcription ----
WHISPER_ENGINE=faster-whisper     # faster-whisper | whisper
WHISPER_MODEL=large-v3-turbo     # tiny | base | small | medium | large-v3 | large-v3-turbo | distil-large-v3
WHISPER_DEVICE=cpu                # cpu | cuda  (use cuda if you have an NVIDIA GPU)
WHISPER_COMPUTE_TYPE=int8         # int8 (cpu) | float16 (cuda) | int8_float16 | float32
WHISPER_BEAM_SIZE=5
# Speaker diarization (pyannote) — requires HF token & accepting model terms
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=

# ---- Video processing ----
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
HWACCEL=auto                      # auto | none | nvenc | qsv | vaapi | amf  (auto picks a working GPU encoder, else CPU)
DEFAULT_EXPORT_RESOLUTION=1080p   # 720p | 1080p | 1440p | 4k
DEFAULT_EXPORT_FORMAT=mp4         # mp4 | mov
# Frames-per-second sampled for face/object tracking (lower = faster)
TRACKING_SAMPLE_FPS=5
ENABLE_YOLO=true
YOLO_MODEL=yolov8n.pt

# ---- Reframe smoothing / render ----  (lock-and-hold: crop is static unless the scene changes)
REFRAME_RENDER_FPS=30              # grid for animating re-centre glides; effective = min(this, source fps)
REFRAME_SCENE_CORREL=0.5           # HSV-hist correlation between samples below this = scene cut (crop snaps)
REFRAME_DEADBAND=0.12               # norm distance the subject may roam without the crop moving at all
REFRAME_RETARGET_SECONDS=1.0       # deadband breach must persist this long before re-centring
REFRAME_EASE_SECONDS=1.2           # duration of the smoothstep re-centre glide
REFRAME_LOOKAHEAD_SECONDS=1.0      # new anchor = median of this upcoming detection window
REFRAME_SUBJECT_Y=0.42             # vertical subject placement in the crop (0.5 = centre; lower = more headroom)
REFRAME_SWITCH_DIST=0.25           # norm distance beyond which a detection is a candidate NEW subject
REFRAME_SWITCH_HOLD=3              # samples a far subject must persist before the lock moves (anti-flicker)
REFRAME_PERSON_HEAD_FRAC=0.15      # head estimate from a person box = box_top + this*box_height

# ---- Limits ----
MAX_UPLOAD_SIZE_MB=4096
MAX_CLIPS_PER_VIDEO=50
MIN_CLIP_SECONDS=8
MAX_CLIP_SECONDS=90

# ---- Frontend ----
# The Next.js dev server is configured automatically via frontend/.env.local
# (written by launch.py). No NEXT_PUBLIC_* values are needed here.
