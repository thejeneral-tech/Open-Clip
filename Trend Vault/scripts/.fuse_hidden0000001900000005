// ============================================================
// Trend Vault Program — Sync Worker  (Integrated Edition)
// Runs on the HOME COMPUTER.
//
// Watches Google Drive for jobs → copies files locally →
// runs the real Trend Vault pipeline (script gen + TTS + render) →
// sends finished video back to Google Drive.
//
// Usage:
//   node scripts/sync-worker.js           (normal mode)
//   node scripts/sync-worker.js --test    (test mode — no Claude needed)
// ============================================================

'use strict';

const fs    = require('fs');
const path  = require('path');
const { execSync, spawn } = require('child_process');

// ── Load config ───────────────────────────────────────────────────────────────
const CONFIG_PATH = path.join(__dirname, '..', 'sync.config.json');
if (!fs.existsSync(CONFIG_PATH)) {
  console.error('[FATAL] sync.config.json not found at:', CONFIG_PATH);
  process.exit(1);
}
const config = JSON.parse(fs.readFileSync(CONFIG_PATH, 'utf8'));

const LOCAL_ROOT   = config.homeLocalRoot;
const DRIVE_ROOT   = config.googleDriveRoot;
const PROJECT_ROOT = config.projectRoot || path.join(__dirname, '..');
const POLL_MS      = (config.pollIntervalSeconds  || 10) * 1000;
const STABLE_MS    = (config.stableFileCheckSeconds || 5) * 1000;

// ── Derived paths ─────────────────────────────────────────────────────────────
const PATHS = {
  // Local (home computer SSD — never synced to Drive)
  incoming     : path.join(LOCAL_ROOT, 'incoming'),
  working      : path.join(LOCAL_ROOT, 'working'),
  cache        : path.join(LOCAL_ROOT, 'cache'),
  renders      : path.join(LOCAL_ROOT, 'renders'),
  final        : path.join(LOCAL_ROOT, 'final'),
  logs         : path.join(LOCAL_ROOT, 'logs'),

  // Google Drive (transfer bridge only)
  driveRequests : path.join(DRIVE_ROOT, 'requests'),
  driveUploads  : path.join(DRIVE_ROOT, 'uploads'),
  driveFinal    : path.join(DRIVE_ROOT, 'final'),
  driveLogs     : path.join(DRIVE_ROOT, 'logs'),
};

// Trend Vault symbols lookup
const TREND_VAULT_SYMBOLS = {
  Aries:'♈', Taurus:'♉', Gemini:'♊', Cancer:'♋', Leo:'♌', Virgo:'♍',
  Libra:'♎', Scorpio:'♏', Sagittarius:'♐', Capricorn:'♑', Aquarius:'♒', Pisces:'♓',
};

// Files to ignore — still being uploaded / temp files
const IGNORE_EXTS = new Set(['.tmp','.uploading','.partial','.crdownload','.part']);

const TEST_MODE = process.argv.includes('--test');

// ── Logger ────────────────────────────────────────────────────────────────────
function ts() { return new Date().toISOString().replace('T',' ').slice(0,19); }

const LOG_FILE = path.join(PATHS.logs,
  `sync-worker-${new Date().toISOString().slice(0,10)}.log`);

function log(level, msg) {
  const line = `[${ts()}] [${level}] ${msg}`;
  console.log(line);
  try {
    fs.mkdirSync(PATHS.logs, { recursive: true });
    fs.appendFileSync(LOG_FILE, line + '\n');
    try {
      fs.mkdirSync(PATHS.driveLogs, { recursive: true });
      fs.appendFileSync(path.join(PATHS.driveLogs, path.basename(LOG_FILE)), line + '\n');
    } catch { /* Drive not mounted yet — skip */ }
  } catch { /* logs folder not ready yet */ }
}

// ── Folder setup ──────────────────────────────────────────────────────────────
function ensureFolders() {
  for (const [name, p] of Object.entries(PATHS)) {
    try { fs.mkdirSync(p, { recursive: true }); }
    catch (e) {
      if (name.startsWith('drive')) log('WARN', `Drive folder not accessible: ${p}`);
      else log('ERROR', `Cannot create local folder ${p}: ${e.message}`);
    }
  }
}

// ── File utilities ────────────────────────────────────────────────────────────
function shouldIgnore(filename) {
  const ext = path.extname(filename).toLowerCase();
  return IGNORE_EXTS.has(ext);
}

async function waitForStableFile(filePath, retries = 12) {
  for (let i = 0; i < retries; i++) {
    try {
      const s1 = fs.statSync(filePath).size;
      await sleep(STABLE_MS);
      const s2 = fs.statSync(filePath).size;
      if (s1 === s2 && s1 > 0) return true;
      log('INFO', `File still changing: ${path.basename(filePath)} (${s1} → ${s2} bytes) — waiting…`);
    } catch (e) {
      log('WARN', `Cannot stat ${filePath}: ${e.message}`);
      await sleep(2000);
    }
  }
  return false;
}

function safeCopy(src, dest) {
  try {
    if (fs.existsSync(dest)) {
      if (fs.statSync(src).size === fs.statSync(dest).size) {
        log('SKIP', `Same size already exists: ${path.basename(dest)}`);
        return false;
      }
    }
    fs.mkdirSync(path.dirname(dest), { recursive: true });
    fs.copyFileSync(src, dest);
    const kb = (fs.statSync(dest).size / 1024).toFixed(0);
    log('COPY', `${path.basename(src)} → ${dest} (${kb} KB)`);
    return true;
  } catch (e) {
    log('ERROR', `Copy failed ${src} → ${dest}: ${e.message}`);
    return false;
  }
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

// ── Spawn a process and stream its output to our logger ──────────────────────
function spawnLogged(cmd, args, opts) {
  return new Promise((resolve, reject) => {
    const proc = spawn(cmd, args, { ...opts, shell: true });
    const onData = (data) => {
      data.toString().split('\n').forEach(line => {
        const clean = line.replace(/\x1B\[[0-9;]*m/g, '').trim();
        if (clean) log('RUN', clean);
      });
    };
    proc.stdout.on('data', onData);
    proc.stderr.on('data', onData);
    proc.on('close', code => code === 0 ? resolve() : reject(new Error(`Process exited ${code}`)));
    proc.on('error', reject);
  });
}

// ── Job management ────────────────────────────────────────────────────────────
function getPendingJobs() {
  try {
    return fs.readdirSync(PATHS.driveRequests)
      .filter(f => f.endsWith('.json'))
      .map(f => {
        const p = path.join(PATHS.driveRequests, f);
        try {
          const job = JSON.parse(fs.readFileSync(p, 'utf8'));
          return job.status === 'pending' ? { ...job, _file: p } : null;
        } catch { return null; }
      })
      .filter(Boolean);
  } catch { return []; }
}

function updateJob(job) {
  const { _file, ...data } = job;
  try { fs.writeFileSync(_file, JSON.stringify(data, null, 2)); }
  catch (e) { log('ERROR', `Cannot update job file: ${e.message}`); }
}

// ══════════════════════════════════════════════════════════════════════════════
// JOB HANDLERS
// ══════════════════════════════════════════════════════════════════════════════

// ── Step 1: Generate trend-vault script via tsx ────────────────────────────────────
async function generateScript(scriptParams) {
  const { trendVaultSign, emotionalTone = 'dark', prompt = '', angle = '',
          category = 'psychology', targetDuration = 100 } = scriptParams;

  log('INFO', `Generating script: ${trendVaultSign} / ${emotionalTone} / "${prompt}"`);

  const code = `
import { generateTrendVaultScript } from './scripts/trend-vault-generate.js';
generateTrendVaultScript({
  trendVaultSign: ${JSON.stringify(trendVaultSign)},
  category: ${JSON.stringify(category)},
  prompt: ${JSON.stringify(prompt)},
  angle: ${JSON.stringify(angle)},
  emotionalTone: ${JSON.stringify(emotionalTone)},
  targetDuration: ${Number(targetDuration)},
}).then(s => { process.stdout.write(JSON.stringify(s)); process.exit(0); })
  .catch(e => { process.stderr.write(e.message); process.exit(1); });
  `.trim();

  // Write temp file into PROJECT_ROOT so './scripts/trend-vault-generate' resolves correctly
  const tmpScript = path.join(PROJECT_ROOT, `_script-gen-${Date.now()}.ts`);
  fs.writeFileSync(tmpScript, code, 'utf8');

  return new Promise((resolve, reject) => {
    let stdout = '';
    let stderr = '';
    const proc = spawn('npx', ['tsx', tmpScript], {
      cwd: PROJECT_ROOT, shell: true,
      env: { ...process.env, NODE_ENV: 'production' },
    });
    proc.stdout.on('data', d => { stdout += d.toString(); });
    proc.stderr.on('data', d => { stderr += d.toString(); });
    proc.on('close', exitCode => {
      try { fs.unlinkSync(tmpScript); } catch {}
      if (exitCode === 0) {
        try {
          const script = JSON.parse(stdout);
          log('INFO', `Script ready: ${script.lines?.length} lines, ~${script.totalDuration}s`);
          resolve(script);
        } catch (e) { reject(new Error(`Script parse failed: ${e.message}\nOutput: ${stdout.slice(0,200)}`)); }
      } else {
        reject(new Error(`Script generation failed (exit ${exitCode}): ${stderr.slice(0,300)}`));
      }
    });
    proc.on('error', err => { try { fs.unlinkSync(tmpScript); } catch {} reject(err); });
  });
}

// ── Step 2: Generate TTS voice via Edge TTS ───────────────────────────────────
async function generateTTS(scriptLines, voice = {}, jobId, audioDir) {
  const { presetId = 'en-US-DavisNeural', rate = '-10%', pitch = '-3Hz' } = voice;

  // Pick the voice ID — accept either an Edge TTS voice name directly or map
  // from preset IDs the UI uses. Edge TTS voice names contain "Neural".
  const voiceId = presetId.includes('Neural') ? presetId : 'en-US-DavisNeural';

  const fullText = scriptLines.map(l => l.text).join('\n\n');
  const audioFile = `trend_vault_voice_${jobId}.mp3`;
  const audioPath = path.join(audioDir, audioFile);

  log('INFO', `[TTS] selected voice: ${voiceId} rate=${rate} pitch=${pitch}`);
  log('INFO', `[TTS] text length: ${fullText.length} chars across ${scriptLines.length} lines`);

  // Use node-edge-tts npm package (installed), not npx edge-tts CLI (not installed)
  const { EdgeTTS } = require('node-edge-tts');
  const tts = new EdgeTTS({ voice: voiceId, rate, pitch, outputFormat: 'audio-24khz-96kbitrate-mono-mp3' });
  await tts.ttsPromise(fullText, audioPath);

  // Hard guard: the file must exist and not be a tiny / empty stub. Silent
  // voice files are the root cause of the "no voice in final render" bug.
  if (!fs.existsSync(audioPath)) {
    throw new Error(`TTS produced no output file at ${audioPath}`);
  }
  const sz = fs.statSync(audioPath).size;
  log('INFO', `[TTS] output path: ${audioPath}`);
  log('INFO', `[TTS] output size: ${(sz/1024).toFixed(0)} KB`);
  if (sz < 1024) {
    throw new Error(`TTS produced suspiciously small file (${sz} bytes) at ${audioPath}`);
  }
  return audioFile;
}

// ── Step 3: Build the trend-vault-render job file and spawn the renderer ───────────
async function runTrendVaultRender(job, scriptLines, audioFile, settings) {
  const jobId    = job.jobId;
  const sign     = settings.trendVaultSign || 'Unknown';
  const symbol   = TREND_VAULT_SYMBOLS[sign] || '✦';
  const dateStr  = new Date().toISOString().slice(0,10);
  const folder   = `${dateStr}_${sign.replace(/\s+/g,'_')}_${jobId}`;

  const trend-vaultOut = path.join(PROJECT_ROOT, 'trend-vault-output');
  fs.mkdirSync(path.join(trend-vaultOut, folder), { recursive: true });

  // Build the background video path — accept filename-only or full path
  let bgVideo = settings.backgroundVideo || '';
  if (bgVideo && !path.isAbsolute(bgVideo) && !bgVideo.includes('\\') && !bgVideo.includes('/')) {
    bgVideo = `backgrounds/${bgVideo}`;
  }
  // Fall back to first available background if none specified
  if (!bgVideo) {
    const bgs = fs.readdirSync(path.join(PROJECT_ROOT, 'backgrounds'))
      .filter(f => f.endsWith('.mp4'));
    bgVideo = bgs.length ? `backgrounds/${bgs[0]}` : 'none';
  }

  // Copy audio into project's custom-audio + public/custom-audio so Remotion finds it
  const localAudioSrc = path.join(PROJECT_ROOT, 'custom-audio', audioFile);
  if (audioFile && fs.existsSync(localAudioSrc)) {
    const pubAudioDir = path.join(PROJECT_ROOT, 'public', 'custom-audio');
    fs.mkdirSync(pubAudioDir, { recursive: true });
    fs.copyFileSync(localAudioSrc, path.join(pubAudioDir, audioFile));
  }

  // Build the full render job JSON (matches RenderJob interface in trend-vault-render.ts)
  const renderJob = {
    jobId,
    outputFolder: folder,
    scriptLines,
    settings: {
      trendVaultSign:           sign,
      trend-vaultSymbol:         symbol,
      backgroundVideo:      bgVideo,
      backgroundBlur:       settings.backgroundBlur       ?? 2,
      backgroundBrightness: settings.backgroundBrightness ?? 0.7,
      grainIntensity:       settings.grainIntensity       ?? 0.35,
      grainType:            settings.grainType            ?? 'film',
      fogOverlay:           settings.fogOverlay           ?? false,
      rainOverlay:          settings.rainOverlay          ?? false,
      slowZoom:             settings.slowZoom             ?? true,
      colorGrade:           settings.colorGrade           ?? 'dark',
      colorGradeIntensity:  settings.colorGradeIntensity  ?? 85,
      saturation:           settings.saturation           ?? 90,
      contrast:             settings.contrast             ?? 100,
      exposure:             settings.exposure             ?? 0,
      highlights:           settings.highlights           ?? 0,
      shadows:              settings.shadows              ?? 0,
      captionTopPct:        settings.captionTopPct        ?? null,
      captionBgStyle:       settings.captionBgStyle       ?? 'none',
      captionRotate:        settings.captionRotate        ?? 0,
      fps:                  settings.fps                  ?? 30,
      renderQuality:        settings.renderQuality        ?? 'standard',
      vignette:             settings.vignette             ?? true,
      fontFamily:           settings.fontFamily           ?? 'Impact, "Arial Black", sans-serif',
      fontSize:             settings.fontSize             ?? 68,
      textColor:            settings.textColor            ?? '#FFFFFF',
      textAnimation:        settings.textAnimation        ?? 'fade',
      animSpeed:            settings.animSpeed            ?? 1.0,
      musicFile:            settings.musicFile            ?? '',
      musicVolume:          settings.musicVolume          ?? 0.25,
      audioFile:            audioFile || '',
      durationSeconds:      settings.durationSeconds      ?? 100,
      durationMode:         settings.durationMode         ?? 'autoVoice',
      voiceVolume:          settings.voiceVolume          ?? 1,
    },
  };

  const jobFilePath = path.join(trend-vaultOut, `sync_job_${jobId}.json`);
  fs.writeFileSync(jobFilePath, JSON.stringify(renderJob, null, 2));
  log('INFO', `Render job file written: sync_job_${jobId}.json`);
  log('INFO', `Starting Remotion render: ${sign} / ${renderJob.settings.colorGrade} grade`);

  try {
    await spawnLogged('npx', ['tsx', 'scripts/trend-vault-render.ts'], {
      cwd: PROJECT_ROOT,
      env: { ...process.env, TREND_VAULT_JOB_FILE: jobFilePath },
    });
  } finally {
    try { fs.unlinkSync(jobFilePath); } catch { /* cleanup */ }
  }

  const outputFile = path.join(trend-vaultOut, folder, 'video.mp4');
  if (!fs.existsSync(outputFile)) {
    throw new Error(`Render finished but video.mp4 not found at: ${outputFile}`);
  }
  log('INFO', `[RENDER] final mp4 path: ${outputFile}`);

  // ── Belt-and-suspenders: confirm the MP4 actually has an audio stream ──
  // This catches the case where Remotion silently failed to embed audio.
  const ffprobeCandidates = [
    path.join(PROJECT_ROOT, 'node_modules', '@remotion', 'compositor-win32-x64-msvc', 'ffprobe.exe'),
    path.join(PROJECT_ROOT, 'node_modules', '@remotion', 'compositor-darwin-arm64',   'ffprobe'),
    path.join(PROJECT_ROOT, 'node_modules', '@remotion', 'compositor-darwin-x64',     'ffprobe'),
    path.join(PROJECT_ROOT, 'node_modules', '@remotion', 'compositor-linux-x64-gnu',  'ffprobe'),
    path.join(PROJECT_ROOT, 'node_modules', '@remotion', 'compositor-linux-arm64-gnu','ffprobe'),
  ];
  const ffprobePath = ffprobeCandidates.find(p => fs.existsSync(p));
  if (ffprobePath) {
    try {
      const probe = require('child_process').execFileSync(ffprobePath,
        ['-v', 'error', '-show_streams', '-select_streams', 'a', outputFile],
        { timeout: 15_000 }).toString();
      const hasAudio = /codec_type=audio/.test(probe);
      log('INFO', `[VERIFY] final mp4 has audio stream: ${hasAudio ? 'yes' : 'no'}`);
      if (!hasAudio) {
        throw new Error(`Render produced a video with NO audio stream — failing the job (silent videos are not allowed).`);
      }
    } catch (e) {
      // execFileSync throws on non-zero exit — re-throw only if our hard check tripped.
      if (/NO audio stream/.test(e.message)) throw e;
      log('WARN', `[VERIFY] ffprobe check failed (${e.message}) — continuing`);
    }
  } else {
    log('WARN', `[VERIFY] ffprobe not found — cannot confirm audio stream`);
  }

  log('INFO', `Render complete: ${outputFile}`);
  return { outputFile, folder };
}

// ── HANDLER: Full trend-vault video render ─────────────────────────────────────────
async function handleRender(job) {
  const sign = job.script?.trendVaultSign || job.settings?.trendVaultSign || 'Scorpio';
  const audioDir = path.join(PROJECT_ROOT, 'custom-audio');
  fs.mkdirSync(audioDir, { recursive: true });

  // 1. Generate script (or use pre-written lines from the job)
  let scriptLines;
  if (job.scriptLines && job.scriptLines.length > 0) {
    log('INFO', `Using pre-written script: ${job.scriptLines.length} lines`);
    scriptLines = job.scriptLines;
  } else {
    const generated = await generateScript(job.script || { trendVaultSign: sign });
    scriptLines = generated.lines;
  }

  // 2. Generate TTS voice — STRICT: a failed TTS aborts the whole job.
  // Producing a silent video and marking the job complete is a worse outcome
  // than failing the job loudly. The user can retry / change voices.
  const audioFile = await generateTTS(scriptLines, job.voice || {}, job.jobId, audioDir);

  // 3. Run Remotion render
  const mergedSettings = {
    trendVaultSign: sign,
    ...(job.settings || {}),
  };
  const { outputFile, folder } = await runTrendVaultRender(job, scriptLines, audioFile, mergedSettings);

  // 4. Copy output to local final and Drive final
  const outputName = `${job.jobId}_${sign}.mp4`;
  safeCopy(outputFile, path.join(PATHS.final, outputName));
  safeCopy(outputFile, path.join(PATHS.driveFinal, outputName));

  // 5. Also copy the internal trend-vault-output folder name to the job result
  return { outputFile: outputName, folder };
}

// ── HANDLER: Script generation only (no render) ───────────────────────────────
async function handleScriptOnly(job) {
  let script;
  if (job.scriptLines && job.scriptLines.length > 0) {
    log('INFO', `Using pre-written script lines (${job.scriptLines.length} lines) — skipping Claude`);
    const sign = job.script?.trendVaultSign || 'Unknown';
    script = {
      lines:         job.scriptLines,
      totalDuration: job.scriptLines.reduce((s, l) => s + (l.durationSeconds || 5), 0),
      title:         `${sign} Script`,
      hook:          job.scriptLines[0]?.text || '',
      trendVaultSign:    sign,
      topic:         job.script?.prompt || '',
      emotionalTone: job.script?.emotionalTone || 'dark',
    };
  } else {
    script = await generateScript(job.script || { trendVaultSign: 'Scorpio' });
  }
  const outputName = `${job.jobId}_script.json`;
  const outputPath = path.join(PATHS.final, outputName);
  fs.mkdirSync(PATHS.final, { recursive: true });
  fs.writeFileSync(outputPath, JSON.stringify(script, null, 2));
  safeCopy(outputPath, path.join(PATHS.driveFinal, outputName));
  return { outputFile: outputName };
}

// ── HANDLER: TTS audio only ───────────────────────────────────────────────────
async function handleTTS(job) {
  const audioDir = path.join(PROJECT_ROOT, 'custom-audio');
  fs.mkdirSync(audioDir, { recursive: true });

  // scriptLines may be provided directly, or a simple text string
  let scriptLines = job.scriptLines;
  if (!scriptLines && job.text) {
    scriptLines = [{ text: job.text, type: 'hook', durationSeconds: 5 }];
  }
  if (!scriptLines?.length) throw new Error('TTS job needs scriptLines[] or text string');

  const audioFile = await generateTTS(scriptLines, job.voice || {}, job.jobId, audioDir);
  const src = path.join(audioDir, audioFile);
  safeCopy(src, path.join(PATHS.final, audioFile));
  safeCopy(src, path.join(PATHS.driveFinal, audioFile));
  return { outputFile: audioFile };
}

// ── HANDLER: Clip factory (extract highlights from a long video) ──────────────
async function handleClip(job) {
  if (!job.inputFile) throw new Error('Clip job needs inputFile');

  // Copy source from Drive uploads to local incoming
  const driveSrc  = path.join(PATHS.driveUploads, job.inputFile);
  const localFile = path.join(PATHS.incoming, job.inputFile);
  const workFile  = path.join(PATHS.working,  job.inputFile);

  if (!fs.existsSync(driveSrc)) throw new Error(`Source not in Drive uploads: ${job.inputFile}`);
  const stable = await waitForStableFile(driveSrc);
  if (!stable) throw new Error(`File never stabilised: ${job.inputFile}`);

  safeCopy(driveSrc, localFile);
  safeCopy(localFile, workFile);

  log('INFO', `Running clip factory on: ${job.inputFile}`);
  const subfolder = job.jobId;
  await spawnLogged('npx', ['tsx', 'scripts/clip.ts', workFile, subfolder], {
    cwd: PROJECT_ROOT,
    env: { ...process.env },
  });

  // Clips land in project's output/final/<subfolder>/
  const clipsDir = path.join(PROJECT_ROOT, 'output', 'final', subfolder);
  if (!fs.existsSync(clipsDir)) throw new Error(`Clip output folder not found: ${clipsDir}`);

  const clips = fs.readdirSync(clipsDir).filter(f => f.endsWith('.mp4'));
  log('INFO', `${clips.length} clips extracted`);

  // Copy all clips to local final and Drive final
  for (const clip of clips) {
    const src = path.join(clipsDir, clip);
    safeCopy(src, path.join(PATHS.final,      `${job.jobId}_${clip}`));
    safeCopy(src, path.join(PATHS.driveFinal, `${job.jobId}_${clip}`));
  }
  return { outputFile: `${clips.length} clips → ${PATHS.driveFinal}` };
}

// ── Master job processor ──────────────────────────────────────────────────────
async function processJob(job) {
  log('INFO',       `${'─'.repeat(60)}`);
  log('PENDING',    `Job ${job.jobId}  type=${job.type}`);

  job.status    = 'processing';
  job.startedAt = new Date().toISOString();
  updateJob(job);
  log('PROCESSING', `Job ${job.jobId}  started`);

  try {
    let result;
    switch (job.type) {
      case 'render':
        result = await handleRender(job);
        break;
      case 'script-only':
        result = await handleScriptOnly(job);
        break;
      case 'tts':
        result = await handleTTS(job);
        break;
      case 'clip':
        result = await handleClip(job);
        break;
      default:
        throw new Error(`Unknown job type: "${job.type}". Valid types: render, script-only, tts, clip`);
    }

    job.status      = 'complete';
    job.completedAt = new Date().toISOString();
    job.outputFile  = result.outputFile;
    job.driveOutput = path.join(PATHS.driveFinal, typeof result.outputFile === 'string' ? result.outputFile : '');
    updateJob(job);
    log('COMPLETE', `Job ${job.jobId}  output=${result.outputFile}`);

  } catch (e) {
    job.status   = 'failed';
    job.failedAt = new Date().toISOString();
    job.error    = e.message;
    updateJob(job);
    log('FAILED',  `Job ${job.jobId}  ${e.message}`);
  }
}

// ── Test mode ─────────────────────────────────────────────────────────────────
async function runTestMode() {
  log('INFO', '══════════════════════════════════════════════════════');
  log('INFO', '  Trend Vault Sync Worker — TEST MODE');
  log('INFO', `  Date        : ${new Date().toISOString()}`);
  log('INFO', `  Project     : ${PROJECT_ROOT}`);
  log('INFO', `  Local root  : ${LOCAL_ROOT}`);
  log('INFO', `  Drive root  : ${DRIVE_ROOT}`);
  log('INFO', '══════════════════════════════════════════════════════');

  let passed = 0, failed = 0;
  function check(label, ok, detail = '') {
    if (ok) {
      log('INFO',  `  [PASS] ${label}${detail ? '  →  ' + detail : ''}`);
      passed++;
    } else {
      log('ERROR', `  [FAIL] ${label}${detail ? '  →  ' + detail : ''}`);
      failed++;
    }
  }

  // ── 1. Create all folders ──────────────────────────────────────────────────
  log('INFO', '');
  log('INFO', '  Step 1 — Create folders');
  ensureFolders();

  for (const [name, p] of Object.entries(PATHS)) {
    check(`Folder [${name}]`, fs.existsSync(p), p);
  }

  // ── 2. Drive write test ────────────────────────────────────────────────────
  log('INFO', '');
  log('INFO', '  Step 2 — Drive write test');

  let driveWritable = false;
  try {
    const pingFile = path.join(PATHS.driveRequests, `.ping-${Date.now()}.tmp`);
    fs.writeFileSync(pingFile, 'ping');
    fs.unlinkSync(pingFile);
    driveWritable = true;
  } catch (e) { /* fall through */ }
  check('Drive requests folder writable', driveWritable, PATHS.driveRequests);

  let driveFinalWritable = false;
  try {
    const pingFile = path.join(PATHS.driveFinal, `.ping-${Date.now()}.tmp`);
    fs.writeFileSync(pingFile, 'ping');
    fs.unlinkSync(pingFile);
    driveFinalWritable = true;
  } catch (e) { /* fall through */ }
  check('Drive final folder writable', driveFinalWritable, PATHS.driveFinal);

  if (!driveWritable || !driveFinalWritable) {
    log('ERROR', '');
    log('ERROR', '  Drive folders are not accessible — cannot continue test.');
    log('ERROR', `  Expected Drive root: ${DRIVE_ROOT}`);
    log('ERROR', '  Check that Google Drive is installed, signed in, and syncing.');
    log('ERROR', '  Then run: npm run setup:sync');
    process.exit(1);
  }

  // ── 3. Write test job to Drive requests (pre-written script, no Claude needed) ──
  log('INFO', '');
  log('INFO', '  Step 3 — Job lifecycle (script-only, no Claude)');

  const jobId   = `test-${Date.now()}`;
  const jobFile = path.join(PATHS.driveRequests, `${jobId}.json`);
  const jobData = {
    jobId,
    type      : 'script-only',
    status    : 'pending',
    createdAt : new Date().toISOString(),
    // pre-written scriptLines — bypasses Claude completely
    scriptLines: [
      { text: 'SYNC TEST — LINE ONE.',  type: 'hook',        durationSeconds: 5 },
      { text: 'SYNC TEST — LINE TWO.',  type: 'observation', durationSeconds: 5 },
      { text: 'SYNC TEST — LINE THREE.', type: 'ending',     durationSeconds: 5 },
    ],
    script: { trendVaultSign: 'Scorpio', emotionalTone: 'dark', prompt: 'sync-test' },
  };

  fs.writeFileSync(jobFile, JSON.stringify(jobData, null, 2));
  check('Job written to Drive requests', fs.existsSync(jobFile), jobFile);

  // ── 4. Process the job ─────────────────────────────────────────────────────
  log('INFO', '');
  log('INFO', '  Step 4 — Process job');
  await processJob({ ...jobData, _file: jobFile });

  // ── 5. Verify outputs ──────────────────────────────────────────────────────
  log('INFO', '');
  log('INFO', '  Step 5 — Verify outputs');

  let jobStatus = 'unknown';
  try { jobStatus = JSON.parse(fs.readFileSync(jobFile, 'utf8')).status; } catch {}

  const outLocal = path.join(PATHS.final,      `${jobId}_script.json`);
  const outDrive = path.join(PATHS.driveFinal, `${jobId}_script.json`);
  const logExists = fs.existsSync(LOG_FILE);
  const driveLogExists = fs.existsSync(path.join(PATHS.driveLogs, path.basename(LOG_FILE)));

  check('Job status = complete',         jobStatus === 'complete',   `status=${jobStatus}`);
  check('Output in local final folder',  fs.existsSync(outLocal),    outLocal);
  check('Output in Drive final folder',  fs.existsSync(outDrive),    outDrive);
  check('Log file written (local)',      logExists,                  LOG_FILE);
  check('Log file mirrored (Drive)',     driveLogExists,             path.join(PATHS.driveLogs, path.basename(LOG_FILE)));

  // ── 6. Summary ────────────────────────────────────────────────────────────
  log('INFO', '');
  log('INFO', '══════════════════════════════════════════════════════');
  if (failed === 0) {
    log('INFO',  `  TEST PASSED — ${passed}/${passed + failed} checks passed`);
    log('INFO',  '  Drive sync pipeline is working correctly.');
    log('INFO',  '');
    log('INFO',  '  Next: on the HOME COMPUTER run:');
    log('INFO',  '    npm run sync:worker');
    log('INFO',  '  Then drop a job JSON into:');
    log('INFO',  `    ${PATHS.driveRequests}`);
  } else {
    log('ERROR', `  TEST FAILED — ${failed} check(s) failed (${passed} passed)`);
    log('ERROR', '  See [FAIL] lines above for details.');
  }
  log('INFO', '══════════════════════════════════════════════════════');

  if (failed > 0) process.exit(1);
}

// ── Drive connectivity check ──────────────────────────────────────────────────
function checkDriveAccess() {
  if (!fs.existsSync(DRIVE_ROOT)) {
    log('WARN', `Google Drive root NOT FOUND: ${DRIVE_ROOT}`);
    log('WARN', 'Google Drive may not be mounted yet — will retry each poll cycle.');
    log('WARN', 'Run "npm run setup:sync" after Drive is mounted to create folders.');
    return false;
  }
  if (!fs.existsSync(PATHS.driveRequests)) {
    log('WARN', `Drive requests folder missing: ${PATHS.driveRequests}`);
    log('WARN', 'Run: npm run setup:sync');
    return false;
  }
  log('INFO', `Drive connected: ${DRIVE_ROOT}`);
  return true;
}

// ── Main poll loop ────────────────────────────────────────────────────────────
async function mainLoop() {
  log('INFO', '══════════════════════════════════════════════════════');
  log('INFO', '  Trend Vault Program Sync Worker — Starting');
  log('INFO', `  Project     : ${PROJECT_ROOT}`);
  log('INFO', `  Local root  : ${LOCAL_ROOT}`);
  log('INFO', `  Drive root  : ${DRIVE_ROOT}`);
  log('INFO', `  Poll every  : ${POLL_MS / 1000}s`);
  log('INFO', '══════════════════════════════════════════════════════');
  log('INFO', '');
  log('INFO', '  Supported job types:');
  log('INFO', '    render      — generate script + TTS + full Remotion render');
  log('INFO', '    script-only — generate script and save as JSON (no render)');
  log('INFO', '    tts         — generate TTS voice audio only');
  log('INFO', '    clip        — extract viral clips from a long video');
  log('INFO', '');

  ensureFolders();
  checkDriveAccess();

  const processing = new Set(); // track in-flight jobIds

  while (true) {
    try {
      const jobs = getPendingJobs();
      if (jobs.length) log('INFO', `Found ${jobs.length} pending job(s)`);
      for (const job of jobs) {
        if (processing.has(job.jobId)) continue;
        processing.add(job.jobId);
        processJob(job).finally(() => processing.delete(job.jobId));
      }
    } catch (e) {
      log('ERROR', `Poll loop error: ${e.message}`);
    }
    await sleep(POLL_MS);
  }
}

// ── Entry point ───────────────────────────────────────────────────────────────
if (TEST_MODE) {
  runTestMode().catch(e => { console.error('[FATAL]', e.message); process.exit(1); });
} else {
  mainLoop().catch(e => { console.error('[FATAL]', e.message); process.exit(1); });
}
