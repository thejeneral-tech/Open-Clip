{
  "audioFile": "zodiac_preview_pv_1778820659055.mp3",
  "audioDurationSec": 54.360816,
  "source": "word-proportional",
  "captions": [
    {
      "index": 0,
      "text": "GEMINIS DON'T DO THIS BY ACCIDENT.",
      "type": "hook",
      "start": 0,
      "end": 2.2969358873239436,
      "duration": 2.2969358873239436,
      "wordCount": 6,
      "startMs": 0,
      "endMs": 2296.9358873239435
    },
    {
      "index": 1,
      "text": "THERE'S SOMETHING SPECIFIC ABOUT THE WAY THEY LOVE — AND THE WAY THEY PROTECT THEMSELVES FROM IT.",
      "type": "observation",
      "start": 2.2969358873239436,
      "end": 8.804920901408451,
      "duration": 6.5079850140845075,
      "wordCount": 17,
      "startMs": 2296.9358873239435,
      "endMs": 8804.920901408452
    },
    {
      "index": 2,
      "text": "MOST PEOPLE SEE THE SURFACE. THE SILENCE. THE DISTANCE. THE WAY THEY SEEM UNMOVED WHEN EVERYTHING IS MOVING INSIDE THEM.",
      "type": "observation",
      "start": 8.804920901408451,
      "end": 16.461373859154932,
      "duration": 7.656452957746481,
      "wordCount": 20,
      "startMs": 8804.920901408452,
      "endMs": 16461.373859154934
    },
    {
      "index": 3,
      "text": "BUT THE REALITY IS FAR MORE COMPLICATED THAN THAT.",
      "type": "escalation",
      "start": 16.461373859154932,
      "end": 19.90677769014085,
      "duration": 3.445403830985917,
      "wordCount": 9,
      "startMs": 16461.373859154934,
      "endMs": 19906.77769014085
    },
    {
      "index": 4,
      "text": "THEY MAKE YOU FEEL LIKE THE MOST INTERESTING PERSON IN THE ROOM. AND YOU SPEND THE REST OF YOUR LIFE TRYING TO GET BACK TO THAT FEELING.",
      "type": "escalation",
      "start": 19.90677769014085,
      "end": 30.242989183098594,
      "duration": 10.336211492957744,
      "wordCount": 27,
      "startMs": 19906.77769014085,
      "endMs": 30242.989183098594
    },
    {
      "index": 5,
      "text": "THE PEOPLE WHO SEEM THE HARDEST TO REACH ARE USUALLY THE ONES WHO FELT THINGS SO DEEPLY ONCE — THEY BUILT SOMETHING AROUND IT.",
      "type": "truth",
      "start": 30.242989183098594,
      "end": 39.43073273239437,
      "duration": 9.187743549295774,
      "wordCount": 24,
      "startMs": 30242.989183098594,
      "endMs": 39430.73273239437
    },
    {
      "index": 6,
      "text": "NOT TO KEEP OTHERS OUT.",
      "type": "truth",
      "start": 39.43073273239437,
      "end": 41.344845971830985,
      "duration": 1.9141132394366167,
      "wordCount": 5,
      "startMs": 39430.73273239437,
      "endMs": 41344.84597183098
    },
    {
      "index": 7,
      "text": "TO KEEP THEMSELVES IN.",
      "type": "twist",
      "start": 41.344845971830985,
      "end": 42.87613656338028,
      "duration": 1.5312905915492934,
      "wordCount": 4,
      "startMs": 41344.84597183098,
      "endMs": 42876.13656338028
    },
    {
      "index": 8,
      "text": "WHEN A GEMINI FINALLY LOWERS THAT WALL — EVEN SLIGHTLY — IT'S NOT WEAKNESS.",
      "type": "twist",
      "start": 42.87613656338028,
      "end": 48.23565363380281,
      "duration": 5.359517070422534,
      "wordCount": 14,
      "startMs": 42876.13656338028,
      "endMs": 48235.65363380281
    },
    {
      "index": 9,
      "text": "IT'S THE BRAVEST THING THEY'VE EVER DONE.",
      "type": "ending",
      "start": 48.23565363380281,
      "end": 50.91541216901408,
      "duration": 2.6797585352112705,
      "wordCount": 7,
      "startMs": 48235.65363380281,
      "endMs": 50915.41216901408
    },
    {
      "index": 10,
      "text": "AND MOST PEOPLE NEVER REALIZE THEY WERE WITNESSING IT.",
      "type": "ending",
      "start": 50.91541216901408,
      "end": 54.360816,
      "duration": 3.445403830985917,
      "wordCount": 9,
      "startMs": 50915.41216901408,
      "endMs": 54360.816
    }
  ]
}