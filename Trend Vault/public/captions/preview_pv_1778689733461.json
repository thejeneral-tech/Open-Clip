{
  "audioFile": "trend_vault_preview_pv_1778689733461.mp3",
  "audioDurationSec": 90,
  "source": "word-proportional",
  "captions": [
    {
      "index": 0,
      "text": "GEMINIS DON'T DO THIS BY ACCIDENT.",
      "type": "hook",
      "start": 0,
      "end": 3.8028169014084505,
      "duration": 3.8028169014084505,
      "wordCount": 6,
      "startMs": 0,
      "endMs": 3802.8169014084506
    },
    {
      "index": 1,
      "text": "THERE'S SOMETHING SPECIFIC ABOUT THE WAY THEY LOVE — AND THE WAY THEY PROTECT THEMSELVES FROM IT.",
      "type": "observation",
      "start": 3.8028169014084505,
      "end": 14.577464788732392,
      "duration": 10.774647887323942,
      "wordCount": 17,
      "startMs": 3802.8169014084506,
      "endMs": 14577.464788732392
    },
    {
      "index": 2,
      "text": "MOST PEOPLE SEE THE SURFACE. THE SILENCE. THE DISTANCE. THE WAY THEY SEEM UNMOVED WHEN EVERYTHING IS MOVING INSIDE THEM.",
      "type": "observation",
      "start": 14.577464788732392,
      "end": 27.25352112676056,
      "duration": 12.676056338028168,
      "wordCount": 20,
      "startMs": 14577.464788732392,
      "endMs": 27253.52112676056
    },
    {
      "index": 3,
      "text": "BUT THE REALITY IS FAR MORE COMPLICATED THAN THAT.",
      "type": "escalation",
      "start": 27.25352112676056,
      "end": 32.95774647887323,
      "duration": 5.7042253521126725,
      "wordCount": 9,
      "startMs": 27253.52112676056,
      "endMs": 32957.74647887323
    },
    {
      "index": 4,
      "text": "THEY MAKE YOU FEEL LIKE THE MOST INTERESTING PERSON IN THE ROOM. AND YOU SPEND THE REST OF YOUR LIFE TRYING TO GET BACK TO THAT FEELING.",
      "type": "escalation",
      "start": 32.95774647887323,
      "end": 50.070422535211264,
      "duration": 17.11267605633803,
      "wordCount": 27,
      "startMs": 32957.74647887323,
      "endMs": 50070.42253521126
    },
    {
      "index": 5,
      "text": "THE PEOPLE WHO SEEM THE HARDEST TO REACH ARE USUALLY THE ONES WHO FELT THINGS SO DEEPLY ONCE — THEY BUILT SOMETHING AROUND IT.",
      "type": "truth",
      "start": 50.070422535211264,
      "end": 65.28169014084507,
      "duration": 15.211267605633807,
      "wordCount": 24,
      "startMs": 50070.42253521126,
      "endMs": 65281.69014084507
    },
    {
      "index": 6,
      "text": "NOT TO KEEP OTHERS OUT.",
      "type": "truth",
      "start": 65.28169014084507,
      "end": 68.45070422535211,
      "duration": 3.1690140845070403,
      "wordCount": 5,
      "startMs": 65281.69014084507,
      "endMs": 68450.7042253521
    },
    {
      "index": 7,
      "text": "TO KEEP THEMSELVES IN.",
      "type": "twist",
      "start": 68.45070422535211,
      "end": 70.98591549295774,
      "duration": 2.535211267605632,
      "wordCount": 4,
      "startMs": 68450.7042253521,
      "endMs": 70985.91549295775
    },
    {
      "index": 8,
      "text": "WHEN A GEMINI FINALLY LOWERS THAT WALL — EVEN SLIGHTLY — IT'S NOT WEAKNESS.",
      "type": "twist",
      "start": 70.98591549295774,
      "end": 79.85915492957746,
      "duration": 8.873239436619713,
      "wordCount": 14,
      "startMs": 70985.91549295775,
      "endMs": 79859.15492957746
    },
    {
      "index": 9,
      "text": "IT'S THE BRAVEST THING THEY'VE EVER DONE.",
      "type": "ending",
      "start": 79.85915492957746,
      "end": 84.29577464788731,
      "duration": 4.436619718309856,
      "wordCount": 7,
      "startMs": 79859.15492957746,
      "endMs": 84295.77464788732
    },
    {
      "index": 10,
      "text": "AND MOST PEOPLE NEVER REALIZE THEY WERE WITNESSING IT.",
      "type": "ending",
      "start": 84.29577464788731,
      "end": 90,
      "duration": 5.704225352112687,
      "wordCount": 9,
      "startMs": 84295.77464788732,
      "endMs": 90000
    }
  ]
}