node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# PyInstaller build artifacts (the final .exe IS committed, only the staging junk is ignored)
build/
dist/
*.spec

# TikTok uploader persistent auth session — DO NOT COMMIT
.tiktok-session/

# YouTube uploader OAuth credentials and tokens — DO NOT COMMIT


# Instagram uploader session — DO NOT COMMIT
data/instagram-session.json
data/instagram-2fa-pending.json

# AI model weights — never commit. The Fish Audio S2 Pro model is installed
# to ~/.cache/trendvault/models/s2-pro by the launcher, OUTSIDE this repo.
# These rules are belt-and-braces in case anyone ever symlinks the model
# directory into the working tree by accident. Scoped tightly so we don't
# accidentally exclude the small kokoro-tts/*.onnx model the launcher ships
# with the repo.
*.safetensors
*.pth
*.gguf
/models/
/s2-pro/
