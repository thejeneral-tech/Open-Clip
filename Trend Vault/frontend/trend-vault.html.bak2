const FONT_CATEGORIES = [
  { id:'all',          label:'All' },
  { id:'tiktok',       label:'TikTok' },
  { id:'cinematic',    label:'Cinematic' },
  { id:'bold',         label:'Bold' },
  { id:'clean',        label:'Clean' },
  { id:'horror',       label:'Horror' },
  { id:'luxury',       label:'Luxury' },
  { id:'documentary',  label:'Documentary' },
  { id:'meme',         label:'Meme' },
  { id:'handwriting',  label:'Handwriting' },
  { id:'storytime',    label:'Storytime' },
];
let currentFontCat = 'all';

function buildFontGrid(){
  const catRow = document.getElementById('fontCatRow');
  const grid   = document.getElementById('fontGrid');
  const sel    = document.getElementById('fontSelect');
  if(!catRow||!grid||!sel) return;

  // Populate hidden select for backwards compat
  sel.innerHTML = FONT_LIBRARY.map(f=>`<option value="${f.value.replace(/"/g,'&quot;')}">${f.name}</option>`).join('');

  // Category pills
  catRow.innerHTML = FONT_CATEGORIES.map(c=>`
    <button class="font-cat-pill" data-cat="${c.id}" onclick="filterFontCat('${c.id}')"
      style="padding:4px 9px;font-size:.66rem;font-weight:600;background:${c.id===currentFontCat?'rgba(124,58,237,.18)':'var(--surface2)'};border:1px solid ${c.id===currentFontCat?'var(--purple)':'var(--border)'};color:${c.id===currentFontCat?'var(--purple2)':'var(--muted)'};border-radius:6px;cursor:pointer;font-family:inherit">${c.label}</button>
  `).join('');

  renderFontGrid();
}

function filterFontCat(cat){
  currentFontCat = cat;
  buildFontGrid();
}

function renderFontGrid(){
  const grid = document.getElementById('fontGrid');
  if(!grid) return;
  const fonts = currentFontCat==='all' ? FONT_LIBRARY : FONT_LIBRARY.filter(f=>f.cat===currentFontCat);
  grid.innerHTML = fonts.map(f=>`
    <div class="font-tile" onclick="setFontByValue(${JSON.stringify(f.value).replace(/"/g,'&quot;')},${JSON.stringify(f.name).replace(/"/g,'&quot;')})"
      style="padding:9px 10px;background:${state.fontFamily===f.value?'rgba(124,58,237,.12)':'var(--surface2)'};border:1px solid ${state.fontFamily===f.value?'var(--purple)':'var(--border)'};border-radius:8px;cursor:pointer;text-align:center;transition:all .15s">
      <div style="font-family:${f.value};font-size:.95rem;font-weight:700;color:var(--text);line-height:1.2">${f.name}</div>
      <div style="font-size:.55rem;color:var(--muted);margin-top:3px;text-transform:uppercase;letter-spacing:.5px">${f.cat}</div>
    </div>
  `).join('');
}

function setFontByValue(value, displayName){
  state.fontFamily = value;
  const sel = document.getElementById('fontSelect');
  if(sel) sel.value = value;
  const preview = document.getElementById('fontPreview');
  if(preview) preview.style.fontFamily = value;
  renderFontGrid();
  updatePreview();
  showToast(`Font: ${displayName}`,'info');
}

// ═══════════════════════════════════════════════════════════════════
// TIMELINE SCRUBBER (script line index)
// ═══════════════════════════════════════════════════════════════════

function refreshTimelineSlider(){
  const s = document.getElementById('timelineSlider');
  if(!s) return;
  const fmtT = n => `${Math.floor(n/60)}:${String(Math.floor(n%60)).padStart(2,'0')}`;
  const pt = document.getElementById('previewTime');
  const lc = document.getElementById('lineCounter');
  const markers = document.getElementById('timelineMarkers');

  // ── Audio-driven mode: slider is seconds × 100 for 0.01s precision ──────
  if(_hasAudio()){
    const totalSec = state.previewAudioDurationSec || 0;
    const curSec   = (_previewAudioEl ? _previewAudioEl.currentTime : 0);
    s.min  = 0;
    s.max  = Math.max(1, Math.round(totalSec * 100));
    s.step = 1; // 0.01s
    // Only overwrite while NOT actively being dragged by the user
    if(!s.dataset.dragging) s.value = Math.round(curSec * 100);

    if(pt) pt.textContent = `${fmtT(curSec)} / ${fmtT(totalSec)}`;
    if(lc) lc.textContent = `Line ${state.script.length?state.previewLineIdx+1:0}/${state.script.length}`;

    // Markers — one per caption boundary at its true seconds-position
    if(markers && state.previewCaptions?.length){
      const t = totalSec || 1;
      markers.innerHTML = state.previewCaptions.map((c, i) => {
        const pct = (c.start / t) * 100;
        const col = i === state.previewLineIdx ? 'var(--gold2)' : 'rgba(255,255,255,.25)';
        return `<div style="position:absolute;left:${pct}%;width:2px;height:6px;background:${col};border-radius:1px;transform:translateX(-50%)"></div>`;
      }).join('');
    }
    return;
  }

  // ── Legacy line-index mode (no voice preview generated yet) ─────────────
  s.max = Math.max(0, state.script.length - 1);
  s.step = 1;
  s.value = state.previewLineIdx;

  const totalSec = state.script.reduce((a,l)=>a+(l.durationSeconds||3),0);
  const elapsedSec = state.script.slice(0, state.previewLineIdx).reduce((a,l)=>a+(l.durationSeconds||3),0);
  if(pt) pt.textContent = `${fmtT(elapsedSec)} / ${fmtT(totalSec)}`;
  if(lc) lc.textContent = `Line ${state.script.length?state.previewLineIdx+1:0}/${state.script.length}`;

  if(markers && state.script.length > 1){
    const total = state.script.length - 1;
    markers.innerHTML = state.script.map((_, i) => {
      const pct = (i / total) * 100;
      const col = i === state.previewLineIdx ? 'var(--gold2)' : 'rgba(255,255,255,.25)';
      return `<div style="position:absolute;left:${pct}%;width:2px;height:6px;background:${col};border-radius:1px;transform:translateX(-50%)"></div>`;
    }).join('');
  }
}

// Track whether the user is actively dragging the slider so the RAF tick
// doesn't fight with their input. Bound at script init below.
function _bindTimelineDragGuards(){
  const s = document.getElementById('timelineSlider');
  if(!s || s.dataset.bound) return;
  s.dataset.bound = '1';
  const start = () => { s.dataset.dragging = '1'; };
  const end   = () => { delete s.dataset.dragging; };
  s.addEventListener('mousedown', start);
  s.addEventListener('touchstart', start, { passive: true });
  window.addEventListener('mouseup', end);
  window.addEventListener('touchend', end);
}
// Run bind on next tick — DOM is ready by the time playback is started
setTimeout(_bindTimelineDragGuards, 0);

function seekTimeline(v){
  // Audio-driven: `v` is hundredths of a second; convert to seconds and
  // seek the <audio> element directly. Don't stop playback — let the user
  // scrub while still playing.
  if(_hasAudio() && _previewAudioEl){
    const t = Math.max(0, Math.min(state.previewAudioDurationSec, (+v) / 100));
    _previewAudioEl.currentTime = t;
    const newIdx = _findCaptionIndexForTime(state.previewCaptions, t);
    const lineChanged = newIdx !== state.previewLineIdx;
    state.previewLineIdx = newIdx;
    // Only re-run the full updatePreview (which restarts the caption text
    // animation via playCaptionAnim) when the line actually changes. Slider
    // input events fire 60–120×/s while dragging, so calling updatePreview
    // on every tick previously restarted the typewriter / glow / word-drop
    // animation each pixel — causing visible text jitter during scrubbing.
    // This mirrors the RAF playback tick which is already gated the same way.
    if(lineChanged) updatePreview();
    refreshTimelineSlider();
    return;
  }
  // Legacy line-index mode
  stopPlayPreview();
  state.previewLineIdx = Math.min(state.script.length-1, Math.max(0, +v));
  updatePreview();
  refreshTimelineSlider();
}

// ═══════════════════════════════════════════════════════════════════
// DOWNLOAD QUEUE (background jobs)
// ═══════════════════════════════════════════════════════════════════

let downloadQueuePollInterval = null;

async function refreshDownloadQueue(){
  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/download-queue`);
    const {jobs} = await r.json();
    const sect = document.getElementById('downloadQueueSection');
    const list = document.getElementById('downloadQueueList');
    if(!jobs.length){ if(sect) sect.style.display='none'; return; }
    if(sect) sect.style.display='block';
    const colors = {
      queued:'#94a3b8', resolving:'#60a5fa', downloading:'#a78bfa',
      extracting:'#f59e0b', complete:'#34d399', failed:'#f87171',
    };
    list.innerHTML = jobs.slice(0,8).map(j=>`
      <div style="background:var(--surface2);border:1px solid var(--border);border-radius:8px;padding:7px 9px;font-size:.66rem">
        <div style="display:flex;align-items:center;gap:6px">
          <span style="color:${colors[j.status]||'#94a3b8'};font-weight:700;flex:1">${j.status.toUpperCase()}</span>
          <span style="color:var(--muted);font-size:.6rem">${j.type}</span>
          <button onclick="dismissJob('${j.id}')" style="background:none;border:none;color:var(--muted);cursor:pointer;font-size:.7rem">✕</button>
        </div>
        <div style="color:var(--text2);margin-top:2px;word-break:break-word">${j.filename||j.url.slice(0,40)+'…'}</div>
        ${j.error?`<div style="color:#f87171;margin-top:2px;font-size:.6rem">${j.error.slice(0,100)}</div>`:''}
        ${j.savePath?`<div style="color:var(--muted);margin-top:2px;font-size:.58rem">${j.savePath}</div>`:''}
      </div>`).join('');

    // Stop polling when all jobs are terminal
    const stillRunning = jobs.some(j=>j.status!=='complete'&&j.status!=='failed');
    if(!stillRunning && downloadQueuePollInterval){
      clearInterval(downloadQueuePollInterval);
      downloadQueuePollInterval = null;
      // Refresh background/music lists when downloads finish
      loadBackgrounds(); loadMusic();
    }
  }catch{}
}

function startDownloadQueuePolling(){
  if(downloadQueuePollInterval) return;
  refreshDownloadQueue();
  downloadQueuePollInterval = setInterval(refreshDownloadQueue, 2000);
}

async function dismissJob(id){
  await fetch(`${API_BASE}/api/trend-vault/download-queue/${id}`,{method:'DELETE'});
  refreshDownloadQueue();
}

// ═══════════════════════════════════════════════════════════════════
// VIDEO SPEED / PLAYBACK RATE
// ═══════════════════════════════════════════════════════════════════

function setBgSpeed(v){
  const rate = v / 100;
  document.getElementById('bgSpeedVal').textContent = rate.toFixed(2)+'×';
  const vid = document.getElementById('phoneBgVideo');
  if(vid) vid.playbackRate = rate;
  updateSliderTrack('bgSpeedSlider');
}

function resetBgSpeed(){
  document.getElementById('bgSpeedSlider').value = 100;
  setBgSpeed(100);
}

// ═══════════════════════════════════════════════════════════════════
// CAPTION DRAG (reposition text in preview)
// ═══════════════════════════════════════════════════════════════════

(function initCaptionDrag(){
  let dragging = false, startY = 0, startTop = 0;

  function getWrap(){ return document.getElementById('phoneCaptionWrap'); }
  function getPhone(){ return document.getElementById('phoneFrame'); }

  function onDown(e){
    const wrap = getWrap(); if(!wrap)return;
    dragging = true;
    startY = e.touches ? e.touches[0].clientY : e.clientY;
    const currentTop = parseInt(wrap.style.top || '') || null;
    const phone = getPhone();
    const phoneH = phone ? phone.offsetHeight : 500;
    if(currentTop !== null){
      startTop = currentTop;
    } else {
      // Convert bottom% to top px
      const bottomPct = parseFloat(wrap.style.bottom || '18') / 100;
      startTop = phoneH - phoneH * bottomPct - (wrap.offsetHeight || 40);
      wrap.style.bottom = '';
    }
    wrap.style.top = startTop + 'px';
    wrap.classList.add('dragging');
    e.preventDefault();
  }

  function onMove(e){
    if(!dragging) return;
    const wrap = getWrap(); const phone = getPhone(); if(!wrap||!phone)return;
    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
    const dy = clientY - startY;
    const phoneRect = phone.getBoundingClientRect();
    const maxTop = phoneRect.height - (wrap.offsetHeight || 40) - 4;
    const newTop = Math.max(4, Math.min(maxTop, startTop + dy));
    wrap.style.top = newTop + 'px';
    e.preventDefault();
  }

  function onUp(){
    if(!dragging)return;
    dragging = false;
    const wrap = getWrap(); if(wrap) wrap.classList.remove('dragging');
    // Persist caption position as % of phone height — sent to renderer so
    // the rendered video matches what the user sees in the preview.
    const phone = getPhone();
    if(wrap && phone){
      const topPx  = parseFloat(wrap.style.top || '0');
      const phoneH = phone.offsetHeight || 1;
      state.captionTopPct = Math.max(0, Math.min(100, Math.round((topPx / phoneH) * 100)));
    }
  }

  document.addEventListener('mousedown', e=>{
    if(e.target.closest('#phoneCaptionWrap')) onDown(e);
  });
  document.addEventListener('mousemove', onMove);
  document.addEventListener('mouseup', onUp);
  document.addEventListener('touchstart', e=>{
    if(e.target.closest('#phoneCaptionWrap')) onDown(e);
  }, {passive:false});
  document.addEventListener('touchmove', onMove, {passive:false});
  document.addEventListener('touchend', onUp);
})();

// ═══════════════════════════════════════════════════════════════════
// PROMPT FAVORITES & FRESH PROMPTS
// ═══════════════════════════════════════════════════════════════════

let savedFavPrompts = JSON.parse(localStorage.getItem('trend_vault_fav_prompts') || '[]');
let currentPromptTab = 'all';
let _lastFreshPrompts = []; // excluded on next FRESH call so results differ each time
let _freshAbort = null;      // AbortController for in-flight generate-prompts request

function showPromptTab(tab){
  currentPromptTab = tab;
  document.getElementById('promptList').style.display = tab==='all'?'':'none';
  document.getElementById('promptListSaved').style.display = tab==='saved'?'':'none';
  document.getElementById('freshPromptsArea').style.display = tab==='fresh'?'':'none';

  document.getElementById('ptabAll').style.cssText = tab==='all'
    ? 'flex:1;padding:5px;background:rgba(124,58,237,.15);border:1px solid var(--purple);border-radius:7px;color:var(--purple2);font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit'
    : 'flex:1;padding:5px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit';
  document.getElementById('ptabSaved').style.cssText = tab==='saved'
    ? 'flex:1;padding:5px;background:rgba(220,38,38,.12);border:1px solid rgba(220,38,38,.4);border-radius:7px;color:#f87171;font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit'
    : 'flex:1;padding:5px;background:var(--surface2);border:1px solid var(--border);border-radius:7px;color:var(--muted);font-size:.72rem;font-weight:700;cursor:pointer;font-family:inherit';

  if(tab==='saved') renderSavedPrompts();
}

function toggleFavoritePrompt(id, text, e){
  if(e) e.stopPropagation();
  const idx = savedFavPrompts.findIndex(p=>p.id===id);
  if(idx>=0){
    savedFavPrompts.splice(idx,1);
    showToast('Removed from saved','info');
  } else {
    savedFavPrompts.push({id, text});
    showToast('❤️ Saved to favourites!','success');
  }
  localStorage.setItem('trend_vault_fav_prompts', JSON.stringify(savedFavPrompts));
  // Re-render current list to update heart state
  if(currentPromptTab==='all') filterPromptsBySign();
  else renderSavedPrompts();
}

function renderSavedPrompts(){
  const list = document.getElementById('promptListSaved');
  if(!savedFavPrompts.length){
    list.innerHTML='<li style="font-size:.75rem;color:var(--muted);padding:8px 0;list-style:none">No saved prompts yet — click ❤️ on any prompt.</li>';
    return;
  }
  // Same delegation pattern as fresh prompts — embedding JSON.stringify into
  // onclick="..." breaks on apostrophes/quotes. Stash by index, read via
  // data-fav-idx.
  list.innerHTML = savedFavPrompts.map((p, i) => `
    <li class="saved-fav-card" data-fav-idx="${i}"
        style="list-style:none;display:flex;align-items:center;gap:8px;padding:8px 10px;background:var(--surface2);border:1px solid var(--border);border-radius:9px;cursor:pointer;margin-bottom:5px">
      <div style="flex:1;font-size:.78rem;color:var(--text2)" data-fav-action="select">${_htmlEscape(p.text)}</div>
      <button data-fav-action="unfav" style="background:none;border:none;color:#f87171;cursor:pointer;font-size:.9rem;flex-shrink:0">❤️</button>
    </li>`).join('');
}

// Event delegation for the saved-favorites list
document.addEventListener('click', (ev) => {
  const card = ev.target.closest?.('.saved-fav-card');
  if(!card) return;
  const idx = parseInt(card.dataset.favIdx, 10);
  const fav = savedFavPrompts[idx];
  if(!fav) return;
  ev.stopPropagation();
  if(ev.target.dataset?.favAction === 'unfav'){
    toggleFavoritePrompt(fav.id, fav.text, ev);
    return;
  }
  selectCustomPrompt(fav.text);
  markDirty('script');
});

// ── Prompt Memory System (Phase 2/3) ────────────────────────────────────────
// Single source-of-truth helpers. Every UI button that touches the prompt
// calls one of these so we always know what currentPrompt is and what
// generation will actually use.

function _pushUndo(){
  state._undoStack = state._undoStack || [];
  state._undoStack.push(state.currentPrompt || '');
  while(state._undoStack.length > 10) state._undoStack.shift();
}

function promptSetOriginal(text){
  // Called the first time the user picks/types a prompt, OR when they press
  // "Set as New Original". Establishes the baseline.
  const t = (text || '').trim();
  if(!t) return;
  _pushUndo();
  state.originalPrompt = t;
  state.currentPrompt  = t;
  state.aiAdditions    = [];
  state.promptVersion  = 1;
  state.lastAppliedAt  = new Date().toISOString();
  refreshPromptMemoryUI();
}

function promptAppend(text, source = 'manual-edit'){
  // Adds a chunk to currentPrompt without touching originalPrompt.
  const t = (text || '').trim();
  if(!t) return;
  _pushUndo();
  const sep = state.currentPrompt && !/[.!?…]\s*$/.test(state.currentPrompt) ? '. ' : ' ';
  state.currentPrompt = (state.currentPrompt || '').trim() + sep + t;
  state.aiAdditions.push({
    id: 'add_' + Date.now().toString(36),
    text: t,
    createdAt: new Date().toISOString(),
    source,
  });
  state.promptVersion = (state.promptVersion || 0) + 1;
  state.lastAppliedAt = new Date().toISOString();
  refreshPromptMemoryUI();
}

// Used by the fresh-prompt card "+ Add to Mine" button.
function promptMemoryAppend(text, source){
  promptAppend(text, source);
}

function promptResetToOriginal(){
  if(!state.originalPrompt){ showToast('No original prompt saved yet','info'); return; }
  if(!confirm('Reset to your original prompt? AI improvements will be discarded.')) return;
  _pushUndo();
  state.currentPrompt = state.originalPrompt;
  state.aiAdditions   = [];
  state.promptVersion = (state.promptVersion || 0) + 1;
  state.lastAppliedAt = new Date().toISOString();
  state.resetCount    = (state.resetCount || 0) + 1;
  refreshPromptMemoryUI();
  showToast('Reset to original prompt', 'info');
}

function promptFullReset(){
  if(!confirm('Full reset will erase original prompt, current prompt, AI additions, and selected story prompt. Continue?')) return;
  state.originalPrompt      = '';
  state.currentPrompt       = '';
  state.aiAdditions          = [];
  state.selectedStoryPrompt = '';
  state.selectedFreshPromptIdx = -1;
  state.promptVersion       = 0;
  state.lastAppliedAt       = null;
  state.resetCount          = (state.resetCount || 0) + 1;
  state._undoStack          = [];
  // Also clear the legacy promptText / displayed prompt
  state.promptText  = '';
  state.promptAngle = '';
  const pm = document.getElementById('promptMain');     if(pm) pm.textContent = '';
  const pa = document.getElementById('promptAngle');    if(pa) pa.textContent = '';
  const pd = document.getElementById('promptDisplay');  if(pd) pd.style.display = 'none';
  refreshPromptMemoryUI();
  showToast('Full reset', 'info');
}

function promptUndoLastAI(){
  if(!state._undoStack || !state._undoStack.length){ showToast('Nothing to undo', 'info'); return; }
  const prev = state._undoStack.pop();
  state.currentPrompt = prev || state.originalPrompt || '';
  if(state.aiAdditions?.length) state.aiAdditions.pop();
  state.promptVersion = Math.max(1, (state.promptVersion || 1) - 1);
  refreshPromptMemoryUI();
  showToast('Undid last change', 'info');
}

// ── Active premise (single source of truth) ────────────────────────────────
// Generate Script AND the "Script will use" preview both read from this so
// they can never disagree. Priority: currentPrompt (the working/AI-improved
// prompt) → selectedStoryPrompt (a clicked AI suggestion) → legacy promptText.
function getActivePremise(){
  return (
    (state.currentPrompt || '').trim() ||
    (state.selectedStoryPrompt || '').trim() ||
    (state.promptText || '').trim() ||
    ''
  );
}
window.getActivePremise = getActivePremise;

// ── Tone helper: returns the raw tone id AND a boolean "is this an emotional
// tone" flag so the server can choose between cinematic-emotional and
// clean-direct rewrites.
function getEmotionalToneFlag(){
  const t = String(state.tone || '').toLowerCase();
  // Treat anything explicitly emotional / dramatic / intense as "emotional ON".
  // Tones like 'clean' or 'direct' (if defined) stay OFF.
  const emotionalSet = ['emotional','intense','dramatic','sad','mysterious','dark','heartbreak','romantic','nostalgic','vulnerable'];
  return emotionalSet.includes(t);
}
window.getEmotionalToneFlag = getEmotionalToneFlag;

// Re-entrancy lock — guarantees Apply AI cannot fire twice in parallel even
// if the user mashes the button before disabled state takes effect.
let _applyAIInFlight = false;

async function applyAIToPrompt(){
  if(_applyAIInFlight){
    console.log('[Apply AI] blocked — request already in flight');
    return;
  }
  // Establish a baseline if the user typed something into the textarea but
  // never selected a prompt.
  const editor = document.getElementById('promptMemoryEditor');
  const editorVal = (editor?.value || '').trim();
  if(editorVal && !state.originalPrompt){
    // Seed both original and current with the typed text (single _pushUndo
    // inside promptSetOriginal). No duplicate undo entry here.
    promptSetOriginal(editorVal);
  } else if(editorVal && editorVal !== state.currentPrompt){
    // User edited the textarea directly — sync to currentPrompt
    _pushUndo();
    state.currentPrompt = editorVal;
  }
  if(!state.currentPrompt){
    showToast('Type a prompt first', 'info');
    editor?.focus();
    return;
  }

  _applyAIInFlight = true;
  const btn        = document.getElementById('applyAIBtn');
  const genBtn     = document.getElementById('generateBtn');
  const genBarBtn  = document.getElementById('genBtnBar');
  if(btn){ btn.disabled = true; btn.dataset._origText = btn.textContent; btn.innerHTML = '<span class="spinner"></span> Applying AI…'; }
  // Disable Generate Script while Apply AI is running so the user can't kick
  // off a script with a half-applied premise.
  if(genBtn)    genBtn.disabled    = true;
  if(genBarBtn) genBarBtn.disabled = true;

  const toneId   = state.tone || 'mysterious';
  const toneFlag = getEmotionalToneFlag();
  console.log('[Apply AI] sending', { currentPrompt: state.currentPrompt, emotionalTone: toneFlag, toneId, sign: state.sign });

  try {
    const r = await fetch(`${API_BASE}/api/trend-vault/improve-prompt`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        // New canonical fields requested by the spec
        prompt:         state.currentPrompt,
        emotionalTone:  toneFlag,         // boolean — true means "be dramatic"
        currentSign:    state.sign || null,
        scriptStyle:    state.scriptStyle || null,
        // Legacy fields kept for backward compat with the existing route
        originalPrompt: state.originalPrompt,
        currentPrompt:  state.currentPrompt,
        aiAdditions:    state.aiAdditions || [],
        trendVaultSign:     state.sign,
        tone:           toneId,
      }),
    });
    const data = await r.json();
    if(!data.ok) throw new Error(data.error || 'AI improve failed');

    const improved = (data.improvedPrompt || '').trim();
    if(!improved){
      // Don't wipe the prompt on an empty response — surface a clear error.
      throw new Error('AI returned an empty improvedPrompt');
    }

    _pushUndo();
    state.currentPrompt = improved;
    state.aiAdditions = state.aiAdditions || [];
    // Label entry with whatever provider actually answered (anthropic / openai
    // / local-fallback) so the history is honest about what happened.
    const sourceLabel = data.provider || 'ai-improve';
    state.aiAdditions.push({
      id: 'ai_' + Date.now().toString(36),
      text: data.addedDetails || improved,
      explanation: data.explanation || '',
      createdAt: new Date().toISOString(),
      source: sourceLabel,
      emotionalToneApplied: !!data.emotionalToneApplied,
    });
    state.promptVersion = (state.promptVersion || 0) + 1;
    state.lastAppliedAt = new Date().toISOString();

    // Force-update the editor textarea so the user immediately SEES the
    // improved prompt — even if the editor still has focus.
    if(editor){
      editor.value = state.currentPrompt;
    }
    refreshPromptMemoryUI();
    markDirty('script');
    console.log('[Apply AI] success', { provider: sourceLabel, improved: state.currentPrompt });
    if(data.warning){
      showToast(`${data.warning} (provider: ${sourceLabel})`, 'info');
    } else {
      showToast(`AI applied (${sourceLabel}) — ${data.addedDetails || 'prompt improved'}`, 'success');
    }
  } catch(e) {
    const msg = (e && e.message) || String(e);
    console.warn('[Apply AI] failed:', msg);
    // Explicit, visible failure — never silently no-op. currentPrompt is NOT
    // cleared on error (we want the user's typed text preserved).
    showToast('Apply AI failed: ' + msg, 'error');
  } finally {
    _applyAIInFlight = false;
    if(btn){ btn.disabled = false; btn.innerHTML = btn.dataset._origText || '✨ Apply AI'; }
    if(genBtn)    genBtn.disabled    = false;
    if(genBarBtn) genBarBtn.disabled = false;
  }
}

function promptSetAsNewOriginal(){
  if(!state.currentPrompt){ showToast('No current prompt','info'); return; }
  state.originalPrompt = state.currentPrompt;
  state.aiAdditions   = [];
  state.promptVersion = 1;
  refreshPromptMemoryUI();
  showToast('Saved as new original','success');
}

function refreshPromptMemoryUI(){
  const editor = document.getElementById('promptMemoryEditor');
  if(editor && document.activeElement !== editor){
    editor.value = state.currentPrompt || '';
  }
  const orig = document.getElementById('promptOriginalDisplay');
  if(orig) orig.textContent = state.originalPrompt || '(not saved yet — type a prompt and Apply AI to set it)';
  const v = document.getElementById('promptVersionLabel');
  if(v) v.textContent = `v${state.promptVersion || 0}` + (state.aiAdditions?.length ? ` · ${state.aiAdditions.length} AI improvement${state.aiAdditions.length===1?'':'s'}` : '');
  const willUse = document.getElementById('promptWillUseLabel');
  if(willUse){
    // SINGLE SOURCE OF TRUTH: this label MUST match what generateScript()
    // will send to the server. Both call getActivePremise() so they cannot
    // disagree. Previously the label preferred selectedStoryPrompt while
    // generateScript preferred currentPrompt — making Apply AI appear broken.
    const premise = (typeof getActivePremise === 'function') ? getActivePremise() : (state.currentPrompt || '');
    const preview = premise ? premise.slice(0, 120) + (premise.length > 120 ? '…' : '') : '';
    willUse.textContent = premise
      ? `Script will use: "${preview}"`
      : 'Script will use: (nothing — type a prompt)';
  }
  const history = document.getElementById('promptHistoryList');
  if(history){
    const adds = (state.aiAdditions || []).slice().reverse();
    if(adds.length === 0){
      history.innerHTML = '<div style="color:var(--muted);font-size:.6rem">No AI improvements yet</div>';
    } else {
      history.innerHTML = adds.map(a => {
        // Highlight local-fallback entries so the user immediately sees AI was
        // bypassed. Title attribute exposes the real error/explanation.
        const isFallback = (a.source || '').includes('fallback');
        const dotColor   = isFallback ? '#f59e0b' : '#86efac';
        const title      = _htmlEscape(a.explanation || a.text || '').slice(0, 500);
        return `<div title="${title}" style="font-size:.6rem;color:var(--text2);padding:3px 0;border-top:1px dashed var(--border);cursor:help">
           <span style="display:inline-block;width:6px;height:6px;border-radius:50%;background:${dotColor};margin-right:5px;vertical-align:middle"></span>
           <span style="color:var(--muted)">${_htmlEscape(a.source || '')}:</span> ${_htmlEscape(a.text || '').slice(0, 140)}
         </div>`;
      }).join('');
    }
  }
}

window.promptSetOriginal      = promptSetOriginal;
window.promptAppend           = promptAppend;
window.promptMemoryAppend     = promptMemoryAppend;
window.promptResetToOriginal  = promptResetToOriginal;
window.promptFullReset        = promptFullReset;
window.promptUndoLastAI       = promptUndoLastAI;
window.applyAIToPrompt        = applyAIToPrompt;
window.promptSetAsNewOriginal = promptSetAsNewOriginal;
window.refreshPromptMemoryUI  = refreshPromptMemoryUI;

function selectCustomPrompt(text){
  state.promptText = text;
  state.promptAngle = '';
  // Also seed prompt memory if it's empty — first selected prompt becomes the
  // working baseline so Apply AI has something to build on.
  if(!state.originalPrompt){
    state.originalPrompt = text;
    state.currentPrompt  = text;
    state.aiAdditions    = [];
    state.promptVersion  = 1;
  } else {
    state.currentPrompt  = text;
    state.promptVersion  = (state.promptVersion || 0) + 1;
  }
  state.selectedStoryPrompt = text;
  refreshPromptMemoryUI();
  document.getElementById('promptDisplay').style.display='flex';
  document.getElementById('promptMain').textContent = text;
  document.getElementById('promptAngle').textContent = '';
  document.getElementById('selectedPromptBadge').textContent = ' — '+text.slice(0,50)+(text.length>50?'...':'');
  showToast('Prompt selected','success');
}

// Render-time cache of the four fresh prompts. The cards index into this
// array via data-idx — the previous code embedded JSON.stringify(text) into
// onclick="..." attributes, but JSON.stringify wraps its output in DOUBLE
// QUOTES which immediately break out of the (also-double-quoted) HTML attr.
// This is why "AI generated story prompts are almost perfect but pressing
// them does not work" — the cards rendered fine but the click was malformed.
let _freshPromptsCache = [];

// HTML-escape so prompt text (which often contains apostrophes, em-dashes,
// ellipsis) renders cleanly inside <div> bodies.
function _htmlEscape(s){
  return String(s ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

async function generateFreshPrompts(){
  // Cancel any in-flight request so clicking a new sign always gets fresh results
  if(_freshAbort){ _freshAbort.abort(); }
  _freshAbort = new AbortController();
  const signal = _freshAbort.signal;

  const btn = document.getElementById('freshPromptsBtn');
  if(btn){ btn.disabled=true; btn.textContent='✨ Thinking...'; }
  const freshArea = document.getElementById('freshPromptsArea');
  const freshList = document.getElementById('freshPromptList');

  // Show loading state immediately
  freshArea.style.display = 'block';
  document.getElementById('promptList').style.display = 'none';
  document.getElementById('promptListSaved').style.display = 'none';
  freshList.innerHTML = '<li style="list-style:none;font-size:.75rem;color:var(--muted);padding:8px 0;text-align:center">✨ Generating 4 fresh prompts…</li>';

  try{
    const favTexts = savedFavPrompts.map(p=>p.text);
    const exclude = [...new Set([..._lastFreshPrompts, ...favTexts])].slice(0, 30);

    const r = await fetch(`${API_BASE}/api/trend-vault/generate-prompts`,{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      signal,
      body: JSON.stringify({
        trendVaultSign: state.sign||'All',
        category:   state.category||'general',
        count: 4,
        exclude,
      })
    });
    const data = await r.json();
    if(!data.ok) throw new Error(data.error||'Failed');

    const prompts = (data.prompts || []).slice(0, 4);
    _lastFreshPrompts = prompts;
    _freshPromptsCache = prompts;  // cache by index for the click delegation

    freshList.innerHTML = prompts.map((txt, i) => {
      const isFav = savedFavPrompts.find(p => p.text === txt);
      const isSelected = state.selectedFreshPromptIdx === i;
      return `
        <li class="fresh-prompt-card" data-idx="${i}"
            style="list-style:none;padding:8px 10px;background:${isSelected?'rgba(124,58,237,.18)':'var(--surface)'};border:1px solid ${isSelected?'var(--purple2)':'rgba(124,58,237,.2)'};border-radius:9px;margin-bottom:5px;display:flex;flex-direction:column;gap:6px">
          <div style="display:flex;align-items:flex-start;gap:8px">
            <div style="flex:1;font-size:.77rem;color:var(--text2);cursor:pointer" data-action="select" title="Click to select this prompt">${_htmlEscape(txt)}</div>
            <button data-action="favorite" title="Save to favorites" style="background:none;border:none;cursor:pointer;font-size:.9rem;flex-shrink:0;opacity:.85">${isFav?'❤️':'🤍'}</button>
          </div>
          <div style="display:flex;gap:5px;flex-wrap:wrap">
            <button data-action="use"    title="Use this prompt for script generation" style="flex:1;min-width:90px;background:rgba(34,197,94,.12);border:1px solid rgba(34,197,94,.35);color:#86efac;border-radius:6px;padding:4px 8px;font-size:.62rem;font-weight:700;cursor:pointer;font-family:inherit">✓ Use Prompt</button>
            <button data-action="append" title="Add this prompt to your current working prompt" style="flex:1;min-width:90px;background:rgba(59,130,246,.12);border:1px solid rgba(59,130,246,.35);color:#93c5fd;border-radius:6px;padding:4px 8px;font-size:.62rem;font-weight:700;cursor:pointer;font-family:inherit">+ Add to Mine</button>
          </div>
        </li>`;
    }).join('');

    if(data.warning) showToast(data.warning,'info');
    else showToast('✨ 4 fresh prompts ready! Click one to select','success');
  }catch(e){
    if(e.name==='AbortError') return; // silently cancelled by newer request
    freshList.innerHTML = `<li style="list-style:none;font-size:.74rem;color:#f87171;padding:8px 0;text-align:center">⚠ ${_htmlEscape(e.message)}</li>`;
    showToast(e.message||'Could not generate prompts','error');
  }finally{
    _freshAbort = null;
    if(btn){ btn.disabled=false; btn.textContent='🔄 FRESH'; }
  }
}

// ── Event delegation for fresh prompt cards (Phase 4 fix) ───────────────────
// One listener attached once, reads data-idx + data-action from the clicked
// element. This is immune to apostrophes / quotes / dashes in prompt text
// because we never embed the text into HTML attributes.
document.addEventListener('click', (ev) => {
  const card = ev.target.closest?.('.fresh-prompt-card');
  if(!card) return;
  const idx = parseInt(card.dataset.idx, 10);
  if(isNaN(idx)) return;
  const txt = _freshPromptsCache[idx];
  if(!txt) return;
  const action = ev.target.dataset?.action || 'select';
  ev.stopPropagation();
  if(action === 'favorite'){
    toggleFavoritePrompt(9000 + idx, txt, ev);
    return;
  }
  if(action === 'append'){
    // Add to working prompt without replacing it
    promptMemoryAppend(txt, 'clicked-suggestion');
    showToast('Prompt added to your working prompt', 'info');
    state.selectedFreshPromptIdx = idx;
    _rerenderFreshPromptHighlight();
    return;
  }
  if(action === 'use'){
    // Set as the active prompt that script-gen will read
    selectCustomPrompt(txt);
    state.selectedFreshPromptIdx = idx;
    state.selectedStoryPrompt    = txt;
    _rerenderFreshPromptHighlight();
    markDirty('script');
    showToast('Prompt selected — Generate Script will use it', 'success');
    return;
  }
  // default 'select' (clicked the text body)
  selectCustomPrompt(txt);
  state.selectedFreshPromptIdx = idx;
  state.selectedStoryPrompt    = txt;
  _rerenderFreshPromptHighlight();
  markDirty('script');
});

function _rerenderFreshPromptHighlight(){
  document.querySelectorAll('.fresh-prompt-card').forEach(el => {
    const i = parseInt(el.dataset.idx, 10);
    const sel = state.selectedFreshPromptIdx === i;
    el.style.background   = sel ? 'rgba(124,58,237,.18)' : 'var(--surface)';
    el.style.borderColor  = sel ? 'var(--purple2)'       : 'rgba(124,58,237,.2)';
  });
}

// Patch filterPromptsBySign to add heart buttons
