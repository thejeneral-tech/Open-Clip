function setGrainType(type, btn){
  state.grainType = type;
  document.querySelectorAll('.effect-chip').forEach(c=>c.classList.toggle('active',c.dataset.grain===type));
  updatePreview();
}

function updateGrain(el){
  state.grainIntensity = +el.value;
  document.getElementById('grainVal').textContent = el.value+'%';
  updateSliderTrack(el.id);
  updatePreview();
}

function setColorGrade(grade, btn){
  pushUndo();
  state.colorGrade = grade;
  document.querySelectorAll('.grade-chip').forEach(c=>c.classList.toggle('active',c.dataset.grade===grade));
  updatePreview();
}

// Export current project as a CapCut draft. Calls the local CapCutAPI Python
// server. Does NOT replace Remotion render — both buttons coexist.
async function exportToCapCut(){
  if(!state.script.length){ showToast('Generate a script first','error'); return; }
  const btn = document.getElementById('capcutExportBtn');
  if(btn){ btn.disabled = true; btn.innerHTML = '📤 Exporting...'; }
  try {
    const settings = {
      trendVaultSign:  state.sign,
      fontSize:    state.fontSize,
      textColor:   state.textColor,
      colorGrade:  state.colorGrade,
      backgroundVideo: state.background || 'none',
    };
    // Build a publicly-fetchable URL for any chosen background / current voice
    // (CapCutAPI fetches them itself, so they need to be HTTP-reachable).
    const origin = window.location.origin || 'http://localhost:3001';
    const backgroundUrl = state.background ? `${origin}/backgrounds/${state.background}` : '';
    // Voice: best-effort. CapCutAPI fetches by URL, so we point at the most
    // recent generated narration if one exists in public/custom-audio/.
    let voiceUrl = '';
    if(state.customAudio){
      voiceUrl = `${origin}/custom-audio/${state.customAudio}`;
    }
    const r = await fetch(`${API_BASE}/api/trend-vault/export-capcut`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings, scriptLines: state.script, voiceUrl, backgroundUrl }),
    });
    const data = await r.json();
    if(!r.ok || !data.ok){
      throw new Error(data.error || `HTTP ${r.status}`);
    }
    showToast(`✓ CapCut draft created: ${data.draftId}`, 'success');
    // Brief modal-style confirmation with full instructions
    alert(`📤 CapCut draft created!\n\nDraft ID: ${data.draftId}\n\n${data.message}`);
  } catch(e){
    console.error('[CapCut]', e);
    showToast('CapCut export failed: ' + e.message, 'error');
  } finally {
    if(btn){ btn.disabled = false; btn.innerHTML = '📤 CapCut'; }
  }
}

function setVoiceEngine(engine, btn){
  // Fish Speech bridge removed — silently redirect to auto so restored drafts don't break
  if(engine === 'fish-speech') engine = 'auto';
  state.voiceEngine = engine;
  state.activeTimelineProvider = null;  // forget previous promotion when engine changes
  markDirty('voice');
  document.querySelectorAll('[data-engine]').forEach(b => b.classList.toggle('active', b.dataset.engine === engine));
  const labels = {
    auto:         'Auto (local first, Edge fallback)',
    local:        'Local Only — needs Kokoro/Coqui running',
    edge:         'Microsoft Edge TTS (cloud)',
    'fish-speech':'Fish Speech — local AI voice',
    elevenlabs:   'ElevenLabs — premium AI voice with word-level timestamps',
  };
  showToast(`🎙 Voice engine: ${labels[engine] || engine}`, 'info');

  // Show Fish Speech panel / ElevenLabs panel; hide standard preset grid as needed
  const fishPanel  = document.getElementById('fishSpeechPanel');
  const elPanel    = document.getElementById('elevenLabsPanel');
  const presetGrid = document.getElementById('presetGrid');
  const voiceSliders = document.getElementById('voiceSliders');
  const isFish = engine === 'fish-speech';
  const isEL   = engine === 'elevenlabs';
  if(fishPanel)    fishPanel.style.display    = isFish ? 'flex' : 'none';
  if(elPanel)      elPanel.style.display      = isEL   ? 'flex' : 'none';
  if(presetGrid)   presetGrid.style.display   = (isFish || isEL) ? 'none' : '';
  if(voiceSliders) voiceSliders.style.display = (isFish || isEL) ? 'none' : '';

  if(isFish){
    checkFishSpeechStatus();
    // Show history panel if there's any history
    fetch(`${API_BASE}/api/fish-speech/history`).then(r=>r.json()).then(d=>{
      const histPanel = document.getElementById('fishHistoryPanel');
      if(histPanel && (d.history||[]).length > 0) histPanel.style.display = 'flex';
    }).catch(()=>{});
  }
  else if(isEL) refreshElevenLabs();
  else refreshEngineStatus();
}

// ── ElevenLabs panel handlers ───────────────────────────────────────────────
async function refreshElevenLabs(){
  const dot = document.getElementById('elStatusDot');
  const txt = document.getElementById('elStatusText');
  const sel = document.getElementById('elVoiceSelect');
  const use = document.getElementById('elUsageText');
  if(!sel) return;
  try{
    const [vR, pR] = await Promise.all([
      fetch(`${API_BASE}/api/elevenlabs/voices`),
      fetch(`${API_BASE}/api/elevenlabs/presets`),
    ]);
    const v = await vR.json();
    const p = await pR.json();
    if(!v.ok){
      if(dot) dot.style.background = '#f87171';
      if(txt) txt.textContent = v.error || 'unavailable';
      sel.innerHTML = '<option value="">(unavailable)</option>';
      return;
    }
    if(dot) dot.style.background = '#34d399';
    if(txt) txt.textContent = `${v.voices.length} voices · ready`;

    // ── Phase 5: TikTok Voices group ───────────────────────────────────────
    // ElevenLabs ships five well-known pre-made voices that work perfectly
    // for TikTok-style narration. We pin them at the top in their own
    // optgroup so users can pick them with one click. Voice IDs are the
    // public, stable, pre-made IDs from ElevenLabs (same for every account).
    const TIKTOK_VOICES = [
      { name: 'Adam',    voiceId: 'pNInz6obpgDQGcFmaJgB' },
      { name: 'Antoni',  voiceId: 'ErXwobaYiN019PkySvjV' },
      { name: 'Josh',    voiceId: 'TxGEqnHWrfWFTfGW9XjX' },
      { name: 'Arnold',  voiceId: 'VR6AewLTigWG4xSOukaG' },
      { name: 'Rachel',  voiceId: '21m00Tcm4TlvDq8ikWAM' },
    ];
    // If the user's account exposes one of these by a different ID, prefer
    // the account's live ID (so the voice always works). Match by name.
    const liveByName = new Map(v.voices.map(o => [String(o.name).toLowerCase(), o]));
    const tiktokOptions = TIKTOK_VOICES.map(t => {
      const live = liveByName.get(t.name.toLowerCase());
      const id   = live?.voice_id || t.voiceId;
      const tag  = live ? '' : ' · pre-made';
      return `<option value="${id}" data-tiktok="1">${t.name}${tag}</option>`;
    }).join('');

    // Remove TikTok voices from the "all" group so they don't appear twice
    const tiktokIds = new Set(TIKTOK_VOICES.map(t =>
      liveByName.get(t.name.toLowerCase())?.voice_id || t.voiceId
    ));
    const otherOptions = v.voices.filter(o => !tiktokIds.has(o.voice_id)).map(o =>
      `<option value="${o.voice_id}">${o.name}${o.category ? ' · ' + o.category : ''}</option>`
    ).join('');

    sel.innerHTML =
      '<optgroup label="🎵 TikTok Voices">'  + tiktokOptions + '</optgroup>' +
      '<optgroup label="All ElevenLabs Voices">' + otherOptions + '</optgroup>';

    if(!state.elVoice) state.elVoice = {};
    if(!state.elVoice.voiceId){
      // Default to Adam if the user hasn't chosen anything yet
      const adamId = liveByName.get('adam')?.voice_id || 'pNInz6obpgDQGcFmaJgB';
      state.elVoice.voiceId = adamId;
      sel.value = adamId;
    } else {
      sel.value = state.elVoice.voiceId;
    }
    if(use) use.textContent = `${p.usage?.count || 0} / ${p.usage?.budget || 0} renders used`;
    // Render saved presets
    const list = document.getElementById('elPresetList');
    if(list){
      list.innerHTML = (p.presets || []).map(ps =>
        `<div style="display:flex;gap:6px;align-items:center;padding:4px 6px;background:var(--surface2);border-radius:6px">
           <button onclick="elApplyPreset('${ps.id}')" class="preview-nav-btn" style="padding:3px 8px;font-size:.6rem">${ps.name}</button>
           <span style="flex:1;color:var(--muted)">voice:${ps.voiceId.slice(0,8)}…  stab:${(ps.stability??0.5).toFixed(2)}  sim:${(ps.similarity??0.75).toFixed(2)}</span>
           <button onclick="elDeletePreset('${ps.id}')" class="preview-nav-btn" style="padding:3px 6px;font-size:.6rem;color:#f87171">✕</button>
         </div>`
      ).join('') || '<span style="color:var(--muted);font-size:.6rem">no saved presets yet</span>';
    }
  }catch(e){
    if(dot) dot.style.background = '#f87171';
    if(txt) txt.textContent = e.message;
  }
}

// Lightweight usage-only refresh — does NOT re-fetch the voice list. Called
// after every render or preview that actually used ElevenLabs so the budget
// number updates without a full page refresh.
async function refreshElevenLabsUsageOnly(){
  const use = document.getElementById('elUsageText');
  if(!use) return;
  const previous = use.textContent;
  use.textContent = '⏳ updating usage…';
  try{
    const r = await fetch(`${API_BASE}/api/elevenlabs/presets`, { cache: 'no-store' });
    if(!r.ok) throw new Error(`HTTP ${r.status}`);
    const p = await r.json();
    use.textContent = `${p.usage?.count || 0} / ${p.usage?.budget || 0} renders used`;
    use.style.color = '';
  }catch(e){
    use.textContent = previous || '(usage unavailable)';
    use.style.color = '#f87171';
    use.title = 'Usage refresh failed: ' + (e?.message || e);
  }
}

window.refreshElevenLabsUsageOnly = refreshElevenLabsUsageOnly;

async function elPreviewVoice(){
  if(!state.elVoice?.voiceId){ showToast('Pick an ElevenLabs voice first','error'); return; }
  if(!state.script?.length){ showToast('Generate a script first','info'); return; }
  await generateVoicePreview();
}

async function elSaveAsPreset(){
  if(!state.elVoice?.voiceId){ showToast('Pick an ElevenLabs voice first','error'); return; }
  const sel = document.getElementById('elVoiceSelect');
  const voiceName = sel?.options[sel.selectedIndex]?.text || 'Voice';
  const name = prompt('Preset name:', voiceName.split(' · ')[0]);
  if(!name) return;
  const r = await fetch(`${API_BASE}/api/elevenlabs/presets`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({
      name, voiceId: state.elVoice.voiceId,
      stability:  state.elVoice.stability  ?? 0.5,
      similarity: state.elVoice.similarity ?? 0.75,
      style:      state.elVoice.style      ?? 0.0,
      speakerBoost: state.elVoice.speakerBoost ?? true,
    }),
  });
  const d = await r.json();
  if(d.ok){ showToast('Preset saved: ' + name, 'success'); refreshElevenLabs(); }
  else    { showToast('Save failed: ' + d.error, 'error'); }
}

async function elApplyPreset(id){
  const r = await fetch(`${API_BASE}/api/elevenlabs/presets`);
  const d = await r.json();
  const ps = (d.presets || []).find(x => x.id === id);
  if(!ps) return;
  if(!state.elVoice) state.elVoice = {};
  state.elVoice.voiceId = ps.voiceId;
  state.elVoice.stability  = ps.stability;
  state.elVoice.similarity = ps.similarity;
  state.elVoice.style      = ps.style;
  state.elVoice.speakerBoost = ps.speakerBoost;
  const sel = document.getElementById('elVoiceSelect');
  if(sel) sel.value = ps.voiceId;
  showToast('Applied: ' + ps.name, 'info');
}

async function elDeletePreset(id){
  if(!confirm('Delete this preset?')) return;
  await fetch(`${API_BASE}/api/elevenlabs/presets/${id}`, { method:'DELETE' });
  refreshElevenLabs();
}

async function refreshEngineStatus(){
  const line = document.getElementById('engineStatusLine');
  if(!line) return;
  try {
    const r = await fetch(`${API_BASE}/api/trend-vault/engine-status`);
    if(!r.ok) return;
    const d = await r.json();
    const localOk     = d.localTts?.ok;
    const localEngine = d.localTts?.engine || 'kokoro';
    const elOk        = d.elevenlabs?.configured;
    const fishOk      = d.fishSpeech?.bridgeOk;
    const fishApiOk   = d.fishSpeech?.apiOk;
    const dot = (ok) => ok ? '<span style="color:#86efac">●</span>' : '<span style="color:#fca5a5">●</span>';
    const fishLabel = fishOk
      ? (fishApiOk ? 'bridge + model ready' : 'bridge up, model loading…')
      : 'not running';
    line.innerHTML =
      `${dot(true)} Edge: ready &nbsp;|&nbsp; ` +
      `${dot(localOk)} Local: ${localOk ? localEngine : 'off'} &nbsp;|&nbsp; ` +
      `${dot(fishOk)} Fish Speech: ${fishLabel} &nbsp;|&nbsp; ` +
      `${dot(elOk)} ElevenLabs: ${elOk ? 'key set' : 'no key'}`;
  } catch { /* server might be starting */ }
}

// ── Fish Speech — bridge removed, stubs prevent dead 404 calls ───────────────

async function checkFishSpeechStatus(){
  // Bridge removed — no-op so callers don't fire 404s against the server
  const dot  = document.getElementById('fishStatusDot');
  const text = document.getElementById('fishStatusText');
  if(dot)  dot.textContent  = '⚫';
  if(text) text.textContent = 'Fish Speech not available (bridge removed).';
  state.fishState = 'bridge_not_running';
  return;
  try {
    // Phase 4: 10s client timeout because server probe is now 8s
    const r = await fetch(`${API_BASE}/api/fish-speech/status`, { signal: AbortSignal.timeout(10_000) });
    const d = await r.json();
    state.fishHealth = d;  // cached for other UI

    // Use the server-classified state (cuda_crashed / generating / healthy /
    // fish_api_down / bridge_timeout / bridge_not_running / bridge_returned_error)
    const fishState = d.state || (d.available ? 'healthy' : 'bridge_not_running');
    state.fishState = fishState;

    if(d.enabled === false){
      if(dot)  dot.textContent  = '⚫';
      if(text){ text.style.color='var(--muted)'; text.textContent='Fish Speech disabled — set FISH_SPEECH_ENABLED=true in .env'; }
    } else if(fishState === 'gpu_oom_restart_required'){
      // Most severe — GPU is broken until Fish API is restarted
      if(dot)  dot.textContent  = '⛔';
      if(text){ text.style.color='#f87171'; text.textContent='Fish Speech ran out of GPU memory. Restart Fish Speech before using it again. Then press ⟲ MARK RESTARTED.'; }
    } else if(fishState === 'test_generation_timeout'){
      if(dot)  dot.textContent  = '⛔';
      if(text){ text.style.color='#f87171'; text.textContent='Test generation timed out (Fish Speech is hung or OOM). Restart the Fish Speech API window, then press ⟲ MARK RESTARTED.'; }
    } else if(fishState === 'cuda_crashed'){
      if(dot)  dot.textContent  = '⛔';
      if(text){ text.style.color='#f87171'; text.textContent=`RESTART REQUIRED — ${d.unhealthy_reason}. Restart Fish Speech API window, then press ⟲ MARK RESTARTED.`; }
    } else if(fishState === 'generating'){
      if(dot)  dot.textContent  = '🟡';
      if(text){ text.style.color='#fcd34d'; text.textContent='Generating — Fish Speech is busy with another request.'; }
    } else if(fishState === 'healthy'){
      if(dot)  dot.textContent  = '🟢';
      if(text){ text.style.color='#86efac'; text.textContent=`Healthy (real generation verified) · ${d.voices_count || 6} voices`; }
    } else if(fishState === 'tts_generation_unverified'){
      if(dot)  dot.textContent  = '🟡';
      if(text){ text.style.color='#fcd34d'; text.textContent='Server alive, but TTS not yet verified — press 🧪 TEST to confirm Fish can actually generate.'; }
    } else if(fishState === 'fish_api_down'){
      if(dot)  dot.textContent  = '🟡';
      if(text){ text.style.color='#fcd34d'; text.textContent='Bridge running — Fish Speech API not reachable. Start: start_fish_speech_api.bat'; }
    } else if(fishState === 'bridge_timeout'){
      if(dot)  dot.textContent  = '⏳';
      if(text){ text.style.color='#fcd34d'; text.textContent = d.error || 'Bridge starting slowly — try again in a few seconds'; }
    } else if(fishState === 'bridge_returned_error'){
      if(dot)  dot.textContent  = '🔴';
      if(text){ text.style.color='#fca5a5'; text.textContent = d.error || 'Bridge returned an HTTP error'; }
    } else {
      if(dot)  dot.textContent  = '🔴';
      if(text){ text.style.color='#fca5a5'; text.textContent = d.error || 'Bridge offline — run START_TREND_VAULT_DAILY.bat'; }
    }
  } catch (e) {
    if(dot)  dot.textContent  = '🔴';
    if(text){ text.style.color='#fca5a5'; text.textContent = 'Status check failed: ' + (e?.message || e); }
  }
}

// Real generation test — proxies bridge /test-generation. Confirms Fish Speech
// can actually synthesize, not just that /v1/health returns 200. The bridge
// caps this at 30s with max_new_tokens=64 so a hallucinating model can't burn
// 25min and exhaust VRAM.
async function testFishVoice(){
  const result = document.getElementById('fishTestResult');
  // If bridge already says GPU is broken, do NOT pile on — that's exactly
  // what triggered the OOM in the first place.
  const fs = state.fishState;
  if(fs === 'gpu_oom_restart_required' || fs === 'cuda_crashed' || fs === 'test_generation_timeout'){
    if(result){ result.style.color='#f87171'; result.textContent = '✗ blocked — Fish Speech is GPU-broken. Restart Fish Speech API, then press ⟲ MARK RESTARTED.'; }
    showToast('Fish Speech needs a restart before testing again', 'error');
    return;
  }
  if(result){ result.style.color='var(--muted)'; result.textContent='⏳ generating tiny "Ready." clip (≤30s hard timeout)…'; }
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/test`, { method:'POST', signal: AbortSignal.timeout(75_000) });
    const d = await r.json();
    if(d.ok){
      if(result){ result.style.color='#86efac'; result.textContent = `✓ generated ${(d.audio_bytes/1024).toFixed(0)}KB in ${d.elapsed_s}s — Fish Speech is healthy`; }
      showToast('Fish Speech test passed', 'success');
    } else {
      if(result){ result.style.color='#f87171'; result.textContent = `✗ ${d.error || 'test failed'}`; }
      showToast('Fish Speech test failed: ' + (d.error || 'unknown'), 'error');
    }
    checkFishSpeechStatus();
  }catch(e){
    if(result){ result.style.color='#f87171'; result.textContent = '✗ ' + (e?.message || e); }
    showToast('Fish Speech test errored: ' + (e?.message||e), 'error');
  }
}

// Tell the bridge to clear its CUDA-unhealthy flag (after the user restarts
// the Fish Speech API window). Follows up with a status check.
async function fishMarkRestarted(){
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/reset-health`, { method:'POST', signal: AbortSignal.timeout(5000) });
    const d = await r.json();
    if(d.ok){
      showToast('Bridge health flag cleared — re-checking…', 'info');
      // Also clear any stale Fish preview audio that was generated before the crash
      if(state.lastResolvedEngine && /fish/i.test(state.lastResolvedEngine)){
        state.previewAudioUrl = null;
        state.previewCaptions = null;
        state.previewSyncedHash = null;
        markDirty('voice');
        const status = document.getElementById('voicePreviewStatus');
        if(status){ status.textContent='cleared after Fish restart — regenerate to resync'; status.style.color='var(--muted)'; }
      }
    } else {
      showToast('Bridge could not clear the flag: ' + (d.error||'unknown'), 'error');
    }
    checkFishSpeechStatus();
  }catch(e){
    showToast('Bridge unreachable: ' + (e?.message||e), 'error');
  }
}
window.testFishVoice    = testFishVoice;
window.fishMarkRestarted = fishMarkRestarted;

// ── Fish Speech generation — job/poll pattern (replaces synchronous fetch) ──
// The OLD version did one long fetch with a 180s wall. Long downloads, long
// generations, and slow GPU warmups all looked like "bridge unreachable". The
// new flow submits a background job, polls /jobs/:id every ~3s, and renders
// real status (queued → loading_model → generating → complete). The HTTP
// request itself never blocks for more than ~10s.
let fishGenController = null;   // kept for the abort path
let fishPollHandle    = null;   // setTimeout handle for the active poll

function _fishStatusLabel(s, message){
  switch(s){
    case 'queued':        return 'Queued — waiting for worker';
    case 'downloading':   return 'Fish Speech model is downloading. Please wait.';
    case 'loading_model': return 'Loading Fish Speech model into GPU…';
    case 'generating':    return message || 'Generating audio…';
    case 'complete':      return 'Audio ready';
    case 'failed':        return message || 'Generation failed';
    default:              return message || s || 'Working…';
  }
}

async function fishSpeechGenerate(customText){
  const text = customText
    || state.script[state.voicePreviewLine % Math.max(1, state.script.length)]?.text
    || 'The stars have spoken your destiny.';

  // Cancel any prior poll loop before starting a new one
  if(fishGenController) fishGenController.abort();
  fishGenController = new AbortController();
  if(fishPollHandle){ clearTimeout(fishPollHandle); fishPollHandle = null; }

  const genBtn    = document.getElementById('fishGenerateBtn');
  const prvBtn    = document.getElementById('fishPreviewBtn');
  const spinner   = document.getElementById('fishSpinner');
  const statusEl  = document.getElementById('fishGenStatus');
  const audioWrap = document.getElementById('fishAudioWrap');
  const audioEl   = document.getElementById('fishAudio');

  if(genBtn)  { genBtn.disabled = true;  genBtn.textContent  = '⏳ Submitting…'; }
  if(prvBtn)  { prvBtn.disabled = true; }
  if(spinner) spinner.style.display = 'block';
  if(statusEl) statusEl.textContent = 'Submitting job…';

  if(audioEl){ try{ audioEl.pause(); audioEl.currentTime=0; }catch{} audioEl.removeAttribute('src'); audioEl.load(); }

  const voice   = document.getElementById('fishVoiceSelect')?.value || state.fishVoice || 'dark_narrator';
  const speed   = state.fishSpeed   ?? 1.0;
  const temp    = state.fishTemp    ?? 0.70;
  const pitch   = state.fishPitch   ?? 0;
  const normalize = state.fishNormalize !== false;
  const isPreview = (text || '').length < 280;

  // Helper to fully reset button + spinner state. Called from every exit path.
  function _done(){
    if(genBtn)  { genBtn.disabled = false; genBtn.textContent  = '✦ GENERATE'; }
    if(prvBtn)  { prvBtn.disabled = false; }
    if(spinner) spinner.style.display = 'none';
    if(fishPollHandle){ clearTimeout(fishPollHandle); fishPollHandle = null; }
  }

  // ── Pre-flight: check if these settings have a known-bad history ──────────
  // Non-blocking: just show a warning banner in the Fish panel so the user
  // knows before committing to a GPU generation. Don't abort automatically —
  // the user may have already fixed whatever caused the prior failure.
  try{
    const chk = await fetch(`${API_BASE}/api/fish-speech/check-settings`,{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ voiceId: voice, speed, temperature: temp, pitch }),
      signal: AbortSignal.timeout(3000),
    });
    if(chk.ok){
      const chkData = await chk.json();
      const warnings = chkData.warnings || [];
      const blockWarning = warnings.find(w => w.severity === 'block');
      const warnWarning  = warnings.find(w => w.severity === 'warn');
      const fishGenStatus = document.getElementById('fishGenStatus');
      if(blockWarning){
        // Severity=block means these exact settings have failed 2+ times: ask user
        if(fishGenStatus) fishGenStatus.textContent = `⚠️ ${blockWarning.reason}`;
        const proceed = window.confirm(`⚠ Known-bad settings detected:\n\n${blockWarning.reason}\n\nThese exact settings have failed multiple times recently.\n\nProceed anyway? (or Cancel to adjust settings first)`);
        if(!proceed){ _done(); return; }
      } else if(warnWarning){
        if(fishGenStatus) fishGenStatus.textContent = `⚠ ${warnWarning.reason} — proceeding…`;
        if(chkData.hasSafeAlternative && chkData.best){
          showToast(`⚠ These settings have failed before. Use "🏆 Use Best Settings" for safer options.`, 'info');
        }
      }
    }
  }catch{ /* check-settings is advisory only — never block on its failure */ }

  let jobId = null;
  try {
    // STEP 1 — enqueue. Bridge replies immediately. 15s is plenty.
    const r = await fetch(`${API_BASE}/api/fish-speech/jobs`, {
      method:  'POST',
      headers: { 'Content-Type': 'application/json', 'Cache-Control': 'no-cache' },
      signal:  fishGenController.signal,
      body: JSON.stringify({ text, voice, speed, temperature: temp, pitch, normalize, is_preview: isPreview }),
    });
    const submit = await r.json().catch(()=>({}));
    if(!r.ok || !submit.jobId){
      throw new Error(submit.error || `Bridge enqueue failed (HTTP ${r.status})`);
    }
    jobId = submit.jobId;
    state.lastFishJobId = jobId;
    if(statusEl) statusEl.textContent = `Queued · job ${jobId.slice(0,6)}…`;
    if(genBtn)   genBtn.textContent = '⏳ Generating…';
  } catch(e){
    if(e.name === 'AbortError'){ _done(); return; }
    const msg = e.message || 'Unknown error';
    if(statusEl) statusEl.textContent = `❌ ${msg}`;
    showToast(`Fish Speech error: ${msg}`, 'error');
    _done();
    return;
  }

  // STEP 2 — poll. Never give up at 180s; keep polling until the bridge says
  // complete or failed. The poll request itself is fast (~ms).
  const POLL_MS_BASE = 3000;
  const POLL_MS_MAX  = 5000;
  const HARD_WALL_MS = 30 * 60 * 1000;   // 30min absolute ceiling, just in case
  const started = Date.now();
  let consecutiveErrors = 0;

  async function pollOnce(){
    if(fishGenController?.signal?.aborted){ _done(); return; }
    if(Date.now() - started > HARD_WALL_MS){
      if(statusEl) statusEl.textContent = '❌ Hard ceiling reached (30min). Job may still be running on bridge.';
      showToast('Fish Speech polling stopped after 30 minutes — check bridge status.', 'error');
      _done();
      return;
    }
    try {
      const r = await fetch(`${API_BASE}/api/fish-speech/jobs/${encodeURIComponent(jobId)}`, {
        signal: fishGenController.signal, cache: 'no-cache',
      });
      const j = await r.json().catch(()=>({}));
      // Bridge unreachable: ONLY treat HTTP failure as that. Job state alone
      // (queued/generating/downloading) is NEVER reported as "unreachable".
      if(!r.ok && r.status === 502){
        consecutiveErrors++;
        if(statusEl) statusEl.textContent = `⚠ Bridge poll error — retrying (${consecutiveErrors})…`;
        if(consecutiveErrors >= 5){
          throw new Error(j.error || 'Bridge unreachable for 5 polls in a row');
        }
      } else {
        consecutiveErrors = 0;
      }

      const elapsed = Math.round((Date.now() - started) / 1000);
      const chunkInfo = (j.chunk_done && j.chunks) ? ` (chunk ${j.chunk_done}/${j.chunks})` : '';
      if(statusEl && j.status){
        statusEl.textContent = `⏳ ${_fishStatusLabel(j.status, j.message)}${chunkInfo} · ${elapsed}s`;
      }

      if(j.status === 'complete'){
        // STEP 3 — audio is on disk, served by /outputs-voices.
        const audioUrl = j.audio_url || (j.audio_path
          ? `/outputs-voices/${(j.audio_path).split(/[\\/]/).pop()}`
          : null);
        if(!audioUrl) throw new Error('Job complete but no audio URL returned');
        const fullUrl = audioUrl.startsWith('http') ? audioUrl : (API_BASE + audioUrl);
        if(audioEl){
          if(audioEl.dataset.objectUrl){ try{ URL.revokeObjectURL(audioEl.dataset.objectUrl); }catch{} delete audioEl.dataset.objectUrl; }
          audioEl.src = fullUrl;
          audioEl.load();
        }
        state.lastFishHistoryId = j.history_id || null;
        state.lastFishRating    = null;
        state.lastFishAudioUrl  = audioUrl;
        // ── Build Fish-specific previewTiming from actual audio duration ──
        // This is critical: render and preview must use Fish audio duration,
        // NOT leftover ElevenLabs timing from a prior generation.
        const fishDurSec = j.duration_sec || null;
        if(fishDurSec && fishDurSec > 0){
          const wordCount = (text||'').split(/\S+/).length - 1;
          const wps = wordCount > 0 ? +(wordCount / fishDurSec).toFixed(3) : null;
          state.previewAudioUrl         = audioUrl;
          state.previewAudioDurationSec = fishDurSec;
          state.lastResolvedEngine      = 'fish-speech';
          state.activeTimelineProvider  = 'fish-speech';
          // Build simplified timing so the render pipeline can validate
          state.previewTiming = {
            mode: 'autoMatchVoice',
            targetDurationSeconds: null,
            actualAudioDurationSeconds: fishDurSec,
            finalVideoDurationSeconds: fishDurSec,
            provider: 'fish-speech',
            voiceId: voice,
            audioUrl,
            audioFile: audioUrl.split('/').pop() || '',
            audioPath: '',
            source: 'fish-audio-duration',
            wordsPerSecond: wps,
            createdAt: new Date().toISOString(),
            lines: [],
            totalWords: wordCount,
          };
          refreshDurationBadge && refreshDurationBadge();
          refreshRenderSyncPanel && refreshRenderSyncPanel();
        }
        if(audioWrap) audioWrap.style.display = 'block';
        try{ await audioEl?.play(); }catch{ /* user-gesture required */ }
        document.querySelectorAll('.fish-rate-btn').forEach(b => b.classList.remove('active'));
        const rateStatus = document.getElementById('fishRateStatus');
        if(rateStatus) rateStatus.textContent = '';
        const histPanel = document.getElementById('fishHistoryPanel');
        if(histPanel) histPanel.style.display = 'flex';
        const t = j.generation_time ? ` (${j.generation_time}s)` : '';
        const durLabel = fishDurSec ? ` · ${fishDurSec.toFixed(1)}s audio` : '';
        if(statusEl) statusEl.textContent = `✅ Generated${t}${durLabel} — rate it below or adjust settings and generate again`;
        showToast(`🐟 Fish Speech ready${t}${durLabel}`, 'info');
        _done();
        return;
      }
      if(j.status === 'failed'){
        const msg = j.error || j.message || 'Generation failed';
        if(statusEl) statusEl.textContent = `❌ ${msg}`;
        showToast(`Fish Speech error: ${msg}`, 'error');
        _done();
        return;
      }
      // Otherwise keep polling. Mild backoff on repeated errors.
      const wait = Math.min(POLL_MS_MAX, POLL_MS_BASE + consecutiveErrors * 1000);
      fishPollHandle = setTimeout(pollOnce, wait);
    } catch(e){
      if(e.name === 'AbortError'){ _done(); return; }
      const msg = e.message || 'Unknown error';
      if(statusEl) statusEl.textContent = `❌ ${msg}`;
      showToast(`Fish Speech error: ${msg}`, 'error');
      _done();
    }
  }
  pollOnce();
}

function fishSpeechPreview(){
  const line = state.script[state.voicePreviewLine % Math.max(1, state.script.length)]?.text
    || 'The truth they never say out loud.';
  fishSpeechGenerate(line);
}

// ── Fish Speech History, Presets & Quality ────────────────────────────────────

/** Rate the most recent Fish generation */
async function fishRateResult(rating){
  const id = state.lastFishHistoryId;
  if(!id){ showToast('No recent Fish generation to rate', 'info'); return; }
  // Toggle off if clicking same rating again
  if(state.lastFishRating === rating){
    rating = null;
    state.lastFishRating = null;
  } else {
    state.lastFishRating = rating;
  }
  document.querySelectorAll('.fish-rate-btn').forEach(b => b.classList.toggle('active', b.dataset.rating === rating));
  const rateStatus = document.getElementById('fishRateStatus');
  if(!rating){ if(rateStatus) rateStatus.textContent='Rating cleared'; return; }
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/history/${id}/rate`,{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ rating })
    });
    const d = await r.json();
    const labels = {good:'👍 Saved as Good',bad:'👎 Saved as Bad',too_fast:'⏩ Speed will be lowered next time',
      too_slow:'⏪ Speed will be raised next time',too_robotic:'🤖 Noted: too robotic',
      too_quiet:'🔇 Noted: too quiet — enable volume normalization',bad_timing:'⚡ Noted: rebuild timing from audio',
      use_this_style:'⭐ Style saved as favorite!'};
    if(rateStatus) rateStatus.textContent = labels[rating] || `✓ Rated: ${rating}`;
    // If too_fast/too_slow, apply suggested speed adjustment immediately
    if(d.suggestions?.speed !== undefined){
      const newSpeed = +d.suggestions.speed.toFixed(2);
      state.fishSpeed = newSpeed;
      const slEl = document.getElementById('fishSpeed');
      const valEl = document.getElementById('fishSpeedVal');
      if(slEl){ slEl.value = Math.round(newSpeed*100); }
      if(valEl) valEl.textContent = newSpeed.toFixed(2)+'x';
      showToast(`🐟 Speed adjusted to ${newSpeed.toFixed(2)}x based on your feedback`, 'info');
    }
    if(rating === 'too_quiet'){
      const norm = document.getElementById('fishNormalize');
      if(norm && !norm.checked){ norm.checked = true; state.fishNormalize = true; showToast('Volume normalize enabled','info'); }
    }
  }catch(e){
    if(rateStatus) rateStatus.textContent='Could not save rating: '+(e?.message||e);
  }
}

/** Show a prompt to save current Fish settings as a named preset */
async function fishSavePresetPrompt(){
  const name = window.prompt('Preset name (e.g. "Dark Narrator Slow"):','');
  if(!name?.trim()) return;
  await fishSavePreset(name.trim());
}

async function fishSavePreset(name){
  const voiceId = document.getElementById('fishVoiceSelect')?.value || state.fishVoice || 'dark_narrator';
  const body = {
    name, voiceId,
    speed:           state.fishSpeed    ?? 1.0,
    temperature:     state.fishTemp     ?? null,
    pitch:           state.fishPitch    ?? 0,
    normalizeVolume: state.fishNormalize !== false,
    isFavorite:      false,
    lastSuccessfulGeneration: state.lastFishHistoryId || null,
  };
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/presets`,{
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const d = await r.json();
    if(d.ok) showToast(`✅ Preset "${name}" saved!`, 'success');
    else showToast('Could not save preset: '+(d.error||'unknown'),'error');
  }catch(e){
    showToast('Preset save error: '+(e?.message||e),'error');
  }
}

/** Load the best known settings for the current voice from history */
async function fishLoadBestSettings(){
  const voiceId = document.getElementById('fishVoiceSelect')?.value || state.fishVoice || 'dark_narrator';
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/best-settings/${voiceId}`);
    const d = await r.json();
    if(!d.hasGoodHistory || !d.best){
      showToast('No good history found for this voice yet — generate and rate some outputs first', 'info');
      return;
    }
    fishApplySettingsFromHistory(d.best);
    showToast(`🏆 Loaded best settings for ${d.best.voiceName}`, 'success');
  }catch(e){
    showToast('Could not load best settings: '+(e?.message||e),'error');
  }
}

/** Load the last successful Fish generation settings */
async function fishLoadLastGoodSettings(){
  const voiceId = document.getElementById('fishVoiceSelect')?.value || state.fishVoice || 'dark_narrator';
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/history`);
    const d = await r.json();
    const forVoice = (d.history||[]).filter(h => h.voiceId === voiceId && (h.durationSeconds||0) > 0);
    if(!forVoice.length){
      showToast('No successful history for this voice yet', 'info');
      return;
    }
    fishApplySettingsFromHistory(forVoice[0]);
    showToast('↩ Loaded last successful settings', 'info');
  }catch(e){
    showToast('Error loading history: '+(e?.message||e),'error');
  }
}

/** Apply settings from a history entry to the Fish UI */
function fishApplySettingsFromHistory(entry){
  if(entry.speed !== undefined){
    state.fishSpeed = entry.speed;
    const el = document.getElementById('fishSpeed');
    const vl = document.getElementById('fishSpeedVal');
    if(el){ el.value = Math.round(entry.speed*100); }
    if(vl) vl.textContent = entry.speed.toFixed(2)+'x';
  }
  if(entry.temperature !== null && entry.temperature !== undefined){
    state.fishTemp = entry.temperature;
    const el = document.getElementById('fishTemp');
    const vl = document.getElementById('fishTempVal');
    if(el){ el.value = Math.round(entry.temperature*100); }
    if(vl) vl.textContent = entry.temperature.toFixed(2);
  }
  if(entry.pitch !== undefined){
    state.fishPitch = entry.pitch;
    const el = document.getElementById('fishPitch');
    const vl = document.getElementById('fishPitchVal');
    if(el){ el.value = entry.pitch; }
    if(vl) vl.textContent = (entry.pitch > 0 ? '+' : '') + entry.pitch + 'st';
  }
  if(entry.normalizeVolume !== undefined){
    state.fishNormalize = entry.normalizeVolume;
    const el = document.getElementById('fishNormalize');
    if(el) el.checked = entry.normalizeVolume;
  }
}

/** Reset Fish settings to defaults */
function fishResetSettings(){
  state.fishSpeed = 1.0; state.fishTemp = 0.70; state.fishPitch = 0; state.fishNormalize = true;
  const sets = [['fishSpeed','fishSpeedVal',100,'1.00x'],['fishTemp','fishTempVal',70,'0.70']];
  for(const [id,vid,val,txt] of sets){
    const el = document.getElementById(id); if(el) el.value = val;
    const vl = document.getElementById(vid); if(vl) vl.textContent = txt;
  }
  const pe = document.getElementById('fishPitch'); if(pe) pe.value = 0;
  const pv = document.getElementById('fishPitchVal'); if(pv) pv.textContent = '0st';
  const ne = document.getElementById('fishNormalize'); if(ne) ne.checked = true;
  showToast('↺ Fish settings reset to defaults','info');
}

// ── Fish History panel ────────────────────────────────────────────────────────

let fishHistoryExpanded = false;
function toggleFishHistoryBody(){
  fishHistoryExpanded = !fishHistoryExpanded;
  const body = document.getElementById('fishHistoryBody');
  const icon = document.getElementById('fishHistoryToggleIcon');
  if(body) body.style.display = fishHistoryExpanded ? 'flex' : 'none';
  if(icon) icon.textContent = fishHistoryExpanded ? '▲' : '▼';
  if(fishHistoryExpanded) loadFishHistory();
}

async function loadFishHistory(){
  const list = document.getElementById('fishHistoryList');
  if(!list) return;
  try{
    list.innerHTML = '<div style="font-size:.65rem;color:var(--muted);padding:4px">Loading…</div>';
    const r = await fetch(`${API_BASE}/api/fish-speech/history`);
    const d = await r.json();
    const entries = (d.history || []).slice(0, 30);
    if(!entries.length){
      list.innerHTML = '<div style="font-size:.65rem;color:var(--muted);padding:4px">No history yet — generate some Fish Speech audio to get started.</div>';
      return;
    }
    list.innerHTML = '';
    for(const entry of entries){
      list.appendChild(renderFishHistoryItem(entry));
    }
  }catch(e){
    if(list) list.innerHTML = '<div style="font-size:.62rem;color:#f87171">Could not load history: '+(e?.message||e)+'</div>';
  }
}

function renderFishHistoryItem(entry){
  const el = document.createElement('div');
  el.className = 'fish-hist-item';
  el.dataset.histId = entry.id;

  const date = new Date(entry.createdAt).toLocaleDateString(undefined,{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'});
  const dur  = entry.durationSeconds ? entry.durationSeconds.toFixed(1)+'s' : '?s';
  const size = entry.fileSizeBytes   ? `${(entry.fileSizeBytes/1024).toFixed(0)}KB` : '';
  const badge = entry.qualityRating
    ? {good:'👍',bad:'👎',too_fast:'⏩',too_slow:'⏪',too_robotic:'🤖',too_quiet:'🔇',bad_timing:'⚡',use_this_style:'⭐'}[entry.qualityRating] || '•'
    : '';
  const speedStr = entry.speed ? `${entry.speed.toFixed(2)}x` : '';
  const tempStr  = entry.temperature ? `t${entry.temperature.toFixed(2)}` : '';

  el.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:flex-start">
      <span style="font-size:.67rem;color:#6ee7b7;font-weight:700">${entry.voiceName || entry.voiceId} ${badge}</span>
      <span style="font-size:.58rem;color:var(--muted)">${date}</span>
    </div>
    <div style="font-size:.6rem;color:var(--muted)">${dur} ${size} ${speedStr} ${tempStr}</div>
    <div style="font-size:.6rem;color:var(--text2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${(entry.scriptText||'').slice(0,80)}</div>
    <div id="hist_audio_${entry.id}" style="display:none;margin-top:3px">
      <audio controls style="width:100%;height:30px;border-radius:6px"></audio>
    </div>
    <div class="fish-hist-actions">
      <button class="fish-hist-btn" onclick="fishHistPlay('${entry.id}','${entry.audioUrl}','${entry.audioPath}')">▶ Play</button>
      <button class="fish-hist-btn" onclick="fishHistUseSettings('${entry.id}')">⚙ Use Settings</button>
      <button class="fish-hist-btn" onclick="fishHistUseInTimeline('${entry.id}','${entry.audioUrl}','${entry.audioPath}')">📌 Use in Timeline</button>
      <button class="fish-hist-btn" onclick="fishHistSavePreset('${entry.id}','${entry.voiceId}')">💾 Favorite</button>
      <button class="fish-hist-btn" style="color:#f87171" onclick="fishHistArchive('${entry.id}')">✕ Hide</button>
    </div>`;
  return el;
}

function fishHistPlay(id, audioUrl, audioPath){
  const wrap = document.getElementById(`hist_audio_${id}`);
  if(!wrap) return;
  const isVisible = wrap.style.display !== 'none';
  if(isVisible){ wrap.style.display='none'; return; }
  wrap.style.display = 'block';
  const audio = wrap.querySelector('audio');
  if(!audio) return;
  // Resolve the URL — audioUrl is already a relative server path (/outputs-voices/...)
  // audioPath is a Windows absolute path used as fallback
  let url = audioUrl || (audioPath ? `/outputs-voices/${audioPath.replace(/\\/g,'/').split('/').pop()}` : null);
  // Prefix with API_BASE if it's a relative path (doesn't start with http)
  if(url && !url.startsWith('http') && typeof API_BASE !== 'undefined' && API_BASE){
    url = API_BASE.replace(/\/$/, '') + (url.startsWith('/') ? url : '/' + url);
  }
  if(url){
    audio.src = url;
    audio.load();
    audio.play().catch(err => {
      console.warn('[FishHistPlay] autoplay blocked:', err.message);
      showToast('Click play on the audio bar below to listen', 'info');
    });
  } else {
    audio.removeAttribute('src');
    showToast('Could not resolve audio URL for this history item', 'error');
  }
}

function fishHistUseSettings(id){
  fetch(`${API_BASE}/api/fish-speech/history`)
    .then(r=>r.json())
    .then(d=>{
      const entry = (d.history||[]).find(h=>h.id===id);
      if(!entry){ showToast('History entry not found','error'); return; }
      fishApplySettingsFromHistory(entry);
      showToast(`⚙ Settings from ${entry.voiceName} applied`,'info');
    }).catch(e=>showToast('Error: '+(e?.message||e),'error'));
}

async function fishHistUseInTimeline(id, audioUrl, audioPath){
  const url = audioUrl || (audioPath ? `/outputs-voices/${audioPath.replace(/\\/g,'/').split('/').pop()}` : null);
  if(!url){ showToast('Audio URL not found','error'); return; }
  // Mark as used-in-render in the history record
  fetch(`${API_BASE}/api/fish-speech/history/${id}/use-in-render`,{method:'POST'}).catch(()=>{});
  // Load the full history entry to get duration + settings for timing
  try{
    const r = await fetch(`${API_BASE}/api/fish-speech/history`);
    const d = await r.json();
    const entry = (d.history||[]).find(h => h.id === id);
    const durSec = entry?.durationSeconds || null;
    const fullUrl = url.startsWith('http') ? url : (window.API_BASE || '') + url;
    // Apply this Fish audio as the active timeline audio
    state.lastFishAudioUrl        = url;
    state.lastFishHistoryId       = id;
    state.previewAudioUrl         = url;
    state.previewAudioDurationSec = durSec;
    state.lastResolvedEngine      = 'fish-speech';
    state.activeTimelineProvider  = 'fish-speech';
    // Build a timing object so the render pipeline accepts this audio
    if(durSec && durSec > 0){
      const scriptText = entry?.scriptText || (state.script||[]).map(l=>l.text||'').join(' ');
      const wordCount = (scriptText||'').split(/\S+/).length - 1;
      const wps = wordCount > 0 ? +(wordCount / durSec).toFixed(3) : null;
      state.previewTiming = {
        mode: 'autoMatchVoice',
        targetDurationSeconds: null,
        actualAudioDurationSeconds: durSec,
        finalVideoDurationSeconds: durSec,
        provider: 'fish-speech',
        voiceId: entry?.voiceId || 'fish-speech',
        audioUrl: url,
        audioFile: url.split('/').pop() || '',
        audioPath: entry?.audioPath || '',
        source: 'fish-audio-duration',
        wordsPerSecond: wps,
        createdAt: new Date().toISOString(),
        lines: [],
        totalWords: wordCount,
      };
    }
    // Also apply the voice settings from this history entry so Generate still works
    if(entry){ fishApplySettingsFromHistory(entry); }
    // Refresh UI
    refreshDurationBadge && refreshDurationBadge();
    refreshRenderSyncPanel && refreshRenderSyncPanel();
    clearDirty && clearDirty('preview');
    const durLabel = durSec ? ` (${durSec.toFixed(1)}s)` : '';
    showToast(`📌 Fish audio${durLabel} set as active timeline voice`, 'success');
  }catch(e){
    // Fallback: at minimum update state and show toast
    state.lastFishAudioUrl = url;
    state.previewAudioUrl  = url;
    state.lastResolvedEngine = 'fish-speech';
    showToast('📌 Fish audio set as timeline voice (limited info — duration unknown)', 'info');
  }
}

function fishHistSavePreset(id, voiceId){
  fetch(`${API_BASE}/api/fish-speech/history`)
    .then(r=>r.json())
    .then(d=>{
      const entry = (d.history||[]).find(h=>h.id===id);
      if(!entry) return;
      const name = window.prompt('Save as preset:', `${entry.voiceName} — ${new Date(entry.createdAt).toLocaleDateString()}`);
      if(!name?.trim()) return;
      fetch(`${API_BASE}/api/fish-speech/presets`,{
        method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({name:name.trim(),voiceId:entry.voiceId,speed:entry.speed,
          temperature:entry.temperature,pitch:entry.pitch,normalizeVolume:entry.normalizeVolume,isFavorite:true,
          lastSuccessfulGeneration:entry.id})
      }).then(r=>r.json()).then(d=>{ if(d.ok) showToast(`⭐ Preset "${name.trim()}" saved`,'success'); });
    }).catch(()=>{});
}

async function fishHistArchive(id){
  try{
    await fetch(`${API_BASE}/api/fish-speech/history/${id}/archive`,{method:'POST'});
    const item = document.querySelector(`[data-hist-id="${id}"]`);
    if(item) item.remove();
    showToast('Entry hidden (archived, files kept safe)','info');
  }catch(e){ showToast('Error: '+(e?.message||e),'error'); }
}

window.fishRateResult         = fishRateResult;
window.fishSavePresetPrompt   = fishSavePresetPrompt;
window.fishSavePreset         = fishSavePreset;
window.fishLoadBestSettings   = fishLoadBestSettings;
window.fishLoadLastGoodSettings = fishLoadLastGoodSettings;
window.fishApplySettingsFromHistory = fishApplySettingsFromHistory;
window.fishResetSettings      = fishResetSettings;
window.toggleFishHistoryBody  = toggleFishHistoryBody;
window.loadFishHistory        = loadFishHistory;
window.fishHistPlay           = fishHistPlay;
window.fishHistUseSettings    = fishHistUseSettings;
window.fishHistUseInTimeline  = fishHistUseInTimeline;
window.fishHistSavePreset     = fishHistSavePreset;
window.fishHistArchive        = fishHistArchive;

function setRenderFps(fps, btn){
  state.renderFps = +fps;
  document.querySelectorAll('[data-fps]').forEach(b => b.classList.toggle('active', +b.dataset.fps === +fps));
  showToast(`🎞 Render set to ${fps} FPS`, 'info');
}
function setRenderQuality(q, btn){
  state.renderQuality = q;
  document.querySelectorAll('[data-quality]').forEach(b => b.classList.toggle('active', b.dataset.quality === q));
  showToast(`💎 Quality: ${q}`, 'info');
}

function updateColorIntensity(el){
  state.colorGradeIntensity = +el.value;
  document.getElementById('colorIntensityVal').textContent = el.value+'%';
  updateSliderTrack(el.id);
  updatePreview();
}

// Generic tone-slider handler: writes to state.<key>, updates label, refreshes preview
function updateTone(key, el, valId, fmt){
  state[key] = +el.value;
  const lbl = document.getElementById(valId);
  if(lbl) lbl.textContent = fmt(el.value);
  updateSliderTrack(el.id);
  updatePreview();
}

// Reset Saturation/Contrast/Exposure/Highlights/Shadows to neutral
function resetToneAdjustments(){
  state.saturation = 100;
  state.contrast   = 100;
  state.exposure   = 0;
  state.highlights = 0;
  state.shadows    = 0;
  const setS = (id, val, valId, txt) => {
    const e = document.getElementById(id); if(e){ e.value = val; updateSliderTrack(id); }
    const v = document.getElementById(valId); if(v) v.textContent = txt;
  };
  setS('satSlider', 100, 'satVal', '100%');
  setS('conSlider', 100, 'conVal', '100%');
  setS('expSlider', 0,   'expVal', '0');
  setS('hlSlider',  0,   'hlVal',  '0');
  setS('shSlider',  0,   'shVal',  '0');
  updatePreview();
  showToast('↺ Tone adjustments reset','info');
}

// Apply Highlights / Shadows blend-mode overlays to the phone preview.
// Mirrors ToneOverlay() in TrendVaultVideo.tsx so the preview matches the render.
function applyToneOverlay(hl, sh){
  const hlEl = document.getElementById('phoneToneHighlights');
  const shEl = document.getElementById('phoneToneShadows');
  if(!hlEl || !shEl) return;

  if(hl !== 0){
    const a = Math.min(0.45, Math.abs(hl)/100 * 0.4);
    hlEl.style.display = 'block';
    hlEl.style.background = hl > 0 ? '#ffffff' : '#282828';
    hlEl.style.mixBlendMode = hl > 0 ? 'screen' : 'multiply';
    hlEl.style.opacity = a;
  } else {
    hlEl.style.display = 'none';
  }

  if(sh !== 0){
    const a = Math.min(0.45, Math.abs(sh)/100 * 0.4);
    shEl.style.display = 'block';
    shEl.style.background = sh > 0 ? '#787878' : '#000000';
    shEl.style.mixBlendMode = sh > 0 ? 'screen' : 'multiply';
    shEl.style.opacity = a;
  } else {
    shEl.style.display = 'none';
  }
}

// Compose extra Saturation/Contrast/Exposure into a CSS filter string
// (mirrors buildAdjustmentFilter() in TrendVaultVideo.tsx)
function buildAdjustmentFilterCSS(){
  const sat = state.saturation ?? 100;
  const con = state.contrast   ?? 100;
  const exp = state.exposure   ?? 0;
  const parts = [];
  if(sat !== 100) parts.push(`saturate(${(sat/100).toFixed(3)})`);
  if(con !== 100) parts.push(`contrast(${(con/100).toFixed(3)})`);
  if(exp !== 0)   parts.push(`brightness(${(1 + exp/200).toFixed(3)})`);
  return parts.join(' ');
}

function updateBgBlur(el){
  state.bgBlur = +el.value;
  document.getElementById('bgBlurVal').textContent = el.value;
  updateSliderTrack(el.id);
  updatePreview();
}

function updateBgBright(el){
  state.bgBrightness = +el.value;
  document.getElementById('bgBrightVal').textContent = el.value+'%';
  updateSliderTrack(el.id);
  updatePreview();
}

function updateMusicVol(el){
  state.musicVolume = +el.value;
  document.getElementById('musicVolVal').textContent = el.value+'%';
  updateSliderTrack(el.id);
}

// ═══════════════════════════════════════════════════════════════════
// FONT & TEXT
// ═══════════════════════════════════════════════════════════════════

const FONT_POOL = ["Impact,'Arial Black',sans-serif","'Arial Black','Arial Bold',sans-serif","'Montserrat','Space Grotesk',sans-serif","'Cinzel','Playfair Display',serif","'Playfair Display',Georgia,serif","'Oswald',sans-serif","Georgia,serif","'Courier New',monospace","'Space Grotesk',sans-serif","'Inter',sans-serif"];

function updateFont(){
  state.fontFamily = document.getElementById('fontSelect').value;
  document.getElementById('fontPreview').style.fontFamily = state.fontFamily;
  updatePreview();
}

function randomFont(){
  const f = FONT_POOL[Math.floor(Math.random()*FONT_POOL.length)];
  state.fontFamily = f;
  document.getElementById('fontSelect').value = f;
  document.getElementById('fontPreview').style.fontFamily = f;
  updatePreview();
  showToast('Random font applied','info');
}

function randomTextAnimation(){
  const anims = ['fade','slide-up','typewriter','fade-typewriter','word-drop','scale','bounce','glow','blur-in','rise','shimmer','cascade','dissolve','flicker','glitch-in'];
  const a = anims[Math.floor(Math.random()*anims.length)];
  document.getElementById('textAnimSelect').value = a;
  state.textAnimation = a;
  updatePreview();
  showToast('Animation: '+a,'info');
}

function buildColorSwatches(){
  const wrap = document.getElementById('colorSwatches');
  wrap.innerHTML = TEXT_COLORS.map(c=>`
    <div class="swatch${c===state.textColor?' active':''}" style="background:${c}" data-color="${c}" onclick="selectColor('${c}')" title="${c}"></div>
  `).join('');
  // Initialise sliders to match the current state color
  syncColorSlidersFromHex(state.textColor, false);
}

/* ─── Color Editor helpers ──────────────────────────────────────── */
function hslToHex(h,s,l){
  s/=100; l/=100;
  const a=s*Math.min(l,1-l);
  const f=n=>{const k=(n+h/30)%12;const color=l-a*Math.max(Math.min(k-3,9-k,1),-1);return Math.round(255*color).toString(16).padStart(2,'0')};
  return '#'+f(0)+f(8)+f(4);
}
function hexToHsl(hex){
  hex=hex.replace('#','');
  if(hex.length===3) hex=hex.split('').map(c=>c+c).join('');
  const r=parseInt(hex.slice(0,2),16)/255, g=parseInt(hex.slice(2,4),16)/255, b=parseInt(hex.slice(4,6),16)/255;
  const max=Math.max(r,g,b), min=Math.min(r,g,b);
  let h=0,s=0,l=(max+min)/2;
  if(max!==min){
    const d=max-min; s=l>.5?d/(2-max-min):d/(max+min);
    switch(max){case r:h=((g-b)/d+(g<b?6:0))/6;break;case g:h=((b-r)/d+2)/6;break;case b:h=((r-g)/d+4)/6;break;}
  }
  return [Math.round(h*360), Math.round(s*100), Math.round(l*100)];
}
function _updateSatTrack(h,l){
  const lo=hslToHex(h,0,l), hi=hslToHex(h,100,l);
  document.getElementById('satTrack').style.background=`linear-gradient(to right,${lo},${hi})`;
}
function _updateLightTrack(h,s){
  const dark=hslToHex(h,s,0), mid=hslToHex(h,s,50), lite=hslToHex(h,s,100);
  document.getElementById('lightTrack').style.background=`linear-gradient(to right,${dark},${mid},${lite})`;
}
function _updateAlphaTrack(hexColor){
  const r=parseInt(hexColor.slice(1,3),16), g=parseInt(hexColor.slice(3,5),16), b=parseInt(hexColor.slice(5,7),16);
  document.getElementById('alphaTrack').style.background=
    `linear-gradient(to right,rgba(${r},${g},${b},0),rgba(${r},${g},${b},1))`;
}
function updateColorFromSliders(){
  const h=+document.getElementById('hueSlider').value;
  const s=+document.getElementById('satSlider').value;
  const l=+document.getElementById('lightSlider').value;
  const a=+document.getElementById('alphaSlider').value;
  document.getElementById('hueVal').textContent   = h+'°';
  document.getElementById('satVal').textContent   = s+'%';
  document.getElementById('lightVal').textContent = l+'%';
  document.getElementById('alphaVal').textContent = a+'%';
  const hex=hslToHex(h,s,l);
  _updateSatTrack(h,l);
  _updateLightTrack(h,s);
  _updateAlphaTrack(hex);
  // swatch & hex input
  const ra=Math.round(a*2.55), hexA=(ra<16?'0':'')+ra.toString(16);
  const fullHex = a<100 ? hex+hexA : hex;
  document.getElementById('colorPreviewSwatch').style.background =
    a<100 ? `rgba(${parseInt(hex.slice(1,3),16)},${parseInt(hex.slice(3,5),16)},${parseInt(hex.slice(5,7),16)},${a/100})` : hex;
  document.getElementById('colorHexInput').value = fullHex.replace('#','');
  document.getElementById('nativeColorPicker').value = hex;
  // RGB display
  const ri=parseInt(hex.slice(1,3),16), gi=parseInt(hex.slice(3,5),16), bi=parseInt(hex.slice(5,7),16);
  document.getElementById('colorRgbDisplay').textContent = a<100
    ? `rgba(${ri}, ${gi}, ${bi}, ${(a/100).toFixed(2)})`
    : `rgb(${ri}, ${gi}, ${bi})`;
  // state
  state.textColor = a<100
    ? `rgba(${ri},${gi},${bi},${(a/100).toFixed(2)})`
    : hex;
  document.querySelectorAll('.swatch').forEach(sw=>sw.classList.toggle('active', sw.dataset.color===state.textColor));
  updatePreview();
}
function syncColorSlidersFromHex(hex, andUpdate){
  hex=(hex||'').trim();
  // Handle rgba(r,g,b,a) strings
  const rgbaMatch=hex.match(/^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)(?:\s*,\s*([\d.]+))?\s*\)$/i);
  if(rgbaMatch){
    const ri=+rgbaMatch[1],gi=+rgbaMatch[2],bi=+rgbaMatch[3];
    const ai=rgbaMatch[4]!=null?Math.round(+rgbaMatch[4]*100):100;
    hex='#'+ri.toString(16).padStart(2,'0')+gi.toString(16).padStart(2,'0')+bi.toString(16).padStart(2,'0');
    const ra=Math.round(ai*2.55), hexA=(ra<16?'0':'')+ra.toString(16);
    if(ai<100) hex=hex+(hexA);
  }
  if(!hex.startsWith('#')) hex='#'+hex;
  // strip alpha from 8-char hex for HSL parsing
  const baseHex = hex.length===9 ? hex.slice(0,7) : hex;
  const alphaHex = hex.length===9 ? parseInt(hex.slice(7,9),16) : 255;
  const a=Math.round(alphaHex/2.55);
  try{
    const [h,s,l]=hexToHsl(baseHex);
    document.getElementById('hueSlider').value   = h;
    document.getElementById('satSlider').value   = s;
    document.getElementById('lightSlider').value = l;
    document.getElementById('alphaSlider').value = a;
    document.getElementById('hueVal').textContent   = h+'°';
    document.getElementById('satVal').textContent   = s+'%';
    document.getElementById('lightVal').textContent = l+'%';
    document.getElementById('alphaVal').textContent = a+'%';
    _updateSatTrack(h,l);
    _updateLightTrack(h,s);
    _updateAlphaTrack(baseHex);
    const ri=parseInt(baseHex.slice(1,3),16), gi=parseInt(baseHex.slice(3,5),16), bi=parseInt(baseHex.slice(5,7),16);
    document.getElementById('colorPreviewSwatch').style.background =
      a<100 ? `rgba(${ri},${gi},${bi},${a/100})` : baseHex;
    document.getElementById('colorHexInput').value = hex.replace('#','');
    document.getElementById('nativeColorPicker').value = baseHex;
    document.getElementById('colorRgbDisplay').textContent = a<100
      ? `rgba(${ri}, ${gi}, ${bi}, ${(a/100).toFixed(2)})`
      : `rgb(${ri}, ${gi}, ${bi})`;
    if(andUpdate){
      state.textColor = a<100 ? `rgba(${ri},${gi},${bi},${(a/100).toFixed(2)})` : baseHex;
      document.querySelectorAll('.swatch').forEach(sw=>sw.classList.toggle('active', sw.dataset.color===state.textColor));
      updatePreview();
    }
  }catch(e){}
}
function setColorFromHex(val){
  const clean=val.replace('#','').trim();
  if(clean.length!==6&&clean.length!==8) return;
  syncColorSlidersFromHex('#'+clean, true);
}
function selectColor(c){
  state.textColor = c;
  document.querySelectorAll('.swatch').forEach(s=>s.classList.toggle('active',s.dataset.color===c));
  syncColorSlidersFromHex(c, false);
  updatePreview();
}
function setCustomColor(c){
  syncColorSlidersFromHex(c, true);
}

function updateFontSize(el){
  state.fontSize = +el.value;
  document.getElementById('fontSizeVal').textContent = el.value;
  updateSliderTrack(el.id);
  updatePreview();
}

function toggleFmt(fmt){
  const key = {bold:'textBold',italic:'textItalic',upper:'textUpper',stroke:'textStroke',shadow:'textShadow',glow:'textGlow'}[fmt];
  if(!key) return;
  state[key] = !state[key];
  const btn = document.getElementById('fmt'+fmt.charAt(0).toUpperCase()+fmt.slice(1));
  if(btn) btn.classList.toggle('active', state[key]);
  updatePreview();
}

function updateLetterSpacing(el){
  state.letterSpacing = +el.value;
  document.getElementById('letterSpacingVal').textContent = el.value+'px';
  updateSliderTrack(el.id);
  updatePreview();
}

function updateLineHeight(el){
  state.lineHeight = +el.value;
  document.getElementById('lineHeightVal').textContent = (+el.value).toFixed(2);
  updateSliderTrack(el.id);
  updatePreview();
}

function applyTextFormatToElement(el){
  if(!el) return;
  el.style.fontWeight     = state.textBold   ? '900' : '700';
  el.style.fontStyle      = state.textItalic ? 'italic' : 'normal';
  el.style.textTransform  = state.textUpper  ? 'uppercase' : 'none';
  el.style.letterSpacing  = state.letterSpacing + 'px';
  el.style.lineHeight     = state.lineHeight;
  // Build text shadow
  const shadows = [];
  if(state.textShadow) shadows.push('2px 2px 0 rgba(0,0,0,.95),-2px -2px 0 rgba(0,0,0,.95),2px -2px 0 rgba(0,0,0,.95),-2px 2px 0 rgba(0,0,0,.95),0 4px 20px rgba(0,0,0,.9)');
  if(state.textStroke)  shadows.push('0 0 1px #000,0 0 2px #000,-1px -1px 0 #000,1px 1px 0 #000,1px -1px 0 #000,-1px 1px 0 #000');
  if(state.textGlow)    shadows.push(`0 0 14px ${state.textColor},0 0 28px ${state.textColor}`);
  el.style.textShadow = shadows.join(',') || 'none';
}

// ═══════════════════════════════════════════════════════════════════
// PREVIEW ANIMATION ENGINE
// ═══════════════════════════════════════════════════════════════════

// Active typewriter / word-drop timeouts — cleared on every new line
let _twInterval  = null;
let _twTimeouts  = [];
let _glowInterval = null;

const ANIM_CLASSES = ['cap-anim-fade','cap-anim-slide-up','cap-anim-scale','cap-anim-bounce','cap-anim-blur-in','cap-anim-glow','cap-anim-rise','cap-anim-flicker','cap-anim-glitch-in'];

// Base durations (ms) for CSS-driven animations at speed 1×
const ANIM_BASE_DUR = {
  'fade':      400,
  'slide-up':  450,
  'scale':     400,
  'bounce':    450,
  'blur-in':   500,
  'glow':      400,
  'rise':      700,
  'flicker':   600,
  'glitch-in': 500,
};

function _clearAnimTimers(){
  if(_twInterval){ clearInterval(_twInterval); _twInterval=null; }
  _twTimeouts.forEach(t=>clearTimeout(t)); _twTimeouts=[];
  if(_glowInterval){ clearInterval(_glowInterval); _glowInterval=null; }
}

function playCaptionAnim(cap, text, anim, lineDurMs, speed){
  _clearAnimTimers();
  const spd = (speed && speed > 0) ? speed : 1.0;
  const effectiveDurMs = lineDurMs; // total line duration, unchanged

  // Reset element
  cap.classList.remove(...ANIM_CLASSES);
  cap.innerHTML = '';
  cap.style.cssText += ';opacity:1;transform:none;filter:none';

  // ── CSS-driven animations ────────────────────────────────────────────────
  if(['fade','slide-up','scale','bounce','blur-in','rise','flicker','glitch-in'].includes(anim)){
    cap.textContent = text;
    const baseDur = ANIM_BASE_DUR[anim] || 400;
    const dur = Math.round(baseDur / spd);
    cap.style.setProperty('--anim-dur', dur+'ms');
    void cap.offsetWidth; // force reflow so animation re-fires
    cap.classList.add('cap-anim-'+anim);

  // ── Classic typewriter ───────────────────────────────────────────────────
  } else if(anim === 'typewriter'){
    cap.style.opacity = '1';
    const totalChars = text.length;
    const charDelay  = Math.max(8, Math.min(120, (effectiveDurMs * 0.70) / totalChars) / spd);
    let charIdx = 0;
    const cursor = document.createElement('span');
    cursor.textContent = '|';
    cursor.style.cssText = 'animation:twBlink .6s ease-in-out infinite alternate;font-weight:300';
    cap.appendChild(cursor);

    _twInterval = setInterval(()=>{
      if(charIdx < totalChars){
        cap.insertBefore(document.createTextNode(text[charIdx]), cursor);
        charIdx++;
      } else {
        clearInterval(_twInterval); _twInterval = null;
        _twTimeouts.push(setTimeout(()=>{ if(cursor.parentNode) cursor.style.opacity='0'; }, 500));
      }
    }, charDelay);

  // ── Fade typewriter (chars fade in one-by-one) ───────────────────────────
  } else if(anim === 'fade-typewriter'){
    cap.style.opacity = '1';
    const chars = text.split('');
    const totalRevealMs = (effectiveDurMs * 0.65) / spd;
    const charInterval  = Math.max(10, totalRevealMs / Math.max(chars.length, 1));
    const charFadeDur   = Math.round(Math.min(charInterval * 0.9, 200 / spd));

    chars.forEach((ch, i) => {
      const span = document.createElement('span');
      span.textContent = ch;
      span.style.cssText = `opacity:0;transition:opacity ${charFadeDur}ms ease`;
      cap.appendChild(span);
      _twTimeouts.push(setTimeout(()=>{ span.style.opacity = '1'; }, i * charInterval));
    });

  // ── Word drop (words slide in from above, staggered) ─────────────────────
  } else if(anim === 'word-drop'){
    cap.style.opacity = '1';
    const words = text.split(' ');
    const totalRevealMs = (effectiveDurMs * 0.6) / spd;
    const wordDelay     = Math.max(40, totalRevealMs / Math.max(words.length, 1));
    const wordFadeDur   = Math.round(Math.min(wordDelay * 0.85, 280 / spd));

    words.forEach((word, i) => {
      const span = document.createElement('span');
      span.textContent = (i > 0 ? ' ' : '') + word;
      span.style.cssText = `display:inline-block;opacity:0;transform:translateY(-20px);transition:opacity ${wordFadeDur}ms ease,transform ${wordFadeDur}ms cubic-bezier(.16,1,.3,1)`;
      cap.appendChild(span);
      _twTimeouts.push(setTimeout(()=>{
        span.style.opacity   = '1';
        span.style.transform = 'translateY(0)';
      }, i * wordDelay));
    });

  // ── Glow pulse ───────────────────────────────────────────────────────────
  } else if(anim === 'glow'){
    cap.textContent = text;
    const dur = Math.round((ANIM_BASE_DUR['glow'] || 400) / spd);
    cap.style.setProperty('--anim-dur', dur+'ms');
    void cap.offsetWidth;
    cap.classList.add('cap-anim-glow');
    const baseColor  = cap.style.color || '#ffffff';
    const baseShadow = cap.style.textShadow || '';
    let phase = 0;
    _glowInterval = setInterval(()=>{
      phase += 0.12 * spd;
      const g = 0.5 + 0.5 * Math.sin(phase);
      cap.style.textShadow = `${baseShadow}, 0 0 ${12*g}px ${baseColor}, 0 0 ${28*g}px ${baseColor}`;
    }, 50);
    _twTimeouts.push(setTimeout(()=>{
      if(_glowInterval){ clearInterval(_glowInterval); _glowInterval=null; }
      cap.style.textShadow = baseShadow;
    }, effectiveDurMs));

  // ── Shimmer (chars fade + brightness flash, left→right) ─────────────────
  } else if(anim === 'shimmer'){
    cap.style.opacity = '1';
    const chars = text.split('');
    const totalRevealMs = (effectiveDurMs * 0.65) / spd;
    const charInterval  = Math.max(12, totalRevealMs / Math.max(chars.length, 1));
    const charFadeDur   = Math.round(Math.min(charInterval * 0.8, 220 / spd));

    chars.forEach((ch, i) => {
      const span = document.createElement('span');
      span.textContent = ch;
      span.style.cssText = `opacity:0;transition:opacity ${charFadeDur}ms ease,filter ${charFadeDur}ms ease;filter:brightness(3)`;
      cap.appendChild(span);
      _twTimeouts.push(setTimeout(()=>{
        span.style.opacity = '1';
        span.style.filter  = 'brightness(1)';
        // Secondary flash dimdown after reveal
        _twTimeouts.push(setTimeout(()=>{ span.style.filter='brightness(1)'; }, charFadeDur * 1.5));
      }, i * charInterval));
    });

  // ── Cascade (chars fall from above, staggered) ────────────────────────────
  } else if(anim === 'cascade'){
    cap.style.opacity = '1';
    const chars = text.split('');
    const totalRevealMs = (effectiveDurMs * 0.6) / spd;
    const charInterval  = Math.max(14, totalRevealMs / Math.max(chars.length, 1));
    const charFallDur   = Math.round(Math.min(charInterval * 0.9, 280 / spd));

    chars.forEach((ch, i) => {
      const span = document.createElement('span');
      span.textContent = ch;
      span.style.cssText = `display:inline-block;opacity:0;transform:translateY(-28px);transition:opacity ${charFallDur}ms ease,transform ${charFallDur}ms cubic-bezier(.34,1.4,.64,1)`;
      cap.appendChild(span);
      _twTimeouts.push(setTimeout(()=>{
        span.style.opacity   = '1';
        span.style.transform = 'translateY(0)';
      }, i * charInterval));
    });

  // ── Dissolve (chars fade in random order) ────────────────────────────────
  } else if(anim === 'dissolve'){
    cap.style.opacity = '1';
    const chars = text.split('');
    const n = chars.length;
    const totalRevealMs = (effectiveDurMs * 0.7) / spd;
    const charFadeDur   = Math.round(Math.min(200 / spd, totalRevealMs * 0.3));
    // Deterministic pseudo-random order seeded on text
    const seed0 = text.split('').reduce((a,c)=>a+c.charCodeAt(0),17);
    const order = chars.map((_,i)=>({ i, r:((seed0+i*1664525+1013904223)*(i+3))&0x7fffffff }))
                       .sort((a,b)=>a.r-b.r);
    const spans = chars.map((ch, i)=>{
      const span = document.createElement('span');
      span.textContent = ch;
      span.style.cssText = `opacity:0;transition:opacity ${charFadeDur}ms ease`;
      cap.appendChild(span);
      return span;
    });
    order.forEach(({ i }, pos) => {
      const delay = (pos / Math.max(n-1,1)) * totalRevealMs;
      _twTimeouts.push(setTimeout(()=>{ spans[i].style.opacity='1'; }, delay));
    });

  } else {
    // Fallback
    cap.textContent = text;
    cap.style.setProperty('--anim-dur','400ms');
    void cap.offsetWidth;
    cap.classList.add('cap-anim-fade');
  }
}

// ═══════════════════════════════════════════════════════════════════
// CINEMATIC PRESETS
// ═══════════════════════════════════════════════════════════════════

const CINEMATIC_PRESETS = {
  'liminal-horror': {
    name:'Liminal Horror',
    colorGrade:'analog', grainType:'film', grainIntensity:50,
    bgBlur:3, bgBrightness:58, fog:false, rain:false, vignette:true, zoom:true,
  },
  'vhs-nightmare': {
    name:'VHS Nightmare',
    colorGrade:'nightmare', grainType:'vhs', grainIntensity:72,
    bgBlur:1, bgBrightness:52, fog:false, rain:false, vignette:true, zoom:false,
  },
  'noir-dream': {
    name:'Noir Dream',
    colorGrade:'analog', grainType:'film', grainIntensity:38,
    bgBlur:4, bgBrightness:62, fog:true, rain:false, vignette:true, zoom:true,
  },
  'liminal-space': {
    name:'Liminal Space',
    colorGrade:'liminal', grainType:'film', grainIntensity:28,
    bgBlur:5, bgBrightness:68, fog:true, rain:false, vignette:true, zoom:true,
  },
  'midnight-bloom': {
    name:'Midnight Bloom',
    colorGrade:'bloom', grainType:'digital', grainIntensity:18,
    bgBlur:3, bgBrightness:76, fog:true, rain:false, vignette:false, zoom:true,
  },
  'rain-horror': {
    name:'Rain Horror',
    colorGrade:'nightmare', grainType:'film', grainIntensity:55,
    bgBlur:2, bgBrightness:48, fog:false, rain:true, vignette:true, zoom:false,
  },
  'dark-prophecy': {
    name:'Dark Prophecy',
    colorGrade:'dark', grainType:'film', grainIntensity:42,
    bgBlur:0, bgBrightness:60, fog:false, rain:false, vignette:true, zoom:true,
  },
  'blood-ritual': {
    name:'Blood Ritual',
    colorGrade:'crimson', grainType:'film', grainIntensity:48,
    bgBlur:1, bgBrightness:54, fog:false, rain:false, vignette:true, zoom:true,
  },
  // Dark cinematic TikTok "storycore" — B&W, soft blur, heavy grain, vignette,
  // slow zoom, oversized Anton captions with word-drop pop-in.
  'storycore': {
    name:'Storycore',
    colorGrade:'mono', grainType:'film', grainIntensity:42,
    bgBlur:6, bgBrightness:60, fog:true, rain:false, vignette:true, zoom:true,
    saturation:0, contrast:120, exposure:-10, highlights:-15, shadows:-25,
    fontFamily:"'Anton',sans-serif", fontSize:96, textColor:'#ffffff',
    textAnimation:'word-drop', animSpeed:1.0,
  },
};

function applyPreset(id){
  const p = CINEMATIC_PRESETS[id];
  if(!p){ showToast('Unknown preset','error'); return; }
  pushUndo();

  // Color grade + reset intensity to full so preset looks as designed
  setColorGrade(p.colorGrade, document.querySelector(`[data-grade="${p.colorGrade}"]`));
  const cis = document.getElementById('colorIntensitySlider');
  if(cis){ cis.value = 100; updateSliderTrack('colorIntensitySlider'); }
  state.colorGradeIntensity = 100;
  const civ = document.getElementById('colorIntensityVal');
  if(civ) civ.textContent = '100%';

  // Grain type
  document.querySelectorAll('[data-grain]').forEach(b=>b.classList.toggle('active', b.dataset.grain===p.grainType));
  state.grainType = p.grainType;

  // Grain intensity
  const gs = document.getElementById('grainSlider');
  if(gs){ gs.value=p.grainIntensity; updateSliderTrack('grainSlider'); }
  state.grainIntensity = p.grainIntensity;
  const gv = document.getElementById('grainVal');
  if(gv) gv.textContent = p.grainIntensity+'%';

  // BG blur
  const bls = document.getElementById('bgBlurSlider');
  if(bls){ bls.value=p.bgBlur; updateSliderTrack('bgBlurSlider'); }
  state.bgBlur = p.bgBlur;
  const blv = document.getElementById('bgBlurVal');
  if(blv) blv.textContent = p.bgBlur;

  // BG brightness
  const brs = document.getElementById('bgBrightSlider');
  if(brs){ brs.value=p.bgBrightness; updateSliderTrack('bgBrightSlider'); }
  state.bgBrightness = p.bgBrightness;
  const brv = document.getElementById('bgBrightVal');
  if(brv) brv.textContent = p.bgBrightness+'%';

  // Overlay toggles
  const fog = document.getElementById('fogToggle');
  const rain = document.getElementById('rainToggle');
  const zoom = document.getElementById('zoomToggle');
  const vig  = document.getElementById('vignetteToggle');
  if(fog)  fog.checked  = p.fog;
  if(rain) rain.checked = p.rain;
  if(zoom) zoom.checked = p.zoom;
  if(vig)  vig.checked  = p.vignette;

  // Tone adjustments — apply if preset specifies, else reset to neutral
  const setSliderVal = (id, val, valId, txt) => {
    const e = document.getElementById(id); if(e){ e.value = val; updateSliderTrack(id); }
    const v = document.getElementById(valId); if(v) v.textContent = txt;
  };
  state.saturation = p.saturation ?? 100;
  state.contrast   = p.contrast   ?? 100;
  state.exposure   = p.exposure   ?? 0;
  state.highlights = p.highlights ?? 0;
  state.shadows    = p.shadows    ?? 0;
  setSliderVal('satSlider', state.saturation, 'satVal', state.saturation+'%');
  setSliderVal('conSlider', state.contrast,   'conVal', state.contrast+'%');
  setSliderVal('expSlider', state.exposure,   'expVal', (state.exposure>0?'+':'')+state.exposure);
  setSliderVal('hlSlider',  state.highlights, 'hlVal',  (state.highlights>0?'+':'')+state.highlights);
  setSliderVal('shSlider',  state.shadows,    'shVal',  (state.shadows>0?'+':'')+state.shadows);

  // Optional font/animation/textColor overrides (Storycore uses these)
  if(p.fontFamily){
    state.fontFamily = p.fontFamily;
    const fs = document.getElementById('fontSelect');
    if(fs) fs.value = p.fontFamily;
    document.querySelectorAll('.font-card').forEach(c => c.classList.toggle('active', c.dataset.value === p.fontFamily));
    const fp = document.getElementById('fontPreview');
    if(fp) fp.style.fontFamily = p.fontFamily;
  }
  if(p.fontSize){
    state.fontSize = p.fontSize;
    const fss = document.getElementById('fontSizeSlider');
    if(fss){ fss.value = p.fontSize; updateSliderTrack('fontSizeSlider'); }
    const fsv = document.getElementById('fontSizeVal');
    if(fsv) fsv.textContent = p.fontSize;
  }
  if(p.textColor){
    state.textColor = p.textColor;
    if(typeof syncColorSlidersFromHex === 'function') syncColorSlidersFromHex(p.textColor, false);
  }
  if(p.textAnimation){
    state.textAnimation = p.textAnimation;
    const ta = document.getElementById('textAnimSelect');
    if(ta) ta.value = p.textAnimation;
  }
  if(p.animSpeed != null){
    state.animSpeed = p.animSpeed;
    const ass = document.getElementById('animSpeedSlider');
    if(ass){ ass.value = Math.round(p.animSpeed*100); updateSliderTrack('animSpeedSlider'); }
    const asv = document.getElementById('animSpeedVal');
    if(asv) asv.textContent = p.animSpeed.toFixed(2).replace(/\.?0+$/, '') + '×';
  }

  // Highlight active card
  document.querySelectorAll('.cin-preset-card').forEach(c=>c.classList.toggle('active',c.dataset.preset===id));

  updatePreview();
  showToast(`✨ "${p.name}" applied`,'success');
}

function updateAnimSpeed(el){
  state.animSpeed = el.value / 100;
  const label = state.animSpeed.toFixed(2).replace(/\.?0+$/, '') + '×';
  document.getElementById('animSpeedVal').textContent = label;
  updateSliderTrack(el.id);
  if(state.voiceLinked) syncVoiceToAnimSpeed(state.animSpeed);
  updatePreview();
}

// Map animSpeed (0.25–4.0) → vRate (-20..+20 %) and vSpeed (80..125)
function syncVoiceToAnimSpeed(spd){
  const newRate  = Math.max(-20, Math.min(20, Math.round((spd - 1) * 13)));
  const newSpeed = Math.max(80,  Math.min(125, Math.round(100 + (spd - 1) * 18)));

  // Update slider elements
  const rateEl  = document.getElementById('vRate');
  const speedEl = document.getElementById('vSpeed');
  if(rateEl){
    rateEl.value = String(newRate);
    document.getElementById('vRateVal').textContent = (newRate > 0 ? '+' : '') + newRate + '%';
    updateSliderTrack('vRate');
    voiceSliders.rate = newRate;
  }
  if(speedEl){
    speedEl.value = String(newSpeed);
    document.getElementById('vSpeedVal').textContent = (newSpeed / 100).toFixed(2) + 'x';
    updateSliderTrack('vSpeed');
    voiceSliders.speed = newSpeed;
  }
}

function toggleVoiceLink(){
  state.voiceLinked = !state.voiceLinked;
  const btn = document.getElementById('voiceLinkBtn');
  if(state.voiceLinked){
    btn.textContent = '🔗';
    btn.style.background = 'rgba(124,58,237,.25)';
    btn.style.borderColor = 'var(--purple)';
    btn.title = 'Voice speed linked to animation speed (click to unlink)';
    syncVoiceToAnimSpeed(state.animSpeed);
    showToast('🔗 Voice speed linked to animation speed','info');
  } else {
    btn.textContent = '🔓';
    btn.style.background = 'rgba(255,255,255,.04)';
    btn.style.borderColor = 'var(--border)';
    btn.title = 'Voice speed unlinked (click to link)';
    showToast('🔓 Voice speed unlinked','info');
  }
}

// ═══════════════════════════════════════════════════════════════════
// PREVIEW
// ═══════════════════════════════════════════════════════════════════

// Mirrors getColorGradeFilter() in TrendVaultVideo.tsx exactly.
// Each grade lists its FULLY-APPLIED filter values; intensity 0-100 lerps from
// neutral (1 for brightness/contrast/saturate, 0 for sepia/invert/hue-rotate)
// toward these targets so the slider mixes between original and full effect.
const GRADE_FILTERS = {
  none:      {},
  dark:      { brightness:0.65, contrast:1.15, saturate:0.85 },
  blue:      { brightness:0.75, saturate:0.6,  hueRotate:200, contrast:1.1 },
  warm:      { brightness:0.85, sepia:0.35,    saturate:1.25 },
  purple:    { brightness:0.7,  hueRotate:270, saturate:0.7, contrast:1.1 },
  teal:      { brightness:0.8,  hueRotate:155, saturate:0.75, contrast:1.05 },
  crimson:   { brightness:0.72, hueRotate:345, saturate:1.4, contrast:1.15 },
  mono:      { brightness:0.7,  saturate:0,    contrast:1.2 },
  analog:    { saturate:0,      contrast:1.45, brightness:0.58 },
  nightmare: { saturate:0,      contrast:1.75, brightness:0.42 },
  liminal:   { saturate:0.22,   hueRotate:188, contrast:1.15, brightness:0.68 },
  bloom:     { brightness:1.08, saturate:1.18, contrast:0.92 },
  sepia:     { sepia:1,         saturate:1.3,  brightness:0.95 },
  invert:    { invert:1,        hueRotate:180 },
  cyber:     { saturate:2,      hueRotate:280, contrast:1.3,  brightness:0.9 },
  neon:      { saturate:2.2,    contrast:1.3,  brightness:1.05 },
  faded:     { saturate:0.55,   contrast:0.85, brightness:1.1 },
  vintage:   { sepia:0.55,      saturate:0.7,  contrast:0.92, brightness:0.95 },
  dreamy:    { brightness:1.15, saturate:0.85, contrast:0.88 },
  sunset:    { hueRotate:340,   saturate:1.4,  brightness:0.95, contrast:1.05 },
  forest:    { hueRotate:80,    saturate:0.85, brightness:0.75, contrast:1.05 },
  lavender:  { hueRotate:300,   saturate:0.7,  brightness:1.0,  contrast:0.95 },
  cold:      { hueRotate:200,   saturate:0.7,  brightness:0.85, contrast:1.05 },
  heat:      { hueRotate:5,     saturate:1.5,  brightness:0.95, contrast:1.1 },
  toxic:     { hueRotate:75,    saturate:1.6,  brightness:0.85, contrast:1.15 },
  bleach:    { saturate:0.3,    contrast:1.4,  brightness:1.0 },
  frost:     { hueRotate:185,   saturate:0.4,  brightness:1.05, contrast:1.0 },
  cherry:    { hueRotate:340,   saturate:1.6,  brightness:0.85, contrast:1.15 },
  emerald:   { hueRotate:120,   saturate:1.2,  brightness:0.7,  contrast:1.15 },
  obsidian:  { saturate:0.3,    brightness:0.45, contrast:1.5,  hueRotate:215 },
  peach:     { hueRotate:355,   saturate:0.85, brightness:1.05, sepia:0.2 },
  ash:       { saturate:0.15,   brightness:0.85, contrast:1.05 },
  dusk:      { hueRotate:215,   saturate:0.95, brightness:0.7,  contrast:1.15 },
  ember:     { hueRotate:15,    saturate:1.3,  brightness:0.55, contrast:1.25 },
};

function getColorGradeFilterCSS(grade, intensity){
  const t = Math.max(0, Math.min(100, intensity ?? 100)) / 100;
  if(t === 0) return 'brightness(1)';
  const lerp = (def, target) => def + (target - def) * t;
  const f = GRADE_FILTERS[grade] || {};
  const parts = [];
  if(f.brightness !== undefined) parts.push(`brightness(${lerp(1, f.brightness).toFixed(3)})`);
  if(f.contrast   !== undefined) parts.push(`contrast(${lerp(1, f.contrast).toFixed(3)})`);
  if(f.saturate   !== undefined) parts.push(`saturate(${lerp(1, f.saturate).toFixed(3)})`);
  if(f.sepia      !== undefined) parts.push(`sepia(${lerp(0, f.sepia).toFixed(3)})`);
  if(f.invert     !== undefined) parts.push(`invert(${lerp(0, f.invert).toFixed(3)})`);
  if(f.hueRotate  !== undefined) parts.push(`hue-rotate(${lerp(0, f.hueRotate).toFixed(1)}deg)`);
  return parts.join(' ') || 'brightness(1)';
}

// ── Timing source-of-truth hash ───────────────────────────────────────────────
// Anything that changes audio duration or text alignment goes into this hash.
// When `state.previewSyncedHash !== getTimingHash()` we tell the user the
// preview audio is stale and needs regenerating. This is the lightweight
// "one timing model" from Phase 1 — full per-word recompute happens only on
// explicit Generate Voice Preview.
function getTimingHash(){
  const scriptText = (state.script || []).map(l => (l?.text || '').trim()).join('||');
  // Cinematic-slider overrides live in the module-level `voiceSliders` const,
  // NOT on `state` — the previous reference to `state.voiceSliders` was always
  // undefined, so slider tweaks were silently invisible to the staleness check.
  // Stringify the actual map so any change flips the hash. We also include the
  // ElevenLabs model id and Fish pitch/normalize so changing those mid-session
  // invalidates the preview properly (matches the server-side voiceKey).
  let sliderBlob = '';
  try { sliderBlob = (typeof voiceSliders === 'object' && voiceSliders) ? JSON.stringify(voiceSliders) : ''; }
  catch { sliderBlob = ''; }
  const voiceKey = [
    state.voiceEngine || 'auto',
    state.voice || '',
    state.fishVoice || '',
    state.fishSpeed ?? 1,
    state.fishTemp ?? 0,
    state.fishPitch ?? 0,
    state.fishNormalize ?? '',
    state.elVoice?.voiceId || '',
    state.elVoice?.modelId || '',
    state.elVoice?.stability ?? '',
    state.elVoice?.similarity ?? '',
    state.elVoice?.style ?? '',
    state.elVoice?.speakerBoost ?? '',
    sliderBlob,
  ].join('|');
  let h = 0;
  const s = scriptText + '###' + voiceKey;
  for(let i = 0; i < s.length; i++) h = ((h << 5) - h + s.charCodeAt(i)) | 0;
  return String(h);
}

function refreshTimingBadge(){
  const status = document.getElementById('voicePreviewStatus');
  if(!status) return;
  const hasAudio = !!(state.previewAudioUrl && state.previewCaptions?.length);
  if(!hasAudio) return; // initial "no preview audio yet" message stays
  const live = getTimingHash();
  const synced = state.previewSyncedHash;
  if(synced && live !== synced){
    // Don't clobber an in-progress message
    if(/⏳|requesting/i.test(status.textContent || '')) return;
    status.textContent = '✱ Preview stale — regenerate voice to resync';
    status.style.color = '#fbbf24';
  }
}

// ── Dirty-state machine (Phase 3) ───────────────────────────────────────────
// Single entry point: markDirty('script') / markDirty('voice') / etc. Every
// flag downstream of the input is automatically marked dirty, so the rest of
// the UI doesn't have to know the topology.
function markDirty(reason){
  if(reason === 'script'){
    state.scriptDirty  = true;
    state.timingDirty  = true;
    state.previewDirty = true;
    state.renderDirty  = true;
  } else if(reason === 'voice'){
    state.voiceDirty   = true;
    state.timingDirty  = true;
    state.previewDirty = true;
    state.renderDirty  = true;
  } else if(reason === 'timing'){
    state.timingDirty  = true;
    state.previewDirty = true;
    state.renderDirty  = true;
  } else if(reason === 'render'){
    state.renderDirty  = true;
  }
  refreshDirtyBadges();
}

function clearDirty(reason){
  if(reason === 'preview'){
    state.scriptDirty  = false;
    state.voiceDirty   = false;
    state.timingDirty  = false;
    state.previewDirty = false;
    // Render still needs payload rebuild — caller marks renderDirty=false too
  } else if(reason === 'render'){
    state.renderDirty  = false;
  }
  refreshDirtyBadges();
}

function refreshRenderSyncPanel(){
  const prov = document.getElementById('rsProvider');
  const file = document.getElementById('rsAudioFile');
  const dur  = document.getElementById('rsAudioDur');
  const fdur = document.getElementById('rsFinalDur');
  const ln   = document.getElementById('rsLines');
  const st   = document.getElementById('rsSyncStatus');
  if(!prov || !file || !dur || !fdur || !ln || !st) return;
  const t = state.previewTiming;
  if(!t){
    prov.textContent = file.textContent = dur.textContent = fdur.textContent = ln.textContent = '—';
    st.innerHTML = 'Sync: <strong style="color:#fca5a5">no preview yet</strong>';
    return;
  }
  // Provider label: prefer the timing object's recorded provider but fall back
  // to activeTimelineProvider if for any reason the timing object is missing it.
  prov.textContent = (t.provider || state.activeTimelineProvider || '—');
  file.textContent = (t.audioFile || '—').slice(0, 36);
  dur.textContent  = (t.actualAudioDurationSeconds || 0).toFixed(2) + 's';
  // Compute final duration the same way the server will
  const mode  = state.durationMode || 'autoVoice';
  const force = !!state.forceTargetDuration;
  const target = state.targetDurationSec || 0;
  const finalDur = (mode === 'fixed' || (force && target > 0)) ? target : (t.actualAudioDurationSeconds || 0);
  fdur.textContent = finalDur.toFixed(2) + 's' + ((mode === 'fixed') ? ' (fixed)' : (force ? ' (forced)' : ' (auto)'));
  ln.textContent   = (t.lines?.length || 0).toString();
  const liveHash = getTimingHash();
  const inSync = liveHash === state.previewSyncedHash;
  st.innerHTML = inSync
    ? 'Sync: <strong style="color:#86efac">✓ preview matches current script + voice</strong>'
    : 'Sync: <strong style="color:#fbbf24">✱ stale — regenerate preview before render</strong>';
}
window.refreshRenderSyncPanel = refreshRenderSyncPanel;

function refreshDirtyBadges(){
  const line = document.getElementById('dirtyBadgesLine');
  // Render sync panel reads the same flags
  refreshRenderSyncPanel();
  if(!line) return;
  const dot = (on, color, label, title) => {
    const c = on ? color : '#52525b';
    return `<span title="${title}" style="display:inline-flex;align-items:center;gap:3px;margin-right:8px"><span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${c}"></span>${label}</span>`;
  };
  line.innerHTML =
    dot(state.scriptDirty,  '#fbbf24', 'script',  'Script text changed since last preview') +
    dot(state.voiceDirty,   '#fbbf24', 'voice',   'Voice/provider/settings changed since last preview') +
    dot(state.timingDirty,  '#fbbf24', 'timing',  'Timing JSON out of date') +
    dot(state.previewDirty, '#fbbf24', 'preview', 'Preview audio is stale — regenerate to resync') +
    dot(state.renderDirty,  '#fbbf24', 'render',  'Render payload would be rebuilt before next render');
}
window.markDirty        = markDirty;
window.clearDirty       = clearDirty;
window.refreshDirtyBadges = refreshDirtyBadges;

// ── Voice-Only Sample System (Phase 1/5) ─────────────────────────────────────
// Sample audio lives entirely separate from timeline audio. The sample player
// uses its own audio element (#voiceSampleAudio); the timeline player uses
// _previewAudioEl. They can NEVER share state — that was the user's #1
// confusion ("Fish sample doesn't play / Fish doesn't become timeline voice").
const VOICE_SAMPLE_TEXT = 'This is how this voice will sound in your video.';
let _voiceSampleGenSeq = 0;
let _voiceSampleInFlight = false;

function _resolveVoiceName(){
  if(state.voiceEngine === 'fish-speech'){
    const sel = document.getElementById('fishVoiceSelect');
    return sel?.options?.[sel.selectedIndex]?.text || state.fishVoice || 'Fish Voice';
  }
  if(state.voiceEngine === 'elevenlabs'){
    const sel = document.getElementById('elVoiceSelect');
    return sel?.options?.[sel.selectedIndex]?.text || 'ElevenLabs Voice';
  }
  return state.voice || state.voiceEngine || 'Voice';
}

async function previewVoiceOnlySample(){
  // Phase 9 short-circuit: refuse to ask Fish for a sample when bridge is
  // GPU-broken — that's what triggered the OOM in the first place.
  if(state.voiceEngine === 'fish-speech' && state.fishState &&
     ['gpu_oom_restart_required','cuda_crashed','test_generation_timeout'].includes(state.fishState)){
    _setSampleStatus('✗ Fish Speech is GPU-broken — restart Fish Speech API window, then ⟲ MARK RESTARTED.', '#f87171');
    return;
  }
  if(_voiceSampleInFlight){ showToast('Already generating a sample — wait for it to finish','info'); return; }
  if(state.voiceEngine === 'elevenlabs' && !state.elVoice?.voiceId){
    _setSampleStatus('✗ Voice ID missing. Pick an ElevenLabs voice first.', '#f87171');
    return;
  }

  const btn = document.getElementById('voiceSamplePreviewBtn');
  const audioEl = document.getElementById('voiceSampleAudio');
  const provLabel = document.getElementById('voiceSampleProvider');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Generating sample…'; }
  _voiceSampleInFlight = true;
  const myGen = ++_voiceSampleGenSeq;
  const isStale = () => myGen !== _voiceSampleGenSeq;

  _setSampleStatus('⏳ generating a short sample…', 'var(--muted)');

  try {
    const body = {
      scriptLines: [{ text: VOICE_SAMPLE_TEXT, type: 'observation' }],
      voiceEngine: state.voiceEngine || 'auto',
      voice: Object.assign(getVoiceParams(), {
        fishVoice:     state.fishVoice     ?? 'dark_narrator',
        fishSpeed:     state.fishSpeed     ?? 1.0,
        fishTemp:      state.fishTemp      ?? 0.70,
        fishPitch:     state.fishPitch     ?? 0,
        fishNormalize: state.fishNormalize !== false,
      }),
    };
    const r = await fetch(`${API_BASE}/api/trend-vault/voice-preview`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify(body),
      signal: AbortSignal.timeout(120_000),
    });
    const data = await r.json();
    if(isStale()) return;  // user clicked again — drop this result
    if(!data.ok) throw new Error(data.error || 'sample generation failed');

    // Probe the audio in-browser BEFORE we call it ready
    if(!audioEl) throw new Error('voiceSampleAudio element missing');
    audioEl.style.display = 'block';
    const probeUrl = new URL(data.audioUrl, location.href).href;
    audioEl.src = probeUrl;
    audioEl.load();
    await new Promise((resolve, reject) => {
      const onMeta = () => { cleanup(); resolve(); };
      const onErr  = () => { cleanup(); reject(new Error('browser could not load audio: ' + probeUrl)); };
      const cleanup = () => {
        audioEl.removeEventListener('loadedmetadata', onMeta);
        audioEl.removeEventListener('error', onErr);
      };
      audioEl.addEventListener('loadedmetadata', onMeta);
      audioEl.addEventListener('error', onErr);
      setTimeout(() => { cleanup(); reject(new Error('audio metadata timeout (15s)')); }, 15000);
    });
    if(isStale()) return;

    const voiceName = _resolveVoiceName();
    state.voiceSample = {
      provider:        data.resolvedEngine || state.voiceEngine || 'auto',
      voiceId:         state.elVoice?.voiceId || state.fishVoice || state.voice || null,
      voiceName,
      audioUrl:        data.audioUrl,
      durationSeconds: audioEl.duration || data.audioDurationSec || 0,
      isPlayable:      true,
      error:           null,
      generatedAt:     new Date().toISOString(),
    };
    if(provLabel) provLabel.textContent = `${voiceName} · ${state.voiceSample.durationSeconds.toFixed(2)}s · via ${state.voiceSample.provider}`;
    _setSampleStatus(`✓ sample ready — press ▶ in the player above to listen.`, 'var(--gold2)');
    // Try to play; if autoplay blocked, the controls=true audio element will still let the user click play.
    audioEl.play().catch(() => {
      _setSampleStatus(`✓ sample ready — click ▶ in the player above (your browser blocked autoplay).`, 'var(--gold2)');
    });
  } catch(e) {
    if(isStale()) return;
    state.voiceSample = { provider:state.voiceEngine, voiceId:null, voiceName:_resolveVoiceName(),
                          audioUrl:null, durationSeconds:0, isPlayable:false, error:e?.message||String(e),
                          generatedAt:new Date().toISOString() };
    if(audioEl){ audioEl.style.display = 'none'; audioEl.removeAttribute('src'); }
    _setSampleStatus('✗ ' + (e?.message || e), '#f87171');
    showToast('Voice sample failed: ' + (e?.message || e), 'error');
  } finally {
    if(myGen === _voiceSampleGenSeq){
      _voiceSampleInFlight = false;
      if(btn){ btn.disabled = false; btn.textContent = '🔊 Preview Voice Only'; }
    }
  }
}

function useVoiceInTimeline(){
  // The sample is optional — the user may have already heard the voice
  // outside the app, or trust the engine choice. We allow promotion without
  // a sample, but warn if the last sample failed.
  if(state.voiceSample && state.voiceSample.isPlayable === false){
    if(!confirm('The last sample failed to play. Promote this voice to the timeline anyway?')) return;
  }
  state.activeTimelineProvider = state.voiceEngine || 'auto';
  markDirty('voice');
  // Invalidate timeline audio so the next play can't reuse old-provider audio
  state.previewAudioUrl   = null;
  state.previewCaptions   = null;
  state.previewSyncedHash = null;
  state.previewTiming     = null;
  state.previewAudioDurationSec = 0;

  const status = document.getElementById('voicePreviewStatus');
  if(status){ status.textContent = `voice promoted — press 🎙 Generate Voice Preview to make the full timeline audio (${state.activeTimelineProvider})`; status.style.color = 'var(--gold2)'; }
  _setSampleStatus(`✓ "${_resolveVoiceName()}" is now the active timeline voice. Press 🎙 Generate Voice Preview to build the full audio.`, '#86efac');
  showToast(`Voice applied: ${_resolveVoiceName()} (${state.activeTimelineProvider}) — generate the timeline next`, 'success');
  refreshRenderSyncPanel?.();
}

function _setSampleStatus(text, color){
  const el = document.getElementById('voiceSampleStatus');
  if(!el) return;
  el.textContent = text;
  if(color) el.style.color = color;
}

window.previewVoiceOnlySample = previewVoiceOnlySample;
window.useVoiceInTimeline     = useVoiceInTimeline;

function updatePreview(){
  const overlay = document.getElementById('phoneOverlay');
  const vid     = document.getElementById('phoneBgVideo');
  const bg      = document.getElementById('phoneBg');

  // Dirty-detect: did script/voice change since the last preview audio?
  try { refreshTimingBadge(); } catch {}

  // Apply the exact same filter chain Remotion uses:
  //   colorGrade + saturate/contrast/exposure + blur + brightness
  const gradeFilter = getColorGradeFilterCSS(state.colorGrade, state.colorGradeIntensity);
  const adjFilter   = buildAdjustmentFilterCSS();
  const bgFilter    = [gradeFilter, adjFilter, `blur(${state.bgBlur}px)`, `brightness(${state.bgBrightness / 100})`].filter(Boolean).join(' ');
  if(vid) vid.style.filter = bgFilter;

  // Update Highlights / Shadows overlay layers (created lazily on first use)
  applyToneOverlay(state.highlights ?? 0, state.shadows ?? 0);

  // Sync caption position from state (in case it was set programmatically,
  // e.g. by a preset). Drag updates `state.captionTopPct` directly via onUp.
  if(state.captionTopPct != null){
    const wrap = document.getElementById('phoneCaptionWrap');
    const phone = document.getElementById('phoneFrame');
    if(wrap && phone){
      const phoneH = phone.offsetHeight || 1;
      const targetTop = (state.captionTopPct / 100) * phoneH;
      // Only update if the user isn't currently mid-drag
      if(!wrap.classList.contains('dragging')){
        wrap.style.bottom = '';
        wrap.style.top = targetTop + 'px';
      }
    }
  }

  // For solid-colour background (no video), show a subtle colour tint overlay
  // that mirrors Remotion's per-grade colour overlay (purple/blue/warm only)
  const solidTints = {
    purple: 'radial-gradient(ellipse at 50% 30%,rgba(80,20,120,.4) 0%,transparent 70%)',
    blue:   'radial-gradient(ellipse at 50% 30%,rgba(20,40,120,.4) 0%,transparent 70%)',
    warm:   'radial-gradient(ellipse at 50% 30%,rgba(120,60,20,.4) 0%,transparent 70%)',
  };
  bg.style.background = (!state.background || state.background==='none')
    ? (solidTints[state.colorGrade] || 'linear-gradient(160deg,#0a0614 0%,#060409 40%,#0b0a18 100%)')
    : 'none';

  // Fixed bottom-to-top readability gradient — matches Remotion's constant overlay
  overlay.style.background = 'linear-gradient(to top,rgba(0,0,0,.88) 0%,rgba(0,0,0,.2) 35%,rgba(0,0,0,.05) 60%,rgba(0,0,0,.25) 100%)';

  // Grain effect on canvas
  drawPhoneGrain();

  // Caption — animated
  const cap = document.getElementById('phoneCaption');
  const line = state.script[state.previewLineIdx];
  const captionText = line?.text || (state.promptText || 'Generate a script to preview here.');
  const lineDurMs   = ((line?.durationSeconds || 4) * 1000);
  cap.style.fontFamily = state.fontFamily;
  cap.style.fontSize   = Math.max(0.75, (state.fontSize/68)*1.1)+'rem';
  cap.style.color      = state.textColor;
  applyTextFormatToElement(cap);
  playCaptionAnim(cap, captionText, state.textAnimation || 'fade', lineDurMs, state.animSpeed ?? 1.0);

  // Caption rotation
  cap.style.transform = (state.captionRotate || 0) !== 0 ? `rotate(${state.captionRotate}deg)` : '';

  // Caption background style (TikTok white-box, dark box, yellow box)
  const capWrap = document.getElementById('phoneCaptionWrap');
  switch(state.captionBgStyle || 'none'){
    case 'white':
      cap.style.background   = 'rgba(255,255,255,0.95)';
      cap.style.color        = '#000000';
      cap.style.padding      = '5px 12px';
      cap.style.borderRadius = '6px';
      cap.style.textShadow   = 'none';
      cap.style.display      = 'inline-block';
      if(capWrap) capWrap.style.textAlign = 'center';
      break;
    case 'dark':
      cap.style.background   = 'rgba(0,0,0,0.72)';
      cap.style.padding      = '5px 12px';
      cap.style.borderRadius = '6px';
      cap.style.display      = 'inline-block';
      if(capWrap) capWrap.style.textAlign = 'center';
      break;
    case 'yellow':
      cap.style.background   = '#ffe500';
      cap.style.color        = '#000000';
      cap.style.padding      = '5px 12px';
      cap.style.borderRadius = '6px';
      cap.style.textShadow   = 'none';
      cap.style.display      = 'inline-block';
      if(capWrap) capWrap.style.textAlign = 'center';
      break;
    default:
      cap.style.background   = '';
      cap.style.padding      = '';
      cap.style.borderRadius = '';
      cap.style.display      = '';
      if(capWrap) capWrap.style.textAlign = '';
  }

  // Vignette (bg already declared at top of updatePreview)
  if(state.vignette) bg.style.boxShadow='inset 0 0 80px rgba(0,0,0,.8)';
  else bg.style.boxShadow='none';

  // Keep timeline in sync
  refreshTimelineSlider();
}

function drawPhoneGrain(){
  const canvas = document.getElementById('phoneGrain');
  if(!canvas)return;
  const ctx = canvas.getContext('2d');
  const intensity = state.grainIntensity/100;
  if(intensity===0||state.grainType==='none'){ ctx.clearRect(0,0,canvas.width,canvas.height); return; }
  const imageData = ctx.createImageData(canvas.width,canvas.height);
  // Fast LCG (Linear Congruential Generator) replaces Math.sin per pixel.
  // Previously: Math.abs(Math.sin(seed*(i+1)*0.0001)*255) — ~180 K trig calls
  // per frame at typical canvas size, causing CPU spikes every 120ms.
  // LCG: next = (a*prev + c) & 0xFFFFFFFF — produces uniform distribution with
  // negligible cost and visually identical noise texture for grain purposes.
  const alpha = Math.floor(intensity*80);
  let rng = (Date.now() * 1664525 + 1013904223) & 0x7FFFFFFF;
  for(let i=0;i<imageData.data.length;i+=4){
    rng = (rng * 1664525 + 1013904223) & 0x7FFFFFFF;
    const val = rng & 0xFF;
    imageData.data[i]=val; imageData.data[i+1]=val; imageData.data[i+2]=val;
    imageData.data[i+3]=alpha;
  }
  ctx.putImageData(imageData,0,0);
}

// ── Preview controls — audio-driven when a voice preview has been built ────
// Every button below moves ONE clock. When state.previewCaptions exists, the
// clock is the <audio> element's currentTime; otherwise we fall back to the
// line-index legacy behavior so the studio still works without TTS.
function _hasAudio(){ return !!(state.previewAudioUrl && state.previewCaptions?.length); }
function _audioJumpToLine(lineIdx){
  if(!_previewAudioEl) return;
  const c = state.previewCaptions[Math.max(0, Math.min(state.previewCaptions.length-1, lineIdx))];
  if(c) _previewAudioEl.currentTime = c.start;
}

function prevLine(){
  if(!state.script.length)return;
  if(_hasAudio()){
    const idx = Math.max(0, state.previewLineIdx-1);
    _audioJumpToLine(idx);
    state.previewLineIdx = idx;
    updatePreview(); refreshTimelineSlider();
    return;
  }
  stopPlayPreview();
  state.previewLineIdx = Math.max(0, state.previewLineIdx-1);
  updatePreview(); refreshTimelineSlider();
}

function nextLine(){
  if(!state.script.length)return;
  if(_hasAudio()){
    const idx = Math.min(state.script.length-1, state.previewLineIdx+1);
    _audioJumpToLine(idx);
    state.previewLineIdx = idx;
    updatePreview(); refreshTimelineSlider();
    return;
  }
  stopPlayPreview();
  state.previewLineIdx = Math.min(state.script.length-1, state.previewLineIdx+1);
  updatePreview(); refreshTimelineSlider();
}

function seekRelative(delta){
  if(!state.script.length)return;
  if(_hasAudio() && _previewAudioEl){
    // Audio mode: seek by 1 second per delta unit
    const t = Math.max(0, Math.min(state.previewAudioDurationSec,
                                   _previewAudioEl.currentTime + delta));
    _previewAudioEl.currentTime = t;
    state.previewLineIdx = _findCaptionIndexForTime(state.previewCaptions, t);
    updatePreview(); refreshTimelineSlider();
    return;
  }
  stopPlayPreview();
  state.previewLineIdx = Math.min(state.script.length-1, Math.max(0, state.previewLineIdx+delta));
  updatePreview(); refreshTimelineSlider();
}

// Reset to the start — used by a (new) ⟲ restart button if you want, and by
// 'R' key when bound. Stops playback and rewinds to t=0.
function restartPreview(){
  if(!state.script.length) return;
  if(_hasAudio() && _previewAudioEl){
    _previewAudioEl.currentTime = 0;
    state.previewLineIdx = 0;
    if(!_previewAudioEl.paused){
      // keep playing from 0
      const bar = document.querySelector('.phone-progress');
      if(bar) bar.style.width = '0%';
    }
    updatePreview(); refreshTimelineSlider();
    return;
  }
  stopPlayPreview();
  state.previewLineIdx = 0;
  updatePreview(); refreshTimelineSlider();
}

// ── Preview playback (auto-advance through script lines) ──────────────────────
let _previewPlayInterval = null;
let _previewPlayElapsed  = 0; // ms since current line started

// ── Audio-driven preview state ────────────────────────────────────────────────
// When the user clicks "Generate Voice Preview" the canonical timed-captions
// JSON (the EXACT same shape and timeline the renderer will use) is cached
// here. Once cached, the play button switches to audio-driven mode so what
// you see in preview matches the final MP4 frame-for-frame.
state.previewAudioUrl         = null;
state.previewAudioDurationSec = 0;
state.previewCaptions         = null; // TimedCaption[]: {start,end,duration,text,wordCount,...}
let _previewAudioEl  = null;
let _previewAudioRAF = null;
// ── Phase 1/3: generation race protection ───────────────────────────────────
// Each Generate Voice click increments _previewGenerationSeq. Only the response
// from the LATEST generation is allowed to write to state. Older responses
// (e.g. a slow ElevenLabs call that finishes after the user already started a
// faster Edge generation) are dropped without touching state.previewAudioUrl.
let _previewGenerationSeq = 0;
let _previewGenerationInFlight = false;

async function generateVoicePreview(){
  if(!state.script?.length){ showToast('Generate a script first','info'); return; }
  if(_previewGenerationInFlight){
    showToast('Already generating — wait for it to finish', 'info');
    return;
  }
  // Phase: if Fish is the active engine and the bridge says it's
  // GPU-broken, block immediately instead of triggering yet another request
  // into a hung process. Suggest a clear next step.
  if(state.voiceEngine === 'fish-speech' && state.fishHealth){
    const fs = state.fishState;
    if(fs === 'gpu_oom_restart_required' || fs === 'cuda_crashed' || fs === 'test_generation_timeout'){
      showToast('Fish Speech is GPU-broken — restart the Fish Speech API window then press ⟲ MARK RESTARTED. Or switch to ✨ ElevenLabs / ☁ Edge TTS.', 'error');
      return;
    }
  }
  const btn = document.getElementById('voicePreviewBtn');
  const status = document.getElementById('voicePreviewStatus');
  if(btn){ btn.disabled = true; btn.textContent = '⏳ Generating…'; }
  _previewGenerationInFlight = true;
  const myGen = ++_previewGenerationSeq;
  const isStale = () => myGen !== _previewGenerationSeq;
  if(status) status.textContent = 'requesting voice from server…';
  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/voice-preview`,{
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        scriptLines: state.script.map(l => ({ text: l.text, type: l.type, durationSeconds: l.durationSeconds })),
        voice: Object.assign(getVoiceParams(), {
          fishVoice:     state.fishVoice     ?? 'dark_narrator',
          fishSpeed:     state.fishSpeed     ?? 1.0,
          fishTemp:      state.fishTemp      ?? 0.70,
          fishPitch:     state.fishPitch     ?? 0,
          fishNormalize: state.fishNormalize !== false,
        }),
        voiceEngine: state.voiceEngine ?? 'auto',
      }),
    });
    const data = await r.json();
    if(!data.ok) throw new Error(data.error || 'voice preview failed');

    // ── Race guard: drop this response if a newer generation has started ──
    if(isStale()){
      console.log('[VOICE-PREVIEW] dropping stale response (gen ' + myGen + ' < ' + _previewGenerationSeq + ')');
      return;  // finally{} will reset the button if needed
    }

    state.previewAudioUrl         = data.audioUrl;
    state.previewAudioDurationSec = data.audioDurationSec;
    state.previewCaptions         = data.captions;
    state.previewSyncedHash       = getTimingHash();
    state.lastResolvedEngine      = data.resolvedEngine || state.voiceEngine;
    state.previewTiming           = data.timing || null;  // canonical timing object
    // Phase 8: tag timeline audio with the provider that actually made it.
    // If activeTimelineProvider was set via Use This Voice In Timeline, use
    // that; otherwise fall back to the engine that resolved server-side.
    state.activeTimelineProvider  = state.activeTimelineProvider || data.resolvedEngine || state.voiceEngine;
    clearDirty('preview');
    refreshDurationBadge();
    refreshRenderSyncPanel();

    // ── Phase 1: prove the audio is actually playable in this browser ───────
    // Bug fix: the old code marked the preview "ready" the moment the server
    // returned. If the file URL 404'd or the MP3 was malformed, the next ▶
    // press would silently fail. Now we preload + wait for metadata BEFORE we
    // call the preview ready and apply timings.
    try {
      await new Promise((resolve, reject) => {
        if(!_previewAudioEl){
          _previewAudioEl = new Audio();
          _previewAudioEl.preload = 'auto';
        }
        const probeUrl = new URL(data.audioUrl, location.href).href;
        const onMeta = () => {
          _previewAudioEl.removeEventListener('loadedmetadata', onMeta);
          _previewAudioEl.removeEventListener('error', onErr);
          resolve();
        };
        const onErr = () => {
          _previewAudioEl.removeEventListener('loadedmetadata', onMeta);
          _previewAudioEl.removeEventListener('error', onErr);
          reject(new Error('audio failed to load (' + probeUrl + ')'));
        };
        _previewAudioEl.addEventListener('loadedmetadata', onMeta);
        _previewAudioEl.addEventListener('error', onErr);
        _previewAudioEl.src = probeUrl;
        _previewAudioEl.load();
        setTimeout(() => reject(new Error('audio metadata timeout after 15s')), 15000);
      });
      // Cross-check: browser duration should be within 0.5s of server duration
      const browserDur = _previewAudioEl.duration;
      if(Math.abs(browserDur - data.audioDurationSec) > 0.5){
        console.warn('[VOICE-PREVIEW] duration mismatch: server=' + data.audioDurationSec + 's browser=' + browserDur + 's');
        state.previewAudioDurationSec = browserDur;  // browser wins
      }
    } catch(probeErr) {
      // Hard fail — clear state so render is blocked
      state.previewAudioUrl   = null;
      state.previewCaptions   = null;
      state.previewSyncedHash = null;
      state.previewAudioDurationSec = 0;
      throw new Error('Server returned audio but it could not play: ' + probeErr.message);
    }

    // Apply canonical timings back onto state.script so timeline UI + caption
    // duration in updatePreview() reflect the audio-driven plan.
    data.captions.forEach((c, i) => {
      if(state.script[i]){
        state.script[i].durationSeconds = c.duration;
        state.script[i]._timed = { start: c.start, end: c.end, wordCount: c.wordCount };
      }
    });
    buildScriptLines?.();
    refreshTimelineSlider?.();
    updatePreview?.();

    if(status){
      const engLabel = data.resolvedEngine ? ` · via ${data.resolvedEngine}` : '';
      status.textContent =
        `✓ ${data.audioDurationSec.toFixed(2)}s · ${data.captions.length} captions · ${data.source}${engLabel}`;
      status.style.color = 'var(--gold2)';
    }

    // Auto-refresh ElevenLabs usage display whenever EL actually produced this
    // preview (either explicit elevenlabs engine or auto cascade resolved to it)
    if(/elevenlabs/i.test(data.resolvedEngine || '')){
      try { refreshElevenLabsUsageOnly(); } catch {}
    }

    // Client-side debug log — mirrors the server-side [VOICE-PREVIEW] block
    console.groupCollapsed(`[VOICE-PREVIEW] ${data.previewId} — synced timing built`);
    console.log('audio duration:', data.audioDurationSec.toFixed(3) + 's');
    console.log('total words:   ', data.totalWords);
    console.log('caption lines: ', data.captions.length);
    console.log('source:        ', data.source);
    console.table(data.captions.map(c => ({
      idx: c.index, start: +c.start.toFixed(3), end: +c.end.toFixed(3),
      dur: +c.duration.toFixed(3), words: c.wordCount, text: c.text.slice(0, 56),
    })));
    const lastEnd = data.captions[data.captions.length-1].end;
    const diff = lastEnd - data.audioDurationSec;
    console.log(`final caption end: ${lastEnd.toFixed(3)}s  audio: ${data.audioDurationSec.toFixed(3)}s  diff: ${diff.toFixed(3)}s`);
    console.log(Math.abs(diff) < 0.05 ? '✓ within 0.05s success window' : '⚠ drift > 0.05s');
    console.groupEnd();

    showToast('Voice preview ready — press ▶ to play with synced captions', 'success');
  }catch(e){
    if(status){ status.textContent = '⚠ ' + e.message; status.style.color = '#f87171'; }
    showToast('Voice preview failed: ' + e.message, 'error');

    // Phase 5: If the failure looks like a Fish Speech CUDA crash, clear any
    // stale audio + captions so the render is not allowed to use them, and
    // surface the restart prompt in the Fish panel.
    const msg = (e?.message || '').toLowerCase();
    if(msg.includes('cuda') || msg.includes('gpu crashed') || msg.includes('restart')){
      state.previewAudioUrl   = null;
      state.previewCaptions   = null;
      state.previewSyncedHash = null;
      state.previewAudioDurationSec = 0;
      markDirty('voice');
      refreshDurationBadge();
      checkFishSpeechStatus();
    }
  }finally{
    if(myGen === _previewGenerationSeq){
      _previewGenerationInFlight = false;
      if(btn){ btn.disabled = false; btn.textContent = '🎙 Generate Voice Preview'; }
    }
    // If we're stale, leave the button alone — the newer generation owns it.
  }
}

// Locate the caption index that contains a given timeline time (seconds).
function _findCaptionIndexForTime(captions, t){
  // Phase 2: apply Text Sync Offset. Positive ms = text appears LATER (lags voice),
  // negative ms = text appears EARLIER (leads voice). Clamped at the caller.
  const offsetSec = (state.textSyncOffsetMs || 0) / 1000;
  const tt = t - offsetSec;
  // Clamp; binary scan is fine for typical 8–25 line scripts.
  if(!captions?.length) return 0;
  if(tt <= captions[0].start) return 0;
  if(tt >= captions[captions.length-1].end) return captions.length - 1;
  for(let i = 0; i < captions.length; i++){
    if(tt >= captions[i].start && tt < captions[i].end) return i;
  }
  return captions.length - 1;
}

function togglePlayPreview(){
  // Audio-driven mode: simple pause/resume, do NOT reset position.
  if(_hasAudio() && _previewAudioEl){
    if(!_previewAudioEl.paused){
      // Pause — keep position; the bar stays where it is.
      _previewAudioEl.pause();
      if(_previewAudioRAF){ cancelAnimationFrame(_previewAudioRAF); _previewAudioRAF=null; }
      const btn = document.getElementById('playPauseBtn');
      if(btn) btn.innerHTML = '▶';
      return;
    }
    // Resume from wherever we paused — startPlayPreview honors currentTime
    startPlayPreview();
    return;
  }
  // Legacy line-index mode
  if(_previewPlayInterval) stopPlayPreview();
  else startPlayPreview();
}

function startPlayPreview(){
  if(!state.script.length){ showToast('Generate a script first','info'); return; }

  // ── Mode A: audio-driven (preferred when voice preview has been generated)
  if(state.previewAudioUrl && state.previewCaptions?.length){
    // Guard: cancel BOTH the legacy interval AND any RAF still scheduled from
    // a previous start so we never run two ticking loops simultaneously.
    // Without this, a user who clicked Play in legacy mode and then generated
    // a voice preview could end up with the legacy setInterval and the audio
    // RAF both running at the same time — racing to update previewLineIdx and
    // call updatePreview(), which causes caption flicker and text-jitter.
    if(_previewPlayInterval){ clearInterval(_previewPlayInterval); _previewPlayInterval=null; }
    if(_previewAudioRAF){ cancelAnimationFrame(_previewAudioRAF); _previewAudioRAF=null; }
    if(!_previewAudioEl){
      _previewAudioEl = new Audio();
      _previewAudioEl.preload = 'auto';
      _previewAudioEl.onended = () => {
        // End of audio — pause the loop but don't snap progress bar back.
        if(_previewAudioRAF){ cancelAnimationFrame(_previewAudioRAF); _previewAudioRAF=null; }
        const btn = document.getElementById('playPauseBtn');
        if(btn) btn.innerHTML = '▶';
      };
    }
    if(_previewAudioEl.src !== new URL(state.previewAudioUrl, location.href).href){
      _previewAudioEl.src = state.previewAudioUrl;
      _previewAudioEl.load();  // Phase 1 fix: force browser to re-fetch metadata
    }
    // Only seek to a line's start if currentTime is 0 (fresh play) — otherwise
    // resume from wherever we last paused / scrubbed to.
    if(_previewAudioEl.currentTime === 0 && state.previewLineIdx > 0){
      _previewAudioEl.currentTime = state.previewCaptions[state.previewLineIdx].start;
    }
    _previewAudioEl.play().catch(err => {
      showToast('Audio play blocked by browser: ' + err.message, 'error');
    });

    const btn = document.getElementById('playPauseBtn');
    if(btn) btn.innerHTML = '⏸';

    const tick = () => {
      if(!_previewAudioEl || _previewAudioEl.paused){
        _previewAudioRAF = null; return;
      }
      const t = _previewAudioEl.currentTime;
      const idx = _findCaptionIndexForTime(state.previewCaptions, t);
      const lineChanged = idx !== state.previewLineIdx;
      if(lineChanged){
        state.previewLineIdx = idx;
        updatePreview();
      }
      // Always refresh the slider/time-display every frame for smooth movement
      refreshTimelineSlider();
      // Update progress bar by audio progress
      const dur = state.previewAudioDurationSec || _previewAudioEl.duration || 1;
      const bar = document.querySelector('.phone-progress');
      if(bar) bar.style.width = Math.min(100, (t / dur) * 100) + '%';
      _previewAudioRAF = requestAnimationFrame(tick);
    };
    _previewAudioRAF = requestAnimationFrame(tick);
    return;
  }

  // ── Mode B: legacy timer-only fallback (no voice generated yet) ──────────
  // Guard: if a previous timer is still running, clear it before starting a
  // new one so we don't end up with two intervals racing each other.
  if(_previewPlayInterval){ clearInterval(_previewPlayInterval); _previewPlayInterval=null; }
  _previewPlayElapsed = 0;
  const btn = document.getElementById('playPauseBtn');
  if(btn) btn.innerHTML = '⏸';
  _previewPlayInterval = setInterval(()=>{
    const line = state.script[state.previewLineIdx];
    const dur  = ((line?.durationSeconds || 3) * 1000) / state.previewSpeed;
    _previewPlayElapsed += 80;
    const bar = document.querySelector('.phone-progress');
    if(bar) bar.style.width = Math.min(100, (_previewPlayElapsed/dur)*100)+'%';
    if(_previewPlayElapsed >= dur){
      _previewPlayElapsed = 0;
      if(state.previewLineIdx < state.script.length-1){
        state.previewLineIdx++;
        updatePreview(); refreshTimelineSlider();
      } else {
        state.previewLineIdx = 0;
        _previewPlayElapsed = 0;
        updatePreview(); refreshTimelineSlider();
      }
    }
  }, 80);
}

function stopPlayPreview(){
  if(_previewPlayInterval){ clearInterval(_previewPlayInterval); _previewPlayInterval=null; }
  // Halt the audio-driven loop too
  if(_previewAudioRAF){ cancelAnimationFrame(_previewAudioRAF); _previewAudioRAF=null; }
  if(_previewAudioEl && !_previewAudioEl.paused){ try{ _previewAudioEl.pause(); }catch{} }
  // Cancel any active text animations — use the unified helper so that the
  // pending per-character / per-word setTimeout queue (`_twTimeouts`) is also
  // cleared. Previously only the intervals were cleared here, which let stale
  // opacity/transform callbacks fire after pause/scrub and caused text flicker.
  if(typeof _clearAnimTimers === 'function'){
    _clearAnimTimers();
  } else {
    if(typeof _twInterval !== 'undefined' && _twInterval){ clearInterval(_twInterval); _twInterval=null; }
    if(typeof _glowInterval !== 'undefined' && _glowInterval){ clearInterval(_glowInterval); _glowInterval=null; }
  }
  const btn = document.getElementById('playPauseBtn');
  if(btn) btn.innerHTML = '▶';
  // Only reset the progress bar in legacy line-index mode — in audio mode
  // the bar reflects the actual paused position and should not jump.
  if(!_hasAudio()){
    const bar = document.querySelector('.phone-progress');
    if(bar) bar.style.width = '35%';
  }
}

// ═══════════════════════════════════════════════════════════════════
// UNDO / REDO
// ═══════════════════════════════════════════════════════════════════

const UNDO_KEYS = [
  'captionTopPct','captionRotate','captionBgStyle',
  'fontSize','fontFamily','textColor','textAnimation','animSpeed',
  'colorGrade','colorGradeIntensity','grainType','grainIntensity',
  'bgBlur','bgBrightness','saturation','contrast','exposure','highlights','shadows',
  'textBold','textItalic','textUpper','textStroke','textShadow','textGlow',
  'letterSpacing','lineHeight','vignette','fogOverlay','rainOverlay','slowZoom',
];

let _undoStack = [];
let _redoStack = [];

function _snapUndo(){
  const s = {};
  for(const k of UNDO_KEYS) s[k] = state[k];
  return s;
}

function pushUndo(){
  _undoStack.push(_snapUndo());
  if(_undoStack.length > 40) _undoStack.shift();
  _redoStack = [];
  _syncUndoBtns();
}

function _applyUndo(snap){
  for(const k of UNDO_KEYS) if(k in snap) state[k] = snap[k];
  // Sync visible sliders / labels to restored state
  const sv = (id,val)=>{ const e=document.getElementById(id); if(e){ e.value=val; updateSliderTrack(id); }};
  const st = (id,txt)=>{ const e=document.getElementById(id); if(e) e.textContent=txt; };
  sv('grainSlider',    state.grainIntensity);  st('grainVal',    state.grainIntensity+'%');
  sv('bgBlurSlider',   state.bgBlur);          st('bgBlurVal',   state.bgBlur);
  sv('bgBrightSlider', state.bgBrightness);    st('bgBrightVal', state.bgBrightness+'%');
  sv('fontSizeSlider', state.fontSize);        st('fontSizeVal', state.fontSize);
  sv('satSlider',      state.saturation);      st('satVal',      state.saturation+'%');
  sv('conSlider',      state.contrast);        st('conVal',      state.contrast+'%');
  sv('expSlider',      state.exposure);        st('expVal',      (state.exposure>0?'+':'')+state.exposure);
  sv('hlSlider',       state.highlights);      st('hlVal',       (state.highlights>0?'+':'')+state.highlights);
  sv('shSlider',       state.shadows);         st('shVal',       (state.shadows>0?'+':'')+state.shadows);
  // Layers panel sliders
  sv('captionYSlider',      state.captionTopPct ?? 50);
  sv('layerFontSlider',     state.fontSize);           st('layerFontVal',      state.fontSize);
  sv('captionRotateSlider', state.captionRotate ?? 0); st('captionRotateVal',  (state.captionRotate??0)+'°');
  // Color grade chips
  document.querySelectorAll('.grade-chip').forEach(b=>b.classList.toggle('active', b.dataset.grade===state.colorGrade));
  // Caption style buttons
  _syncCapStyleBtns(state.captionBgStyle);
  // Color intensity slider
  sv('colorIntensitySlider', state.colorGradeIntensity ?? 100); st('colorIntensityVal', (state.colorGradeIntensity ?? 100)+'%');
  // Grain type chips
  document.querySelectorAll('.effect-chip[data-grain]').forEach(c=>c.classList.toggle('active', c.dataset.grain===state.grainType));
  // Text color picker + swatches
  const _tcInput = document.getElementById('textColorInput');
  if(_tcInput) _tcInput.value = state.textColor || '#ffffff';
  document.querySelectorAll('.swatch').forEach(s=>s.classList.toggle('active', s.dataset.color===state.textColor));
  // Text format buttons
  ['Bold','Italic','Upper','Stroke','Shadow','Glow'].forEach(f=>{
    const b=document.getElementById('fmt'+f); if(b) b.classList.toggle('active', !!state['text'+f]);
  });
  // Text animation select
  const _anim = document.getElementById('textAnimSelect'); if(_anim) _anim.value = state.textAnimation || 'fade';
  // Anim speed + letter spacing + line height sliders
  sv('animSpeedSlider',     state.animSpeed      ?? 1.0);
  sv('letterSpacingSlider', state.letterSpacing  ?? 0);   st('letterSpacingVal', (state.letterSpacing ?? 0)+'px');
  sv('lineHeightSlider',    state.lineHeight     ?? 1.3);  st('lineHeightVal',    (+(state.lineHeight ?? 1.3)).toFixed(2));
  // Font cards
  document.querySelectorAll('.font-card').forEach(c=>c.classList.toggle('active', c.dataset.value===state.fontFamily));
  // Overlay checkboxes
  const _fog=document.getElementById('fogToggle');      if(_fog)  _fog.checked  = !!state.fogOverlay;
  const _rain=document.getElementById('rainToggle');    if(_rain) _rain.checked = !!state.rainOverlay;
  const _zoom=document.getElementById('zoomToggle');    if(_zoom) _zoom.checked = !!state.slowZoom;
  const _vig=document.getElementById('vignetteToggle'); if(_vig)  _vig.checked  = !!state.vignette;
  updatePreview();
}

function undo(){
  if(!_undoStack.length){ showToast('Nothing to undo','info'); return; }
  _redoStack.push(_snapUndo());
  _applyUndo(_undoStack.pop());
  _syncUndoBtns();
  showToast('↩ Undone','info');
}

function redo(){
  if(!_redoStack.length){ showToast('Nothing to redo','info'); return; }
  _undoStack.push(_snapUndo());
  _applyUndo(_redoStack.pop());
  _syncUndoBtns();
  showToast('↪ Redone','info');
}

function _syncUndoBtns(){
  const u=document.getElementById('undoBtn'), r=document.getElementById('redoBtn');
  if(u){ u.disabled=!_undoStack.length; u.style.color=_undoStack.length?'var(--text2)':'var(--muted)'; }
  if(r){ r.disabled=!_redoStack.length; r.style.color=_redoStack.length?'var(--text2)':'var(--muted)'; }
}

// Push undo on pointerdown for any visual range slider (not timeline / speed)
document.addEventListener('pointerdown', e=>{
  if(e.target.type==='range' &&
     e.target.id!=='timelineSlider' &&
     e.target.id!=='bgSpeedSlider')
    pushUndo();
}, true);

// ═══════════════════════════════════════════════════════════════════
// LAYERS PANEL
// ═══════════════════════════════════════════════════════════════════

function toggleLayersPanel(){
  const p = document.getElementById('layersPanel');
  const b = document.getElementById('layersTabBtn');
  if(!p) return;
  const open = p.style.display === 'none' || p.style.display === '';
  p.style.display = open ? 'flex' : 'none';
  if(b){
    b.style.borderColor = open ? 'var(--purple)' : 'var(--border)';
    b.style.color       = open ? 'var(--purple2)' : 'var(--muted)';
    b.textContent       = open ? '▤ Layers & Transform ▲' : '▤ Layers & Transform ▾';
  }
  if(open) _syncLayersPanel();
}

function _syncLayersPanel(){
  const sv = (id,val)=>{ const e=document.getElementById(id); if(e) e.value=val; };
  const st = (id,txt)=>{ const e=document.getElementById(id); if(e) e.textContent=txt; };
  sv('captionYSlider',      state.captionTopPct ?? 50);
  sv('layerFontSlider',     state.fontSize);       st('layerFontVal',      state.fontSize);
  sv('captionRotateSlider', state.captionRotate ?? 0); st('captionRotateVal', (state.captionRotate??0)+'°');
  _syncCapStyleBtns(state.captionBgStyle);
}

function _syncCapStyleBtns(style){
  document.querySelectorAll('.cap-style-btn').forEach(b=>{
    const on = b.dataset.style === (style||'none');
    b.style.outline      = on ? '2px solid var(--purple)' : 'none';
    b.style.outlineOffset = '2px';
  });
}

// ── Transform controls ────────────────────────────────────────────
function setCaptionY(pct){
  state.captionTopPct = pct;
  updatePreview();
}

function centerCaption(){
  pushUndo();
  state.captionTopPct = null;
  const sl = document.getElementById('captionYSlider');
  if(sl) sl.value = 50;
  updatePreview();
  showToast('Caption centered','info');
}

function setLayerFontSize(v){
  state.fontSize = v;
  document.getElementById('layerFontVal').textContent = v;
  const ms = document.getElementById('fontSizeSlider');
  if(ms){ ms.value=v; updateSliderTrack('fontSizeSlider'); }
  const mv = document.getElementById('fontSizeVal');
  if(mv) mv.textContent = v;
  updatePreview();
}

function setCaptionRotate(deg){
  state.captionRotate = deg;
  const v = document.getElementById('captionRotateVal');
  if(v) v.textContent = deg+'°';
  updatePreview();
}

function resetCaptionRotate(){
  pushUndo();
  state.captionRotate = 0;
  const sl = document.getElementById('captionRotateSlider');
  if(sl) sl.value = 0;
  const v  = document.getElementById('captionRotateVal');
  if(v)  v.textContent = '0°';
  updatePreview();
}

// ── Caption background / TikTok white-box ────────────────────────
function setCaptionBgStyle(style){
  pushUndo();
  state.captionBgStyle = style;
  _syncCapStyleBtns(style);
  // white/yellow boxes force black text for readability
  if(style === 'white' || style === 'yellow'){
    if(state.textColor === '#ffffff' || !state.textColor){
      state.textColor = '#000000';
      const tc = document.getElementById('textColorInput');
      if(tc) tc.value = '#000000';
      document.querySelectorAll('.swatch').forEach(s=>s.classList.toggle('active', s.dataset.color==='#000000'));
    }
  } else if(style === 'none' && state.textColor === '#000000'){
    state.textColor = '#ffffff';
    const tc = document.getElementById('textColorInput');
    if(tc) tc.value = '#ffffff';
    document.querySelectorAll('.swatch').forEach(s=>s.classList.toggle('active', s.dataset.color==='#ffffff'));
  }
  updatePreview();
}

// Keyboard shortcuts for preview playback
// CapCut-style keyboard shortcuts. Only fire when no input is focused.
document.addEventListener('keydown', e=>{
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA'||e.target.contentEditable==='true') return;

  // Ctrl/Cmd + key combos (capture even when modifier is held)
  if((e.ctrlKey || e.metaKey) && !e.altKey){
    if(!e.shiftKey && e.code==='KeyZ'){ e.preventDefault(); undo(); return; }
    if((e.shiftKey  && e.code==='KeyZ') || (!e.shiftKey && e.code==='KeyY')){ e.preventDefault(); redo(); return; }
    if(!e.shiftKey && e.code==='KeyS'){ e.preventDefault(); if(typeof saveDraft==='function') saveDraft(); return; }
    if(!e.shiftKey && e.code==='Enter'){ e.preventDefault(); renderVideo(); return; }
    if(!e.shiftKey && e.code==='KeyE'){ e.preventDefault(); exportToCapCut(); return; }
  }

  // Single-key shortcuts (CapCut / video editor convention)
  if(e.code==='Space'){ e.preventDefault(); togglePlayPreview(); }
  else if(e.code==='KeyJ'){ e.preventDefault(); seekRelative(-1); } // rewind
  else if(e.code==='KeyK'){ e.preventDefault(); togglePlayPreview(); } // pause
  else if(e.code==='KeyL'){ e.preventDefault(); seekRelative(1); } // forward
  else if(e.code==='ArrowRight'){ e.preventDefault(); seekRelative(1); }
  else if(e.code==='ArrowLeft'){  e.preventDefault(); seekRelative(-1); }
  else if(e.code==='ArrowUp' || e.code==='Tab' && !e.shiftKey){ /* next line via arrow up too */ }
  else if(e.code==='Tab' && e.shiftKey){ e.preventDefault(); seekRelative(-1); }
  else if(e.code==='Tab'){ e.preventDefault(); seekRelative(1); }
  // [ and ] move the caption Y position 5% at a time (preview + render)
  else if(e.code==='BracketLeft'){
    e.preventDefault();
    const cur = state.captionTopPct ?? 50;
    state.captionTopPct = Math.max(0, cur - 5);
    updatePreview();
  }
  else if(e.code==='BracketRight'){
    e.preventDefault();
    const cur = state.captionTopPct ?? 50;
    state.captionTopPct = Math.min(95, cur + 5);
    updatePreview();
  }
  // ? = show shortcut help
  else if(e.code==='Slash' && e.shiftKey){
    e.preventDefault();
    showShortcutsHelp();
  }
});

function showShortcutsHelp(){
  alert(
    'KEYBOARD SHORTCUTS\n\n' +
    'Space / K  →  Play / Pause preview\n' +
    'J / ←      →  Previous line\n' +
    'L / →      →  Next line\n' +
    'Tab        →  Next line\n' +
    'Shift+Tab  →  Previous line\n' +
    '[          →  Move caption up 5%\n' +
    ']          →  Move caption down 5%\n\n' +
    'Ctrl+S     →  Save draft\n' +
    'Ctrl+Enter →  Render video\n' +
    'Ctrl+E     →  Export to CapCut\n\n' +
    '?          →  Show this help'
  );
}

// ─── Autosave ────────────────────────────────────────────────────────────────
// Persist the working state to localStorage every 30s so a refresh / crash
// doesn't lose work. Restored on init below.
const AUTOSAVE_KEY = 'trend_vault_autosave_v1';
function autosaveSnapshot(){
  try {
    const snap = {
      sign: state.sign, signSymbol: state.signSymbol,
      category: state.category, promptId: state.promptId,
      promptText: state.promptText, promptAngle: state.promptAngle,
      tone: state.tone, script: state.script,
      voice: state.voice, background: state.background, music: state.music,
      colorGrade: state.colorGrade, colorGradeIntensity: state.colorGradeIntensity,
      grainType: state.grainType, grainIntensity: state.grainIntensity,
      fontFamily: state.fontFamily, fontSize: state.fontSize,
      textColor: state.textColor, textAnimation: state.textAnimation,
      animSpeed: state.animSpeed, voiceEngine: state.voiceEngine,
      renderFps: state.renderFps, renderQuality: state.renderQuality,
      captionTopPct: state.captionTopPct,
      saturation: state.saturation, contrast: state.contrast,
      exposure: state.exposure, highlights: state.highlights, shadows: state.shadows,
      bgBlur: state.bgBlur, bgBrightness: state.bgBrightness,
      savedAt: new Date().toISOString(),
    };
    localStorage.setItem(AUTOSAVE_KEY, JSON.stringify(snap));
  } catch { /* quota exceeded or private mode — ignore */ }
}
function autosaveRestore(){
  try {
    const raw = localStorage.getItem(AUTOSAVE_KEY);
    if(!raw) return false;
    const snap = JSON.parse(raw);
    // Only restore non-null primitives + arrays; never overwrite functions
    for (const k of Object.keys(snap)){
      if(snap[k] !== null && snap[k] !== undefined && typeof snap[k] !== 'function'){
        state[k] = snap[k];
      }
    }
    return true;
  } catch { return false; }
}
// Kick off autosave timer (every 30s)
setInterval(autosaveSnapshot, 30_000);
// Also save on tab close
window.addEventListener('beforeunload', autosaveSnapshot);

// ═══════════════════════════════════════════════════════════════════
// SLIDER TRACKS
// ═══════════════════════════════════════════════════════════════════

function updateSliderTrack(id){
  const el = document.getElementById(id);
  if(!el)return;
  const pct = ((el.value-el.min)/(el.max-el.min))*100;
  el.style.setProperty('--pct',pct+'%');
}

// ═══════════════════════════════════════════════════════════════════
// RENDER PRESETS
// ═══════════════════════════════════════════════════════════════════

const RENDER_PRESETS = {
  'tiktok':    { w:1080, h:1920, label:'1080×1920 (9:16)', fps:30 },
  'ig-reel':   { w:1080, h:1920, label:'1080×1920 (9:16)', fps:30 },
  'ig-square': { w:1080, h:1080, label:'1080×1080 (1:1)',  fps:30 },
  'yt-short':  { w:1080, h:1920, label:'1080×1920 (9:16)', fps:30 },
  'yt-wide':   { w:1920, h:1080, label:'1920×1080 (16:9)', fps:30 },
};

function selectRenderPreset(id){
  const p = RENDER_PRESETS[id];
  if(!p) return;
  state.renderWidth  = p.w;
  state.renderHeight = p.h;
  // Update resolution label
  const lbl = document.getElementById('exportResLabel');
  if(lbl) lbl.textContent = p.label;
  // Highlight active button
  document.querySelectorAll('.render-preset-btn').forEach(btn => {
    const active = btn.dataset.preset === id;
    btn.style.background = active ? 'rgba(124,58,237,.2)' : 'var(--surface2)';
    btn.style.borderColor = active ? 'var(--purple)'       : 'var(--border)';
    btn.style.color       = active ? 'var(--purple2)'      : 'var(--muted)';
  });
}

// ═══════════════════════════════════════════════════════════════════
// RENDER
// ═══════════════════════════════════════════════════════════════════

// Helper — enable/disable all four render buttons together.
// pass busy=true to lock them, busy=false to restore labels.
function _setRenderBtns(busy){
  const cfgs = [
    {id:'renderBtnEl',      label:'<span style="font-size:1rem">⚡</span> ElevenLabs'},
    {id:'renderBtnLocal',   label:'<span style="font-size:1rem">🎙</span> Local'},
    {id:'renderBtnBarEl',   label:'⚡ EL Render'},
    {id:'renderBtnBarLocal',label:'🎙 Local Render'},
  ];
  cfgs.forEach(({id,label})=>{
    const el = document.getElementById(id);
    if(!el) return;
    el.disabled = busy;
    el.innerHTML = busy ? '⏳' : label;
  });
}

async function renderVideo(engineOverride){
  if(!state.script.length){ showToast('Generate or write a script first','error'); return; }
  if(!state.sign){ showToast('Select a trend-vault sign first','error'); return; }

  // Resolve which voice engine this render will actually use.
  // 'local' means: use whatever non-ElevenLabs engine is currently selected
  // (fish-speech, local, edge, auto). Falls back to 'fish-speech' if nothing set.
  let effectiveEngine = engineOverride || state.voiceEngine || 'auto';
  if(engineOverride === 'local'){
    effectiveEngine = (state.voiceEngine && state.voiceEngine !== 'elevenlabs')
      ? state.voiceEngine : 'auto';
  }

  // ── Fish Speech pre-render guard ─────────────────────────────────────────
  if(effectiveEngine === 'fish-speech'){
    if(state.fishState && ['gpu_oom_restart_required','cuda_crashed','test_generation_timeout'].includes(state.fishState)){
      showToast('❌ Cannot render — Fish Speech is GPU-broken. Restart the Fish Speech API window, press ⟲ MARK RESTARTED, then re-generate.', 'error');
      return;
    }
    if(!state.previewTiming && !state.lastFishAudioUrl){
      const go = window.confirm('⚠ No Fish audio has been generated yet.\n\nThe render will generate new Fish audio during the render pipeline, which may fail silently.\n\nGenerate and preview Fish audio first for a safer render.\n\nContinue anyway?');
      if(!go) return;
    }
    if(state.previewTiming && state.previewTiming.provider && !state.previewTiming.provider.includes('fish')){
      const go = window.confirm(`⚠ Your current timing was built from "${state.previewTiming.provider}" audio, not Fish Speech.\n\nRendering now may mismatch captions to the Fish voice.\n\nClick OK to render anyway, or Cancel to re-preview with Fish Speech first.`);
      if(!go) return;
    }
  }

  _setRenderBtns(true);

  const panel = document.getElementById('renderProgressPanel');
  panel.style.display='block';
  document.getElementById('renderBar').style.width='0%';
  document.getElementById('renderLog').textContent='';
  document.getElementById('renderStatusText').textContent='Preparing render...';
  document.getElementById('renderStage').textContent='⚙ Starting pipeline...';

  const settings = {
    trendVaultSign:       state.sign,
    trendVaultSymbol:     state.signSymbol,
    backgroundVideo:  state.background||'none',
    backgroundBlur:   state.bgBlur,
    backgroundBrightness: state.bgBrightness/100,
    grainIntensity:   state.grainIntensity,
    grainType:        state.grainType,
    fogOverlay:       document.getElementById('fogToggle').checked,
    rainOverlay:      document.getElementById('rainToggle').checked,
    slowZoom:         document.getElementById('zoomToggle').checked,
    colorGrade:       state.colorGrade,
    colorGradeIntensity: state.colorGradeIntensity ?? 100,
    saturation:       state.saturation ?? 100,
    contrast:         state.contrast   ?? 100,
    exposure:         state.exposure   ?? 0,
    highlights:       state.highlights ?? 0,
    shadows:          state.shadows    ?? 0,
    captionTopPct:    state.captionTopPct, // null = centered default
    fps:              state.renderFps    ?? 30,
    renderQuality:    state.renderQuality ?? 'high',
    width:            state.renderWidth  ?? 1080,
    height:           state.renderHeight ?? 1920,
    voiceEngine:      effectiveEngine,
    vignette:         document.getElementById('vignetteToggle').checked,
    fontFamily:       state.fontFamily,
    fontSize:         state.fontSize,
    textColor:        state.textColor,
    textAnimation:    document.getElementById('textAnimSelect').value,
    animSpeed:        state.animSpeed ?? 1.0,
    musicFile:        state.music||'',
    musicVolume:      state.musicVolume/100,
    audioFile:        state.customAudio||'',
    // Duration policy is now an explicit user choice. In Auto mode we still
    // send the legacy "script sum + 2s" so existing renderers (sync worker)
    // continue to behave the same; in Fixed mode we send exactly the target.
    durationMode:        state.durationMode || 'autoVoice',
    // In fixed mode, durationSeconds is the hard target.
    // In autoVoice mode with forceTargetDuration, send the target so the
    // server stretches voice to fit. Otherwise send the script sum (existing
    // legacy behaviour for the sync worker).
    durationSeconds:     (state.durationMode === 'fixed'
                            ? Math.max(5, state.targetDurationSec || 30)
                            : (state.forceTargetDuration && state.targetDurationSec > 0
                                ? state.targetDurationSec
                                : state.script.reduce((s,l)=>s+l.durationSeconds,0)+2)),
    targetDurationSec:   state.targetDurationSec || 30,
    forceTargetDuration: !!state.forceTargetDuration,
    textSyncOffsetMs:    state.textSyncOffsetMs || 0,
    captionBgStyle:   state.captionBgStyle || 'none',
    captionRotate:    state.captionRotate  || 0,
    voiceVolume:      (state.voiceVolume ?? 100) / 100,
    voice:            Object.assign(getVoiceParams(), {
      fishVoice:     state.fishVoice     ?? 'dark_narrator',
      fishSpeed:     state.fishSpeed     ?? 1.0,
      fishTemp:      state.fishTemp      ?? 0.70,
      fishPitch:     state.fishPitch     ?? 0,
      fishNormalize: state.fishNormalize !== false,
    }),
    // Phase 7: send the canonical timing object so the server can verify the
    // render is using the same audio + script the preview was built from.
    previewTiming: state.previewTiming || null,
  };

  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/render`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({settings, scriptLines: state.script})
    });
    const body = await r.json();
    const {ok, jobId, folder, error, errors} = body || {};
    if(!ok){
      // Preflight failures arrive as { error: "Preflight validation failed", errors: [...] }
      if(Array.isArray(errors) && errors.length){
        const msg = '❌ Preflight failed:\n• ' + errors.join('\n• ');
        showToast(msg, 'error');
        throw new Error(errors[0]);
      }
      throw new Error(error || 'Render failed to start');
    }

    showToast('🎬 Render started!','success');
    clearDirty('render');
    pollRenderStatus(jobId, folder);
  }catch(e){
    showToast('Render error: '+e.message,'error');
    _setRenderBtns(false);
  }
}

function pollRenderStatus(jobId, folder){
  const es = new EventSource(`${API_BASE}/api/trend-vault/render-status/${jobId}`);
  const bar = document.getElementById('renderBar');
  const log = document.getElementById('renderLog');
  const statusText = document.getElementById('renderStatusText');
  const etaText = document.getElementById('renderEtaText');
  const stage = document.getElementById('renderStage');
  const panel = document.getElementById('renderProgressPanel');
  // btn/btnBar kept as null — _setRenderBtns() handles all four buttons now
  const btn = null;
  const btnBar = null;

  // Show the render progress panel (works even on small screens via section scroll)
  panel.style.display = 'block';
  // Scroll panel into view if export panel is hidden (small screen)
  if(getComputedStyle(panel.closest('.export-panel')||panel).display==='none'){
    panel.closest('.export-panel')?.style && (panel.closest('.export-panel').style.display='flex');
  }
  log.innerHTML = '';
  bar.style.width = '0%';
  if(stage) stage.textContent = '⚙ Starting pipeline...';

  // Update save path display
  if(folder){
    const sp = document.getElementById('savePathText');
    if(sp) sp.innerHTML = `Project &gt; trend-vault-output &gt; <strong style="color:var(--text)">${folder}</strong> &gt; video.mp4`;
  }

  const startTime = Date.now();

  es.onmessage = ({data})=>{
    let msg;
    try { msg = JSON.parse(data); } catch { return; }

    // Live log line
    if(msg.log){
      const line = document.createElement('div');
      const t = msg.log;
      if(/❌|✗|failed/i.test(t)) line.style.color='#f87171';
      else if(/✅|✓|complete/i.test(t)) line.style.color='#4ade80';
      else if(/🎙|voice|tts/i.test(t)) line.style.color='#a78bfa';
      else if(/🎬|render|frame/i.test(t)) line.style.color='#60a5fa';
      else if(/⚠|warn/i.test(t)) line.style.color='#fbbf24';
      line.textContent = t;
      log.appendChild(line);
      log.scrollTop = log.scrollHeight;
    }

    // Stage label update (server sends explicit stage string)
    if(msg.stage && stage) stage.textContent = msg.stage;

    // Progress bar
    if(msg.progress !== undefined){
      const pct = Math.min(100, Math.max(0, msg.progress));
      bar.style.width = pct+'%';
      if(pct > 3){
        const elapsed = (Date.now() - startTime) / 1000;
        const totalEst = elapsed / (pct / 100);
        const remaining = Math.max(0, Math.round(totalEst - elapsed));
        const etaStr = remaining > 60
          ? `~${Math.round(remaining/60)}m ${remaining%60}s left`
          : `~${remaining}s left`;
        statusText.textContent = `Rendering… ${pct}%`;
        if(remaining > 0) etaText.textContent = etaStr;
      } else {
        statusText.textContent = 'Starting...';
      }
    }

    // Completion
    if(msg.done){
      es.close();
      const elapsed = ((Date.now()-startTime)/1000).toFixed(1);
      if(msg.success){
        bar.style.width='100%';
        if(stage) stage.textContent='✅ Done!';
        statusText.textContent='✅ Render complete!';
        etaText.textContent = `⏱ ${elapsed}s total`;
        showToast('🎬 Video rendered! Check Past Renders below','success');
        _setRenderBtns(false);
        loadOutputs();
        // Auto-refresh ElevenLabs usage if this render used it
        if(/elevenlabs/i.test(msg.resolvedEngine || '') || /elevenlabs/i.test(settings?.voiceEngine || '')){
          try { refreshElevenLabsUsageOnly(); } catch {}
        }
        // Show save path
        if(folder){
          const sp = document.getElementById('savePathText');
          if(sp) sp.innerHTML = `📁 trend-vault-output/<strong style="color:var(--gold2)">${folder}</strong>/video.mp4`;
        }
        setTimeout(()=>{ panel.style.display='none'; }, 8000);
      } else {
        if(stage) stage.textContent='❌ Failed';
        statusText.textContent='❌ Render failed';
        etaText.textContent = '';
        const errLine = document.createElement('div');
        errLine.style.color='#f87171';
        errLine.textContent = msg.error || 'Unknown error — see logs above';
        log.appendChild(errLine);
        log.scrollTop = log.scrollHeight;
        showToast('Render failed — see log for details','error');
        _setRenderBtns(false);
      }
    }
  };
  es.onerror = () => {
    if(statusText && statusText.textContent.includes('Rendering')) {
      // Connection dropped mid-render — show warning
      const w = document.createElement('div');
      w.style.color='#fbbf24';
      w.textContent='⚠ Connection lost — render may still be running in background';
      log.appendChild(w);
    }
  };
}

// ═══════════════════════════════════════════════════════════════════
// OUTPUTS
// ═══════════════════════════════════════════════════════════════════

async function loadOutputs(){
  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/outputs`);
    const {folders} = await r.json();
    const card = document.getElementById('outputsCard');
    const gallery = document.getElementById('outputGallery');
    if(!folders.length){ card.style.display='none'; return; }
    card.style.display='block';
    gallery.innerHTML = folders.map(f=>`
      <div class="output-card" onclick="downloadOutput('${f.folder}')">
        <video src="${API_BASE}/trend-vault-clips/${f.folder}/video.mp4" muted loop playsinline preload="metadata" onmouseover="this.play().catch(()=>{})" onmouseout="this.pause()"></video>
        <div class="oc-label">${f.meta.trendVaultSign||f.folder.slice(0,20)}</div>
      </div>`).join('');
  }catch{}
}

function downloadOutput(folder){
  window.open(`${API_BASE}/trend-vault-clips/${folder}/video.mp4`,'_blank');
}

// ═══════════════════════════════════════════════════════════════════
// REFERENCE ANALYSIS
// ═══════════════════════════════════════════════════════════════════

async function analyzeReference(files){
  if(!files.length)return;
  const fd = new FormData();
  fd.append('video',files[0]);
  const div = document.getElementById('analysisResult');
  div.style.display='block';
  div.textContent='🔍 Analyzing video style fingerprint...';
  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/analyze-reference`,{method:'POST',body:fd});
    const {ok,fingerprint} = await r.json();
    if(!ok) throw new Error('Analysis failed');
    const s = fingerprint.suggestions;
    div.innerHTML=`
      <strong>📊 Style Fingerprint Extracted</strong><br/>
      Duration: ${fingerprint.durationSeconds?.toFixed(1)}s &nbsp;|&nbsp; Estimated pacing: <em>${fingerprint.estimatedPacing}</em><br/><br/>
      <strong>Suggested settings:</strong><br/>
      Grain: ${s.grainType} &nbsp;|&nbsp; Color grade: ${s.colorGrade} &nbsp;|&nbsp; Text animation: ${s.textAnimation}<br/>
      Target duration: ${s.targetDuration}s &nbsp;|&nbsp; Slow zoom: ${s.slowZoom?'on':'off'} &nbsp;|&nbsp; Fog: ${s.fogOverlay?'on':'off'}<br/><br/>
      <button class="btn-random" onclick="applyFingerprint(${JSON.stringify(s).replace(/"/g,"'")})">✅ APPLY THESE SETTINGS</button>`;
  }catch(e){
    div.textContent='❌ Analysis failed: '+e.message;
  }
}

function handleRefDrop(e){
  e.preventDefault();
  e.currentTarget.classList.remove('drag-over');
  analyzeReference(e.dataTransfer.files);
}

function applyFingerprint(s){
  setGrainType(s.grainType, null);
  setColorGrade(s.colorGrade, null);
  document.getElementById('textAnimSelect').value = s.textAnimation;
  state.textAnimation = s.textAnimation;
  document.getElementById('zoomToggle').checked = s.slowZoom;
  document.getElementById('fogToggle').checked = s.fogOverlay;
  updatePreview();
  showToast('Style fingerprint applied!','success');
}

// ═══════════════════════════════════════════════════════════════════
// REGENERATE SCRIPT (reframe / clean up — only on button click)
// ═══════════════════════════════════════════════════════════════════

async function regenerateScript(){
  if(!state.script.length){ showToast('Generate a script first','error'); return; }
  const btn = document.getElementById('regenScriptBtn');
  if(btn){ btn.disabled=true; btn.textContent='♻ Reframing...'; }
  document.getElementById('scriptStatus').textContent = '♻ Rewriting script toward 1:30...';
  try{
    const r = await fetch(`${API_BASE}/api/trend-vault/regenerate-script`,{
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        trendVaultSign: state.sign||'Scorpio',
        category: state.category||'general',
        prompt: state.promptText||'',
        angle: state.promptAngle||'',
        emotionalTone: state.tone||'mysterious',
        existingLines: state.script,
        targetDurationSec: 90,
      })
    });
    const data = await r.json();
    if(!data.ok) throw new Error(data.error||'Reframe failed');
    // Preserve UPPERCASE caption style after reframe
    state.script = data.lines.map(l=>({
      text: (l.text||'').trim().toUpperCase(),
      type: l.type||'observation',
      durationSeconds: Math.max(2, Math.min(15, +l.durationSeconds||5)),
    }));
    markDirty('script');
    buildScriptLines();
    updatePreview();
    updateOutputCounter();
    const totalDur = Math.round(state.script.reduce((s,l)=>s+l.durationSeconds,0));
    const isLocal = data.source === 'local';
    const srcTag = data.source==='openai' ? ' (OpenAI)' : data.source==='anthropic' ? ' (Claude)' : '';
    document.getElementById('scriptStatus').textContent =
      `♻ Script reframed${srcTag} • added lines implemented • ~${totalDur}s`;
    if(data.warning && isLocal){
      showToast(data.warning, 'info');
    } else {
      showToast('♻ Script reframed • rewritten with added lines', 'success');
    }
  }catch(e){
    document.getElementById('scriptStatus').textContent = '❌ Reframe failed';
    showToast('Reframe failed: '+(e.message||'unknown'),'error');
  }finally{
    if(btn){ btn.disabled=false; btn.textContent='♻ REFRAME'; }
  }
}

function addScriptLineBlank(){
  state.script.push({text:'',type:'observation',durationSeconds:5});
  buildScriptLines();
  updateOutputCounter();
}

function updateOutputCounter(){
  const el = document.getElementById('outputCounter');
  if(!el) return;
  const total = state.script.reduce((s,l)=>s+l.durationSeconds,0);
  el.textContent = `${state.script.length} lines · ~${Math.round(total)}s`;
}

