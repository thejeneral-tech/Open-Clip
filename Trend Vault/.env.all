# OpenAI — automatic fallback when Anthropic credits run out
# Used for prompt generation, script generation, and script extension
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=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

# Remotion — Chrome flags needed on Windows to prevent headless browser hangs
# --no-sandbox is required; without it Chrome silently hangs after launch
REMOTION_CHROME_FLAGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage

# AI Provider preference: "auto" | "anthropic" | "openai"
# auto = try Anthropic first, fall back to OpenAI on failure
AI_PROVIDER=auto

# ── Stock Media Browser ───────────────────────────────────────────────────────
# Pexels — free stock videos (portrait/vertical cinematic clips)
# 1. Go to https://www.pexels.com/api/  →  click "Get Started"  →  fill the short form
# 2. Your API key appears instantly on the dashboard
# 3. Free tier: 200 req/hour, 20 000 req/month — more than enough
PEXELS_API_KEY=fAGijQaUEmhXA0TvlEt4Frri4qx3vaqdOXvmyzZUGngtl8IcunB2xv3U

# Jamendo — free Creative Commons background music (direct MP3 downloads)
# 1. Go to https://devportal.jamendo.com/  →  Register  →  Create an app
# 2. Copy the "Client ID" shown (it is a short alphanumeric string, NOT a secret)
# 3. Free tier: 35 000 req/month
JAMENDO_CLIENT_ID=a49a4537

# ── Local TTS engine (Kokoro) ─────────────────────────────────────────────────
# When set, every voice preview and every render goes through the local
# Python Kokoro server instead of Microsoft Edge TTS.
# Start it with: start-kokoro.bat (project root)
LOCAL_TTS_URL=http://localhost:5070
LOCAL_TTS_ENGINE=kokoro
HUGGINGFACE_TOKEN=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

# Remote Render Worker — offloads Remotion rendering to a separate process
RENDER_WORKER_URL=http://localhost:4000
RENDER_WORKER_PORT=4000
